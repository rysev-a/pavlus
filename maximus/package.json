{
  "name": "maximus",
  "private": true,
  "version": "0.1.0",
  "description": "Maximus: a signals-based frontend framework with real DOM, ownership scopes, built-in async, router, forms and SSR",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./core": "./src/core/mod.ts",
    "./dom": "./src/dom/mod.ts",
    "./store": "./src/store/mod.ts",
    "./resource": "./src/resource/mod.ts",
    "./router": "./src/router/mod.ts",
    "./form": "./src/form/mod.ts",
    "./ssr": "./src/ssr/mod.ts",
    "./testing": "./src/testing/mod.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node --experimental-strip-types bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
