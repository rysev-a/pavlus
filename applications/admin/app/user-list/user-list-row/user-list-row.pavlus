// One row's own cells: the view half of the keyed `+Row#row(key=id)` embed in
// the page's table (user-list-row.ts is the behavior half, joined to it by the
// instance name). The page spreads this row's element of `byId` into the embed
// (`...byId[id]`), so what this template renders is exactly the row's state —
// the very thing its component sees — and its events leave prefixed
// `row.<id>.`, reaching only this row's component. The star is the row's own
// concern; the checkbox and the edit/delete buttons (the table's concerns:
// they change what the whole page shows) live in the page's template, outside
// the embed.
td.id {id}
td {name}
td {email}
td
  span.badge.ui-badge.ui-badge-secondary {role}
td.actions
  button.star.ui-button.ui-button-ghost.ui-button-icon-sm.row-star(type="button" aria-label="Star" aria-pressed={starred ? "true" : "false"} class:starred=starred @click=star)
    span.ui-icon(data-icon="star")
