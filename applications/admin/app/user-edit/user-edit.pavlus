// The edit page (`/:id/edit`), rendered by the shell's `+outlet` when the
// route matches. Until its `enter` fills the slice's `form` there is nothing
// to edit: a placeholder. The role options come in as a prop from the shell;
// saving and cancelling navigate back to the users page.
if form
  form.card.ui-card(@submit.prevent=submit)
    div.ui-card-header
      h2.ui-card-title Edit user
    div.ui-card-content
      if error
        p.status.status--error {error}
      div.ui-field-group
        input.inp.ui-input(value=form.name @input=setName placeholder="Name" autocomplete="off")
        input.inp.ui-input(type="email" value=form.email @input=setEmail placeholder="Email" autocomplete="off")
        select.inp.ui-select-control(value=form.roleId @change=setRole)
          option(value="") Pick a role
          for role in roles key role.id
            option(value=role.id selected=(form.roleId == role.id)) {role.name}
      div.ui-form-actions
        button.save.ui-button.ui-button-default(type="submit" disabled=(form.name == "" || form.email == "" || form.roleId == "")) Save
        button.cancel.ui-button.ui-button-outline(type="button" @click=cancel) Cancel
else
  if error
    p.status.status--error {error}
  p.status Loading...
