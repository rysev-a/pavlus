  },
  "dependencies": {
    "@pavlus/frontend": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
