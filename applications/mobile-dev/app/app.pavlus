// The phone screen: the editor fills it, the tab bar is at the bottom.
div.md
  main.md-main
    +outlet
  nav.md-bar(aria-label="Editors")
    a.md-tab(href={root + "/"} class:md-tab--on={tab === "board"} aria-current={tab === "board" ? "page" : "false"} @click.prevent=open("/"))
      span.k-icon.k-icon-shuffle
      | Board
    a.md-tab(href={root + "/interface"} class:md-tab--on={tab === "interface"} aria-current={tab === "interface" ? "page" : "false"} @click.prevent=open("/interface"))
      span.k-icon.k-icon-menu
      | Interface
    button.md-tab.md-mode(type="button" aria-label="Toggle light and dark" @click=toggleMode)
      if look.mode === "dark"
        span.k-icon.k-icon-sun
      else
        span.k-icon.k-icon-moon
      | Theme
