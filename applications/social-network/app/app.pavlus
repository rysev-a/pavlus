// The shell: the Orbit template, full page. A failed load and an unknown path are
// the shell's own screens; everything else is the routed Orbit (+outlet).
div.orbit-app
  if orbit.status === "failed"
    div.orbit-app__status
      div.ui-card.orbit-app__card
        div.ui-card-header
          h3.ui-card-title Orbit could not be opened
          p.ui-card-description {orbit.error}
        div.ui-card-footer
          button.ui-button.ui-button-default(type="button" @click=retry) Try again
  else if notFound
    div.orbit-app__status
      div.ui-card.orbit-app__card
        div.ui-card-header
          h3.ui-card-title Page not found
          p.ui-card-description There is nothing at this address.
        div.ui-card-footer
          a.ui-button.ui-button-default(href="/wall" @click.prevent=navigate("/wall")) Back to Orbit
  else
    +outlet
