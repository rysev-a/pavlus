// The login page: one card, the demo accounts underneath. The demo world's
// password is teamup123 for everyone.
div.login-wrap
  form.card(@submit.prevent=submit)
    h1 team-up
    p.sub the pavlus port — profiles, projects, a computed match, live chat
    if error
      p.error {error}
    div.fields
      input.email(type="email" value=email placeholder="email" @input=setEmail autocomplete="username")
      input.pass(type="password" value=password placeholder="password" @input=setPassword autocomplete="current-password")
    button.go(type="submit" disabled=busy) {busy ? "signing in..." : "sign in"}
  div.demo
    p demo accounts (password teamup123):
    button.demo-one(type="button" @click=pick("ann@team.up"))
      strong ann@team.up
      span Anna Founder — the owner
    button.demo-one(type="button" @click=pick("bob@team.up"))
      strong bob@team.up
      span Bob Backend — the applicant
    button.demo-one(type="button" @click=pick("clara@team.up"))
      strong clara@team.up
      span Clara Front — the frontend
