// The account recovery, in the original teamUP look: the brand panel on the
// left (the same one the login page wears), the form card on the right.
//
// The page serves three addresses: the forgotten password, the new password
// and the verification of the address.
div.auth
  aside.auth-brand
    span.auth-brand__blob.auth-brand__blob--tl(aria-hidden="true")
      img(src="/images/auth/blob-tl.svg" alt="")
    span.auth-brand__blob.auth-brand__blob--tr(aria-hidden="true")
      img(src="/images/auth/blob-tr.svg" alt="")
    span.auth-brand__blob.auth-brand__blob--bl(aria-hidden="true")
      img(src="/images/auth/blob-bl.svg" alt="")
    span.auth-brand__blob.auth-brand__blob--br(aria-hidden="true")
      img(src="/images/auth/blob-br.svg" alt="")
    div.auth-brand__card
      div.auth-brand__head
        a.auth-brand__home(href="/app")
          div.auth-brand__mark T
          p.auth-brand__name teamUP
        p.auth-brand__tag a community of startup founders
      div.auth-brand__message
        p.auth-brand__headline Find your people. Build the future.
        p.auth-brand__text
          | Meet friends, like-minded people and future co-founders who want
          | to turn startup ideas into reality.
    div.auth-brand__trust
      span.auth-brand__trust-icon
        img(src="/images/auth/notification.svg" alt="" width="20" height="20")
        img.auth-brand__trust-dot(src="/images/auth/notification-dot.svg" alt="" width="8" height="8")
      div
        p.auth-brand__trust-title Start with the right people
        p.auth-brand__trust-text
          | Meet friends, like-minded people and future co-founders who want
          | to turn startup ideas into reality.
  div.auth__area
    div.auth__card
      div.auth__logo
        a(href="/app") teamUP
      if mode == "forgot"
        h1.auth__title {strings.forgotTitle}
        p.auth__subtitle {strings.forgotText}
        if error
          p.auth__hint(role="alert") {error}
        if done
          p.auth__hint(role="status") {notice}
          div.auth__alt
            a.auth__link(href="/app/login") {strings.backToLogin}
        else
          form.auth__form(@submit.prevent=submit)
            div.auth__field
              label.auth__label(for="forgot-email") {strings.email}
              input.auth__input#forgot-email(type="email" value=email placeholder="you@example.com" autocomplete="username" @input=setEmail)
            button.auth__btn.auth__btn__blue(type="submit" disabled=busy) {strings.send}
          div.auth__alt
            a.auth__link(href="/app/login") {strings.backToLogin}
      if mode == "reset"
        h1.auth__title {strings.resetTitle}
        p.auth__subtitle {strings.resetText}
        if error
          p.auth__hint(role="alert") {error}
        if done
          p.auth__hint(role="status") {notice}
          div.auth__alt
            a.auth__link(href="/app/login") {strings.backToLogin}
        else
          form.auth__form(@submit.prevent=submit)
            div.auth__field
              label.auth__label(for="reset-password") {strings.password}
              input.auth__input#reset-password(type="password" value=password placeholder="at least eight characters" autocomplete="new-password" @input=setPassword)
            div.auth__field
              label.auth__label(for="reset-confirm") {strings.confirm}
              input.auth__input#reset-confirm(type="password" value=confirm placeholder="repeat the password" autocomplete="new-password" @input=setConfirm)
            button.auth__btn.auth__btn__violet(type="submit" disabled=busy) {strings.save}
          div.auth__alt
            a.auth__link(href="/app/login") {strings.backToLogin}
      if mode == "verify"
        h1.auth__title {strings.verifyTitle}
        if error
          p.auth__hint(role="alert") {error}
        else
          p.auth__hint(role="status") {notice}
        div.auth__alt
          a.auth__link(href="/app/login") {strings.backToLogin}
          a.auth__link(href="/app") {strings.toTheApp}
