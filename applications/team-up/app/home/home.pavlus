// The home (/): the hero (the badge, the marked title, the lead, the buttons
// and the count of the members), the "is it hard" block, the four steps of
// the service, the two inner blocks, the blog block and the reviews.
//
// The marked titles come as parts: the accented ones are the words between
// the tags of the original.
main
  section.work
    div.container
      div.work__relative
        div.work__zindex
          div.work__border {hero.badge}
          h1
            for part in hero.title
              if part.br
                br
              if part.accent
                span {part.text}
              else
                | {part.text}
          p {hero.lead}
          div.work__img
            img(src="/images/work__img.webp" alt="")
          div.work__bottom
            ul.work__buttons
              for button in hero.buttons key button.href
                li
                  a(class={"work__btn " + (button.bg ? "work__btn__bg" : "work__btn__border")} href={button.href}) {button.text}
            div.work__inner
              ul.work__list
                li
                  div.work__list__img
                    img(src="/images/work__list__img.webp" alt="")
                li
                  div.work__list__img
                    img(src="/images/work__list__img2.webp" alt="")
                li
                  div.work__list__img
                    img(src="/images/work__list__img3.webp" alt="")
                li
                  div.work__list__img
                    img(src="/images/work__list__img4.webp" alt="")
                li
                  div.work__list__img
                    img(src="/images/work__list__img5.webp" alt="")
              h5
                for part in hero.members
                  if part.br
                    br
                  if part.accent
                    span {part.text}
                  else
                    | {part.text}
  section.difficult
    div.container
      h2
        for part in difficult.title
          if part.br
            br
          if part.accent
            span {part.text}
          else
            | {part.text}
      div.difficult__wrap
        for block in difficult.blocks key block.title
          div.difficult__block
            div(class={"difficult__border difficult__" + block.hue})
              h3 {block.title}
              p {block.text}
              div.difficult__img
                img(src={block.image} alt="")
  section.job
    div.container
      h2
        for part in job.title
          if part.br
            br
          if part.accent
            span {part.text}
          else
            | {part.text}
      div.job__wrap
        for step in job.steps key step.n
          div.job__block
            div.job__card
              div.job__border
                div.job__img
                  img(src={step.image} alt="")
                span {step.n}
              h3 {step.title}
              p {step.text}
      div.job__inner
        for block in job.inner key block.title
          div.job__inner__block
            div(class={"job__inner__border job__inner__" + block.hue})
              div.job__inner__flex
                div.job__inner__top
                  p {block.kicker}
                  h3 {block.title}
                  ul
                    for item in block.items key item
                      li {item}
                div.job__inner__bottom
                  a.job__inner__btn(href={block.href}) {block.button}
              div.job__inner__img
                for image in block.images key image
                  img(src={image} alt="")
  if blog.posts.length
    section.blog(data-testid="landing-blog")
      div.container
        div.blog__top
          h2 {blog.title}
          div.blog__top-actions
            a(href="/blog") {blog.all}
        div.blog__wrap
          for post in blog.posts key post.pid
            div.blog__block
              a.blog__card(href="/blog/{post.pid}" data-testid="landing-post" data-pid={post.pid})
                div.blog__img
                  img(src={post.image} alt="")
                h3 {post.title}
                p {post.excerpt}
  section.reviews
    div.container
      h2
        for part in reviews.title
          if part.br
            br
          if part.accent
            span {part.text}
          else
            | {part.text}
      div.reviews__overflow
        div.reviews__wrap
          div.reviews__block
            div(class={"reviews__border reviews__border__" + reviews.items[0].hue})
              div.reviews__top
                div.reviews__img
                  img(src={reviews.items[0].image} alt="")
                div.reviews__info
                  h3 {reviews.items[0].name}
                  p {reviews.items[0].role}
              div.reviews__text
                p {reviews.items[0].text}
          div.reviews__block
            div.reviews__inner
              for item in reviews.items key item.name
                if item.name != reviews.items[0].name
                  div.reviews__inner__block
                    div(class={"reviews__border reviews__border__" + item.hue})
                      div.reviews__top
                        div.reviews__img
                          img(src={item.image} alt="")
                        div.reviews__info
                          h3 {item.name}
                          p {item.role}
                      div.reviews__text
                        p {item.text}
