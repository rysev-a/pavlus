// The member page (/users/{slug}): the head (the avatar, the name, the
// status), the date and the friend button, the bio, the rated skills grouped
// by profession (a bar of ten segments each) and the actions.
//
// The report button and the report dialog (report/) belong to the member:
// the button opens the dialog, the dialog sends the report to the backend.
import ReportDialog from "../report/report.pavlus"
main.page
  section.user-detail
    div.container
      if user
        div.user-detail__head
          div(class={user.avatarClass}) {user.initials}
          div.user-detail__head-info
            h1.user-detail__name {user.name}
            span.user-detail__status(class={"user-detail__status--" + user.roleClass}) {user.role}
        div.user-detail__meta
          span.user-detail__date {since}
          span.user-detail__friend-box(id="friend-box" data-testid="friend-box")
            if friend.relation == "none"
              button.user-detail__friend(type="button" data-testid="friend-add" @click=friendRequest) Add to friends
            else if friend.relation == "waiting"
              span.user-detail__friend.user-detail__friend--waiting(data-testid="friend-waiting") Request sent
              button.user-detail__friend.user-detail__friend--ghost(type="button" data-testid="friend-remove" @click=friendRemove) Cancel request
            else if friend.relation == "incoming"
              button.user-detail__friend(type="button" data-testid="friend-accept" @click=friendAccept) Accept request
              button.user-detail__friend.user-detail__friend--ghost(type="button" data-testid="friend-decline" @click=friendDecline) Decline
            else if friend.relation == "friends"
              span.user-detail__friend.user-detail__friend--waiting(data-testid="friend-friends") Friends
              button.user-detail__friend.user-detail__friend--ghost(type="button" data-testid="friend-remove" @click=friendRemove) Remove from friends
            else if friend.relation == "guest"
              a.user-detail__friend(data-testid="friend-guest" href="/app/people/{friend.slug}") Add to friends
          if friend.relation != "guest" && friend.relation != "hidden"
            button.user-detail__action.user-detail__action--secondary(type="button" data-testid="report-person" @click=openReport) Report
        p.user-detail__description {user.bio}
        if skillGroups.length
          div.user-skillset(data-testid="user-skillset")
            for group in skillGroups key group.title
              section.user-skillgroup(data-testid="skill-group")
                h3.user-skillgroup__title {group.title}
                for skill in group.skills key skill.slug
                  div.user-skill(data-testid="user-skill-{skill.slug}")
                    span.user-skill__name {skill.name}
                    span.user-skill__bar(role="img" aria-label={skill.name + ": " + skill.level + " out of 10"} title={skill.level + " out of 10"})
                      for segment in skill.segments
                        i.user-skill__seg(class={"user-skill__seg--" + segment})
        div.user-detail__actions
          if friend.relation == "guest"
            a.user-detail__action(data-testid="write-message" href="/app/login") Send a message
          else
            button.user-detail__action(type="button" data-testid="write-message" @click=writeMessage) Send a message
          a.user-detail__action.user-detail__action--secondary(href="/app/login") Invite to a project
        +ReportDialog#report(report=report)
      else
        div.shell__card
          p.shell__muted No such member.
