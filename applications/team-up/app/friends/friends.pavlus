// The friends page: the three sections of the original — the incoming
// requests, my friends and the requests I sent.
h1.shell__h1 {strings.title}
if error
  div.shell__card
    p.pf__notice.is-err {error}
div.fr
  section.shell__card.fr__section(data-testid="friends-section-incoming")
    h2.shell__h2
      | {strings.incoming}
      span.fr__count(data-testid="count-incoming") {incoming.length}
    if incoming.length == 0
      p.shell__muted(data-testid="empty-incoming") {strings.emptyIncoming}
    else
      ul.fr__list
        for card in incoming key card.slug
          li.fr__row(data-testid={"friend-card-" + card.slug})
            div.fr__avatar.fr__avatar--blank {card.initials}
            div.fr__info
              a.fr__name(href={"/app/people/" + card.slug}) {card.name}
              if card.role
                span.fr__meta {card.role}
              if card.city
                span.fr__meta {card.city}
            div.fr__actions
              button.shell__btn(type="button" disabled=busy data-testid={"accept-" + card.slug} @click=act(card.slug, "accept")) {strings.accept}
              button.shell__btn.shell__btn--ghost(type="button" disabled=busy data-testid={"decline-" + card.slug} @click=act(card.slug, "decline")) {strings.decline}
  section.shell__card.fr__section(data-testid="friends-section-friends")
    h2.shell__h2
      | {strings.myFriends}
      span.fr__count(data-testid="count-friends") {friends.length}
    if friends.length == 0
      p.shell__muted(data-testid="empty-friends") {strings.emptyFriends}
    else
      ul.fr__list
        for card in friends key card.slug
          li.fr__row(data-testid={"friend-card-" + card.slug})
            div.fr__avatar.fr__avatar--blank {card.initials}
            div.fr__info
              a.fr__name(href={"/app/people/" + card.slug}) {card.name}
              if card.role
                span.fr__meta {card.role}
              if card.city
                span.fr__meta {card.city}
            div.fr__actions
              button.shell__btn.shell__btn--ghost(type="button" disabled=busy data-testid={"remove-" + card.slug} @click=act(card.slug, "remove")) {strings.remove}
  section.shell__card.fr__section(data-testid="friends-section-outgoing")
    h2.shell__h2
      | {strings.outgoing}
      span.fr__count(data-testid="count-outgoing") {outgoing.length}
    if outgoing.length == 0
      p.shell__muted(data-testid="empty-outgoing") {strings.emptyOutgoing}
    else
      ul.fr__list
        for card in outgoing key card.slug
          li.fr__row(data-testid={"friend-card-" + card.slug})
            div.fr__avatar.fr__avatar--blank {card.initials}
            div.fr__info
              a.fr__name(href={"/app/people/" + card.slug}) {card.name}
              if card.role
                span.fr__meta {card.role}
              if card.city
                span.fr__meta {card.city}
            div.fr__actions
              button.shell__btn.shell__btn--ghost(type="button" disabled=busy data-testid={"cancel-" + card.slug} @click=act(card.slug, "remove")) {strings.cancel}
