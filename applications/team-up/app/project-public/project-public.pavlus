// The public project page, in the original teamUP look: the head (the name,
// the kind, the work mode, the "looking for people", the status), the meta
// (the budget, the deadline, the city, the site, the creation day, the
// founder), the description, the tags, the team and the positions.
//
// The report button and the report dialog (report/) belong to the project:
// the button opens the dialog, the dialog sends the report to the backend.
import ReportDialog from "../report/report.pavlus"
main.page
  section.startup-detail
    div.container
      if project
        div.startup-detail__head
          h1.startup-detail__title {project.name}
          span.startup-detail__status.startup-detail__status--kind {project.kindLabel}
          if project.workModeLabel
            span.startup-detail__status.startup-detail__status--kind {project.workModeLabel}
          if project.openCount > 0
            span.startup-detail__status.startup-detail__status--looking Looking for people · {project.openCount}
          span.startup-detail__status(class={"startup-detail__status--" + project.status}) {project.statusLabel}
        if project.tagline
          p.startup-detail__tagline {project.tagline}
        if project.budgetLabel
          p.startup-detail__company
            span {project.budgetLabel}
        if project.deadlineLabel
          p.startup-detail__company
            span {project.deadlineLabel}
        if project.city
          p.startup-detail__company
            span {project.city}
        if project.website
          p.startup-detail__company
            a(href={project.website} rel="nofollow noopener" target="_blank") {project.website}
        div.startup-detail__meta
          span.startup-detail__date Created {project.date}
          span.startup-detail__owner-inline
            | Founder:
            a(href="/users/{project.ownerSlug}") {project.ownerName}
        if project.description
          p.startup-detail__description {project.description}
        if project.tags.length > 0
          ul.startup-detail__needed
            for tag in project.tags
              li.startup-detail__needed-chip {tag}
        div.startup-detail__actions
          a.startup-detail__back(href="/projects") Back to the catalog
          button.work__btn(type="button" data-testid="report-project" @click=openReport) Report the project
        h2.startup-detail__subtitle Team
        ul.startup-team
          for member in project.team key member.slug
            li.startup-team__item
              span.startup-team__avatar(class={member.avatarClass}) {(member.name.split(" ")[0][0] || "?").toUpperCase()}
              span.startup-team__info
                a(href="/users/{member.slug}") {member.name}
                span.startup-team__role {member.role}
        h2.startup-detail__subtitle Positions
        if project.slots.length == 0
          p.startup-detail__muted There are no open positions yet.
        else
          ul.startup-slots
            for slot in project.slots key slot.id
              li.startup-slot(id={"slot-" + slot.id} data-status={slot.status})
                div.startup-slot__main
                  p.startup-slot__title {slot.title}
                  if slot.payLabel
                    p.startup-slot__pay {slot.payLabel}
                  if slot.description
                    p.startup-slot__desc {slot.description}
                  if slot.skills.length > 0
                    div.startup-card__tags
                      for skill in slot.skills
                        span.startup-card__tag {skill.name} {skill.level}+
                  if slot.memberName
                    p.startup-slot__who
                      | Taken by:
                      a(href="/users/{slot.memberSlug}") {slot.memberName}
                div.startup-slot__side
                  span.startup-slot__chip(class:startup-slot__chip--open={slot.memberName == ""}) {slot.status}
        +ReportDialog#report(report=report)
      else
        div.startup-detail__notfound
          p.startup-detail__notfound-title No such project
          p.startup-detail__notfound-text
            | The project is gone or was never here — have a look at the
            | catalog.
          a.startup-detail__back(href="/projects") Back to the catalog
