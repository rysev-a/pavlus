// The new project page, in the original teamUP look: the title, the card
// with the form (the kind, the name, the tagline, the description) and the
// first opening (a profession of the directory, a grade, what it needs).
div
  a.auth__link(href="/app") ← the feed
  h1.shell__h1 New project
  div.shell__card.st__formcard
    p.shell__muted
      | You will be its owner. You can add more openings on the project page.
    if error
      p.pf__notice.is-err(role="alert") {error}
    form.st__form(@submit.prevent=submit)
      div.pf__field
        label.pf__label(for="st-kind") Project type
        select.pf__input#st-kind(@change=setKind)
          option(value="startup" selected={kind == "startup"}) Startup
          option(value="company" selected={kind == "company"}) Organization
          option(value="part-time" selected={kind == "part-time"}) Part-time work
        p.pf__hint
          | {kind == "company" ? "An organization that hires: its openings are real jobs." : kind == "part-time" ? "Work for experts: single jobs on a project, not a whole team." : "A team that builds a product together."}
      div.pf__field
        label.pf__label(for="st-name") Name
        input.pf__input#st-name(type="text" value=name maxlength="80" placeholder="the name of the project" @input=setName)
      div.pf__field
        label.pf__label(for="st-tagline") The project in brief
        input.pf__input#st-tagline(type="text" value=tagline maxlength="140" placeholder="in one line" @input=setTagline)
      div.pf__field
        label.pf__label(for="st-description") Description
        textarea.pf__input.pf__textarea#st-description(rows="5" value=description placeholder="what the project is about" @input=setDescription)
      div.pf__field
        label.pf__label(for="st-profession") The first opening
        select.pf__input#st-profession(@change=setProfession)
          option(value="0" selected={professionId == 0}) No opening yet
          for profession in professions key profession.id
            option(value={profession.id} selected={professionId == profession.id}) {profession.name}
      if professionId > 0
        div.pf__grid
          div.pf__field
            label.pf__label(for="st-bucket") Grade
            select.pf__input#st-bucket(@change=setBucket)
              option(value="" selected={bucket == ""}) Not stated
              option(value="junior" selected={bucket == "junior"}) Junior
              option(value="middle" selected={bucket == "middle"}) Middle
              option(value="senior" selected={bucket == "senior"}) Senior
              option(value="lead" selected={bucket == "lead"}) Lead
          div.pf__field
            label.pf__label(for="st-slot") What the opening needs
            input.pf__input#st-slot(type="text" value=slotDescription maxlength="300" placeholder="the skills or the work" @input=setSlotDescription)
      div.pf__actions
        button.shell__btn(type="submit" disabled=busy) {busy ? "Creating…" : "Create"}
