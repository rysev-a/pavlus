// The project catalog, in the original teamUP look: the filters in the left
// column (the chips of every filter, the sort, the viewer's box, the saved
// searches), the cards on the right (the name, the chips of the project, the
// owner, the open slots with their match). The chips are links with a query:
// the port navigates where the original used htmx.
main.page
  section.startups
    div.container
      div.startups__top
        h1 {strings.title}
      div.srch
        form.srch__filters(method="get" action="/projects" aria-label="Filters")
          div.srch__field
            label.srch__label(for="projects-q") {strings.search}
            input.srch__input#projects-q(type="search" name="q" value={q} placeholder={strings.placeholder} autocomplete="off")
            for field in ["domain", "kind", "mode", "role", "grade", "pay", "skill", "looking", "scope", "saved"]
              for one in checked[field]
                input(type="hidden" name={field} value={one})
          div.srch__field
            span.srch__label {strings.kind}
            div.srch__chips
              for chip in filters["kind"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          div.srch__field
            span.srch__label {strings.where}
            div.srch__chips
              for chip in filters["mode"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          div.srch__field
            span.srch__label {strings.category}
            div.srch__chips
              for chip in filters["domain"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          div.srch__field
            span.srch__label {strings.role}
            div.srch__chips
              for chip in filters["role"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          div.srch__field
            span.srch__label {strings.pay}
            div.srch__chips
              for chip in filters["pay"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          div.srch__field
            span.srch__label {strings.grade}
            div.srch__chips
              for chip in filters["grade"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          div.srch__field
            span.srch__label {strings.skill}
            div.srch__chips
              for chip in filters["skill"] key chip.value
                a.srch__chip(href={chip.href} class:is-on={chip.checked}) {chip.label}
          a.srch__check(href={filters["looking"][0].href} class:is-on={filters["looking"][0].checked})
            span {filters["looking"][0].label}
          a.srch__check(href={filters["scope"][0].href} class:is-on={filters["scope"][0].checked})
            span {filters["scope"][0].label}
          a.srch__check(href={filters["saved"][0].href} class:is-on={filters["saved"][0].checked})
            span {filters["saved"][0].label}
          div.srch__field
            label.srch__label(for="projects-sort") {strings.sort}
            select.srch__input#projects-sort(name="sort")
              if canMatch
                option(value="match" selected={sort == "match"}) {strings.byMatch}
              option(value="new" selected={sort == "new"}) {strings.newest}
              option(value="vacancies" selected={sort == "vacancies"}) {strings.vacancies}
            button.srch__btn(type="submit") {strings.find}
          div.srch__me
            if canMatch
              a.srch__me-link(href="/app/profile")
                | {strings.myProfile}
                span(aria-hidden="true") →
              div.srch__me-chips
                for one in meProfessions
                  span.srch__me-chip {one}
            else
              p.srch__me-title {strings.matchTitle}
              p.srch__hint {strings.signInHint}
          div.srch__saved
            span.srch__label {strings.savedSearches}
            ul.srch__saved-list
              for one in saved key one.id
                li
                  a(href={one.href}) {one.name}
                  button.srch__saved-del(type="button" @click=unsave(one.id) aria-label={strings.delete}) ×
            if saved.length == 0
              p.srch__hint {strings.nothingSaved}
            div.srch__saved-form
              input.srch__input(type="text" maxlength="60" placeholder={strings.savedName} value=savedName autocomplete="off" @input=setSavedName)
              button.srch__btn(type="button" @click=saveSearch) {strings.saveSearch}
        section.srch__results
          div.srch__bar
            span.srch__count {countLabel}
          for card in cards key card.slug
            article.srch__card(data-slug={card.slug})
              header.srch__card-head
                h2.srch__name
                  a(href="/projects/{card.slug}") {card.name}
                button.srch__star(type="button" class:is-on={card.favorite} aria-pressed={card.favorite ? "true" : "false"} @click=star(card.slug)) {card.favorite ? "★" : "☆"}
                span.srch__domain(class={"srch__domain--kind srch__domain--kind-" + card.kind} data-kind={card.kind}) {card.kindLabel}
                if card.workModeLabel
                  span.srch__domain {card.workModeLabel}
                if card.budgetLabel
                  span.srch__domain {card.budgetLabel}
                if card.deadlineLabel
                  span.srch__domain {card.deadlineLabel}
                if card.city
                  span.srch__domain {card.city}
                for tag in card.tags
                  span.srch__domain {tag}
                if card.openSlots > 0
                  span.srch__domain.srch__domain--looking {strings.looking} · {card.openSlots}
                if card.status != "active"
                  span.srch__domain.srch__domain--muted {card.statusLabel}
                if card.isMember
                  span.srch__domain {strings.onTeam}
                span.srch__owner
                  | {card.ownerName}
                  if card.ownerRole
                    |  · {card.ownerRole}
              if card.tagline
                p.srch__tagline {card.tagline}
              if card.slots.length > 0
                p.srch__slots-title {strings.openSlots}
                ul.srch__slots
                  for slot in card.slots key slot.id
                    li.srch__slot
                      div.srch__slot-info
                        p.srch__slot-title {slot.title}
                        if slot.description
                          p.srch__slot-note {slot.description}
                        p.srch__slot-skills {slot.skillsLine}
                        if slot.payLabel
                          p.srch__slot-pay {slot.payLabel}
                        if slot.matched
                          p.srch__slot-why {slot.matched.why}
                      div.srch__slot-side
                        if slot.matched
                          span.srch__match(class={slot.matchClass}) {strings.match} {slot.matched.percent}%
                        a.srch__btn(href="/projects/{card.slug}#slot-{slot.id}") {strings.details}
          if cards.length == 0
            div.srch__empty
              if filtered
                p.srch__empty-title {strings.nothingFound}
                p.srch__hint {strings.loosen}
                a.srch__btn(href="/projects") {strings.resetFilters}
              else
                p.srch__empty-title {strings.noProjects}
                p.srch__hint {strings.checkLater}
          if pager.length > 0
            nav.srch__pager(aria-label={strings.pages})
              for link in pager
                if link.gap
                  span.srch__pager-gap {link.label}
                else if link.current
                  span.srch__pager-item.is-on(aria-current="page") {link.label}
                else
                  a.srch__pager-item(href={link.href}) {link.label}
