// The about page (/about): the tag, the marked title, the lead, the text,
// the three cards, the "Join TeamUp" button (a guest only), the benefits and
// the questions.
main.page
  section.about
    div.container
      div.about__tag {tag}
      h1
        for part in title
          if part.accent
            span {part.text}
          else
            | {part.text}
      p.about__lead {lead}
      p.about__text {text}
      div.about__wrap
        for card in cards key card.title
          div.about__block
            div(class={"about__card about__" + card.hue})
              h3 {card.title}
              p {card.text}
      if join
        ul.about__buttons
          li
            a.work__btn.work__btn__bg(href={join.href} data-testid="about-join") {join.text}
  section.benefits
    div.container
      for group in benefits
        h2
          for part in group.title
            if part.accent
              span {part.text}
            else
              | {part.text}
        for block in group.groups
          h3.benefits__subtitle {block.subtitle}
          div(class={"about__wrap benefits__wrap" + (block.cards.length == 4 ? " benefits__wrap--four" : "")})
            for card in block.cards key card.title
              div.about__block
                div(class={"about__card about__" + card.hue})
                  h3 {card.title}
                  p {card.text}
  section.faq
    div.container
      h2
        for part in faq.title
          if part.accent
            span {part.text}
          else
            | {part.text}
      div.faq__wrap
        for item in faq.items key item.question
          details.faq__item
            summary {item.question}
            p {item.answer}
