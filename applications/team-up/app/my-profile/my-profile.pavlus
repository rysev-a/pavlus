// The profile editor, in the original teamUP look: the card with the member's
// own page, the photo and the basics form. The professions and the skills
// live on their own page — the editor links to it.
h1.shell__h1 {strings.title}
if error
  div.shell__card
    p.pf__notice.is-err {error}
if !profile
  div.shell__card
    p.shell__muted {strings.loading}
if profile
  div.pf(data-testid="profile-editor")
    section.shell__card.pf__section(data-testid="profile-card")
      dl.shell__dl
        dt {strings.name}
        dd {profile.name}
        dt {strings.publicPage}
        dd
          a.auth__link(href={"/users/" + profile.slug} data-testid="profile-slug") {"/users/" + profile.slug}
    section.shell__card.pf__section(data-testid="avatar-section")
      h2.shell__h2 {strings.photo}
      div.pf__avatar-row
        if avatarUrl
          img.pf__avatar(src=avatarUrl alt={strings.photo} data-testid="avatar-img")
        else
          div.pf__avatar.pf__avatar--blank(data-testid="avatar-blank") {(profile.name.split(" ")[0][0] || "?").toUpperCase()}
    form.shell__card.pf__section(@submit.prevent=submit data-testid="basics-form")
      h2.shell__h2 {strings.aboutYou}
      if notice
        p.pf__notice.is-ok {notice}
      div.pf__field
        label.pf__label(for="pf-name") {strings.name}
        input#pf-name.pf__input(type="text" maxlength="80" value=name @input=setName)
      div.pf__field
        label.pf__label(for="pf-city") {strings.city}
        input#pf-city.pf__input(type="text" maxlength="80" value=city @input=setCity)
      div.pf__field
        label.pf__label(for="pf-bio") {strings.bio}
        textarea#pf-bio.pf__input.pf__textarea(rows="5" maxlength="2000" @input=setBio) {bio}
      div.pf__field
        label.pf__label(for="pf-status") {strings.status}
        select#pf-status.pf__input(@change=setStatus)
          for item in statuses
            option(value=item.value selected={item.value == status}) {item.label}
      div.pf__field
        span.pf__label {strings.professions}
        p.shell__muted
          a.auth__link(href="/app/professions") {strings.professions}
      div.pf__field
        span.pf__label {strings.skills}
        p.shell__muted
          a.auth__link(href="/app/professions") {strings.skills}
      div.pf__actions
        button.shell__btn(type="submit" disabled=busy) {strings.save}
