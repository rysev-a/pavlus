// The settings page (/app/settings): the account (the name, the e-mail and
// the language), the topics of the letters, the blocked people, the change
// of the password and of the e-mail address, and the deletion of the
// account.
div.pf
  h1.shell__h1 Settings
  section.shell__card.pf__section
    h2.shell__h2 Account
    p.shell__muted {name} · {email}
    div.pf__field
      label.pf__label(for="settings-locale") Language
      select.pf__input#settings-locale(value=locale @change=changeLocale)
        option(value="en") English
        option(value="ru") Русский
    if notice
      p.pf__notice.is-ok {notice}
    if error
      p.pf__notice.is-err {error}
  section.shell__card.pf__section
    h2.shell__h2 Letters
    p.shell__muted What the service writes to you about.
    div.pf__checks
      label.pf__check
        input(type="checkbox" checked=topics.applications @change=toggleTopic("applications"))
        span
          span.pf__label Applications
          span.shell__muted Somebody applied to your project.
      label.pf__check
        input(type="checkbox" checked=topics.friends @change=toggleTopic("friends"))
        span
          span.pf__label Friend requests
          span.shell__muted Somebody asked to be your friend.
      label.pf__check
        input(type="checkbox" checked=topics.messages @change=toggleTopic("messages"))
        span
          span.pf__label Messages
          span.shell__muted Somebody wrote to you in a chat.
  section.shell__card.pf__section
    h2.shell__h2 Blocked people
    if blocks.length == 0
      p.shell__muted Nobody is blocked.
    else
      ul.st__slots
        for block in blocks key block.slug
          li.st__slot
            div.st__slot-main
              p.st__slot-title {block.name}
            div.st__slot-side
              button.shell__btn.shell__btn--ghost(type="button" @click=unblock(block.slug)) Unblock
  section.shell__card.pf__section
    h2.shell__h2 Password
    div.pf__field
      label.pf__label(for="settings-current") Current password
      input.pf__input#settings-current(type="password" value=currentPassword @input=setCurrent)
    div.pf__field
      label.pf__label(for="settings-new") New password
      input.pf__input#settings-new(type="password" value=newPassword @input=setNew)
    div.pf__actions
      button.shell__btn(type="button" @click=changePassword) Change the password
  section.shell__card.pf__section
    h2.shell__h2 E-mail address
    div.pf__field
      label.pf__label(for="settings-email-password") Current password
      input.pf__input#settings-email-password(type="password" value=emailPassword @input=setEmailPassword)
    div.pf__field
      label.pf__label(for="settings-email") New e-mail address
      input.pf__input#settings-email(type="email" value=newEmail @input=setNewEmail)
    div.pf__actions
      button.shell__btn(type="button" @click=changeEmail) Change the e-mail address
  section.shell__card.pf__section.pf__danger
    h2.shell__h2 Delete the account
    p.shell__muted
      | Everything the service keeps about you goes with it: the profile,
      | the projects, the applications and the messages.
    div.pf__field
      label.pf__label(for="settings-delete-password") Your password
      input.pf__input#settings-delete-password(type="password" value=deletePassword @input=setDeletePassword)
    div.pf__actions
      button.pf__delete(type="button" @click=deleteAccount) Delete the account
