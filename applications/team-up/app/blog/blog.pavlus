// The blog (/blog): the title and the order row, the tags as a row of chips
// and the grid of the cards. The chips are plain links with a server-computed
// address: the chosen tag is dropped, the order stays.
main.page
  section.blog-list
    div.container
      div.blog-list__top
        h1 {strings.title}
        div.blog-list__sort
          span.blog-list__sort-label {strings.sort}
          for link in sorts key link.href
            a.blog-list__sort-btn(class:blog-list__sort-btn--active={link.active} aria-pressed={link.active ? "true" : "false"} href={link.href} data-testid="blog-sort")
              | {link.title}
      div.blog-list__toolbar
        div.blog-list__tags
          span.blog-list__tags-label {strings.tags}
          for link in tags key link.href
            a.blog-list__tag-btn(class:blog-list__tag-btn--active={link.active} aria-pressed={link.active ? "true" : "false"} href={link.href} data-testid="blog-tag")
              | {link.title}
      div.blog-list__grid(id="blog-grid")
        for post in posts key post.pid
          article.blog-card(data-testid="post-card" data-pid={post.pid})
            div.blog-card__body
              span.blog-card__date {post.date}
              h3.blog-card__title
                a(href="/blog/{post.pid}" data-testid="post-link") {post.title}
              p.blog-card__desc {post.excerpt}
              a.blog-card__more(href="/blog/{post.pid}" data-testid="post-more") {strings.readMore}
              if post.tags.length
                div.blog-card__tags
                  for tag in post.tags key tag
                    span.blog-card__tag {tag}
        if posts.length == 0
          div.blog-list__empty
            p {strings.empty}
