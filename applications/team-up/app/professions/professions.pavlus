// The professions page, in the original teamUP look: my professions (with the
// grade) on the left, the directory on the right, and the skills of the chosen
// profession below it.
import SkillTree from "../skill-tree/skill-tree.pavlus"
h1.shell__h1 {strings.title}
if error
  div.shell__card
    p.pf__notice.is-err {error}
div.pf(data-testid="professions-page")
  section.shell__card.pf__section
    div.pf__panel-head
      h2.shell__h2 {strings.myProfessions}
      div.pf__field
        label.pf__label(for="pf-bucket") {strings.level}
        select#pf-bucket.pf__input(@change=setBucket)
          for item in buckets
            option(value=item.value selected={item.value == bucket}) {item.label}
    if mine.length == 0
      p.shell__muted {strings.emptyMine}
    for profession in mine key profession.professionId
      div.pf__group
        div.pf__head-label
          strong {profession.name}
          span.shell__muted {profession.bucket}
          button.pf__link-btn(type="button" @click=remove(profession.professionId)) {strings.remove}
        button.shell__btn.shell__btn--ghost(type="button" @click=open(profession.slug)) {strings.skills}
    // the skills of the open profession: the tree with the meter
    if open != ""
      div.pf__group
        div.pf__skill.pf__skill-head(aria-hidden="true")
          span.pf__head-label {strings.skill}
          span.pf__head-label {strings.levelScale}
          span.pf__head-label {strings.rating}
        if tree.roots.length == 0
          p.shell__muted {strings.noSkills}
        else
          +SkillTree#tree(tree=tree)
  section.shell__card.pf__section
    div.pf__panel-head
      h2.shell__h2 {strings.availableProfessions}
    p.shell__muted {strings.addHint}
    div.pf__chips
      for profession in available key profession.id
        button.pf__chip(type="button" @click=add(profession.id)) {profession.name}
