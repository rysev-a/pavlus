// The chat, in the original teamUP look: the inbox on the left (blank avatar
// tiles, unread badges), the open thread on the right with bubbles. The live
// line under the title is the port's (the ws status); messages arrive as they
// are sent.
div.msg(class:has-chat={open != 0})
  aside.msg__list
    h1.shell__h1.msg__title Messages
    p.msg__live(class:is-live={live == "live"})
      | {live == "live" ? "online" : live == "connecting" ? "connecting…" : "offline"}
    if threads.length == 0
      p.shell__muted No conversations yet.
    ul.msg__threads
      for thread in threads key thread.id
        li
          button.msg__thread(type="button" class:is-active={open == thread.id} @click=openThread(thread.id))
            div.msg__avatar.msg__avatar--blank {(thread.title.split(" ")[0][0] || "?").toUpperCase()}
            div.msg__thread-body
              div.msg__thread-top
                span.msg__thread-name {thread.title}
              div.msg__thread-bottom
                if thread.unread
                  span.msg__badge {thread.unread}
  section.msg__chat
    if open
      header.msg__head
        div.msg__head-text
          span.msg__head-name {openTitle}
      div.msg__scroll
        if messages.length == 0
          p.shell__muted.msg__empty No messages yet. Write first.
        for message in messages key message.id
          div.msg__row(class:is-me={message.userId == meId})
            div.msg__bubble(class:is-me={message.userId == meId})
              span.msg__author {message.author}
              p.msg__text {message.body}
              span.msg__time {message.sentAt.slice(11, 16)}
      form.msg__form(@submit.prevent=send)
        textarea.msg__input(rows="2" placeholder="Message" value=draft @input=setDraft)
        button.shell__btn.msg__send(type="submit" disabled=(live != "live" || draft.trim() == "")) Send
    else
      div.msg__placeholder
        p.shell__muted Select a conversation on the left.
