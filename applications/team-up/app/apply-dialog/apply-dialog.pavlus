// The dialog of an application (the original's `ApplyDialog`): the opening,
// the profession to apply with and the message.
//
// The classes are the original's (pf__modal, pf__modal--form, pf__modal-field).
//
// The dialog is on the screen only while it is open (`apply.open`): the page
// opens it, the send or the cancel closes it.
if apply.open
  div.pf__modal-backdrop(data-testid="apply-modal" @click=cancel)
    div.pf__modal.pf__modal--form(role="dialog" aria-modal="true" aria-labelledby="apply-modal-title" @click.stop=noop)
      h3.pf__modal-title#apply-modal-title(data-testid="apply-title") {apply.title}
      if apply.slots.length > 1
        label.pf__modal-field
          span.pf__label {apply.strings.opening}
          select.pf__input(data-testid="apply-slot" @change=setSlot)
            for slot in apply.slots key slot.id
              option(value={slot.id} selected={apply.slotId == slot.id}) {slot.label}
      label.pf__modal-field
        span.pf__label {apply.strings.yourProfession}
        if apply.professions.length == 0
          span.shell__muted(data-testid="apply-no-profession")
            | {apply.loaded ? apply.strings.noProfession : apply.strings.loading}
        else
          select.pf__input(data-testid="apply-profession" @change=setProfession)
            for p in apply.professions key p.slug
              option(value=p.slug selected={apply.profession == p.slug}) {p.title}
      label.pf__modal-field
        span.pf__label {apply.strings.message}
        textarea.pf__input.pf__textarea(rows="4" maxlength="1000" data-testid="apply-message" placeholder={apply.strings.tellWhy} value=apply.message @input=setMessage)
      p.pf__notice.is-err(data-testid="apply-error" hidden={!apply.error}) {apply.error}
      div.pf__modal-actions
        button.shell__btn.shell__btn--ghost(type="button" data-testid="apply-cancel" @click=cancel) {apply.strings.cancel}
        button.shell__btn(type="button" data-testid="apply-send" disabled=apply.busy @click=send)
          | {apply.mode == "edit" ? apply.strings.save : apply.strings.send}
