// The back office: the panel of the original's admin_ui — the sidebar with
// the sections, the breadcrumb of the top bar and the page of the section.
//
// The classes are the ui_kit's own (.ui-*), with the admin's own (.adm-*).
div.ui-shell(data-sidebar="closed")
  div.ui-shell-aside
    aside.ui-sidebar
      div.ui-sidebar-header
        a.ui-brand(href="/app/admin")
          span.ui-brand-mark(aria-hidden="true")
            span.ui-icon(style={"--icon: url(/icons/admin/shield-check.svg)"})
          span
            | {strings.admin}
            small {strings.controlPanel}
      nav.ui-sidebar-content(aria-label="Main")
        div.ui-sidebar-group
          p.ui-sidebar-group-label {strings.menu}
          ul.ui-sidebar-menu
            li
              details.ui-sidebar-collapsible(open)
                summary.ui-sidebar-button
                  span.ui-sidebar-icon(aria-hidden="true")
                    span.ui-icon(style={"--icon: url(/icons/admin/users.svg)"})
                  span.ui-sidebar-label {strings.access}
                  span.ui-sidebar-chevron(aria-hidden="true")
                    span.ui-icon(style={"--icon: url(/icons/admin/chevron-right.svg)"})
                ul.ui-sidebar-sub
                  for item in sections
                    li
                      a.ui-sidebar-sub-button(href={item.href} class:is-active={item.id == section}) {item.title}
            li
              details.ui-sidebar-collapsible
                summary.ui-sidebar-button
                  span.ui-sidebar-icon(aria-hidden="true")
                    span.ui-icon(style={"--icon: url(/icons/admin/activity.svg)"})
                  span.ui-sidebar-label {strings.system}
                  span.ui-sidebar-chevron(aria-hidden="true")
                    span.ui-icon(style={"--icon: url(/icons/admin/chevron-right.svg)"})
                ul.ui-sidebar-sub
                  li
                    a.ui-sidebar-sub-button(href="/app/admin/tasks") {strings.tasks}
      div.ui-sidebar-footer
        ul.ui-sidebar-menu
          li
            a.ui-sidebar-button(href="/app")
              span.ui-sidebar-icon(aria-hidden="true")
                span.ui-icon(style={"--icon: url(/icons/admin/arrow-left.svg)"})
              span.ui-sidebar-label {strings.backToApp}
        details.ui-sidebar-account
          summary.ui-sidebar-account-trigger
            span.ui-avatar.ui-sidebar-avatar(aria-hidden="true") {accountInitials}
            span.ui-sidebar-account-text
              strong {accountName}
              span {accountEmail}
            span.ui-sidebar-chevron(aria-hidden="true")
              span.ui-icon(style={"--icon: url(/icons/admin/chevrons-up-down.svg)"})
          div.ui-sidebar-account-panel
            a(href="/app/profile") {strings.profile}
            button(type="button" @click=signOut) {strings.signOut}
  div.ui-shell-body
    header.ui-shell-header
      div.ui-shell-header-start
        nav.ui-breadcrumb
          ol.ui-breadcrumb-list
            li.ui-breadcrumb-item
              a.ui-breadcrumb-link(href="/app/admin") {strings.admin}
            li.ui-breadcrumb-item
              span.ui-breadcrumb-separator /
            li.ui-breadcrumb-item
              span.ui-breadcrumb-page {pageTitle}
      div.ui-shell-header-actions
        div.lang-switch(role="group" aria-label="Language" data-testid="lang-switch")
          for locale in locales
            a.lang-switch__btn(href={"/api/lang/" + locale.code + "?next=" + (route.path || "/")} aria-pressed={locale.active ? "true" : "false"} title={locale.name}) {locale.code.toUpperCase()}
    main.ui-shell-content
      if error
        div.ui-alert.ui-alert-danger
          div.ui-alert-body
            div.ui-alert-description {error}
      if section == "users"
        header.ui-page-header
          div
            h1.ui-page-title {strings.usersTitle}
            p.ui-page-description {strings.usersDescription}
          div.ui-page-actions
            button.ui-button.ui-button-outline(type="button" @click=refresh)
              span.ui-icon(style={"--icon: url(/icons/admin/refresh-cw.svg)"})
              | {strings.refresh}
        div.ui-stat-grid
          div.ui-stat-card
            div.ui-stat-card-top
              span.ui-stat-card-label {strings.totalUsers}
              span.ui-stat-card-icon
                span.ui-icon(style={"--icon: url(/icons/admin/users.svg)"})
            div.ui-stat-card-value {users.length}
          div.ui-stat-card
            div.ui-stat-card-top
              span.ui-stat-card-label {strings.emailConfirmed}
              span.ui-stat-card-icon
                span.ui-icon(style={"--icon: url(/icons/admin/circle-check.svg)"})
            div.ui-stat-card-value {confirmedCount}
          div.ui-stat-card
            div.ui-stat-card-top
              span.ui-stat-card-label {strings.administrators}
              span.ui-stat-card-icon
                span.ui-icon(style={"--icon: url(/icons/admin/shield-check.svg)"})
            div.ui-stat-card-value {adminCount}
        section.ui-card.adm-table-card
          div.ui-card-header
            h3.ui-card-title {strings.allUsers}
            div.ui-card-action
              div.ui-data-search
                input.ui-input(type="search" value=search placeholder={strings.searchUsers} @input=setSearch)
          div.ui-table-container
            table.ui-table
              thead.ui-table-header
                tr.ui-table-row
                  th.ui-table-head {strings.user}
                  th.ui-table-head {strings.roles}
                  th.ui-table-head {strings.status}
                  th.ui-table-head {strings.created}
                  th.ui-table-head
              tbody.ui-table-body
                if users.length == 0
                  tr.ui-table-row
                    td.ui-table-cell(colspan="5")
                      p.adm-empty {strings.noUsers}
                for user in users key user.id
                  tr.ui-table-row
                    td.ui-table-cell
                      div.adm-user
                        span.ui-person-avatar(style={"--hue:" + user.hue} aria-hidden="true") {user.initials}
                        div
                          strong {user.name}
                          span.adm-muted {user.email}
                    td.ui-table-cell
                      div.adm-badges
                        for role in user.roles
                          span.ui-badge.ui-badge-default {role}
                    td.ui-table-cell
                      span.ui-badge.ui-badge-success {strings.confirmed}
                    td.ui-table-cell {user.createdAt.slice(0, 10)}
                    td.ui-table-cell
                      div.adm-row-actions
                        a.ui-button.ui-button-outline.ui-button-sm(href={"/app/people/" + user.slug}) {strings.edit}
      if section == "roles"
        header.ui-page-header
          div
            h1.ui-page-title {strings.rolesTitle}
            p.ui-page-description {strings.rolesDescription}
          div.ui-page-actions
            button.ui-button.ui-button-outline(type="button" @click=refresh)
              span.ui-icon(style={"--icon: url(/icons/admin/refresh-cw.svg)"})
              | {strings.refresh}
        section.ui-card
          div.ui-card-header
            h3.ui-card-title {strings.allRoles}
            div.ui-card-action
              div.ui-data-search
                input.ui-input(type="search" value=search placeholder={strings.searchRoles} @input=setSearch)
          div.ui-card-content
            div.ui-field
              span.ui-field-label {strings.newRole}
              form.adm-form(@submit.prevent=createRole)
                input.ui-input(type="text" value=newRole placeholder={strings.nameHint} @input=setNewRole)
                div.adm-form-actions
                  button.ui-button(type="submit" disabled=busy) {strings.createRole}
            p.adm-muted {strings.superuser}
          div.ui-table-container
            table.ui-table
              thead.ui-table-header
                tr.ui-table-row
                  th.ui-table-head {strings.role}
                  th.ui-table-head {strings.usersCount}
                  th.ui-table-head {strings.permissionsOfRole}
                  th.ui-table-head
              tbody.ui-table-body
                if roles.length == 0
                  tr.ui-table-row
                    td.ui-table-cell(colspan="4")
                      p.adm-empty {strings.noRoles}
                for role in roles key role.name
                  tr.ui-table-row
                    td.ui-table-cell
                      strong {role.name}
                    td.ui-table-cell {role.members}
                    td.ui-table-cell
                      div.adm-badges
                        for permission in role.permissions
                          span.ui-badge.ui-badge-outline {permission}
                    td.ui-table-cell
                      div.adm-row-actions
                        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=editRole(role.name)) {strings.edit}
                        button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=deleteRole(role.name)) {strings.delete}
        if editingRole
          section.ui-card
            div.ui-card-header
              h3.ui-card-title {strings.permissionsOfRole}
            div.ui-card-content
              div.adm-checks
                for permission in permissions key permission.name
                  label.ui-checkbox.adm-check
                    input.ui-checkbox-input(type="checkbox" checked={rolePermissions.includes(permission.name)} @change=togglePermission(permission.name))
                    span.ui-checkbox-label {permission.name}
              div.adm-form-actions
                button.ui-button(type="button" disabled=busy @click=saveRole) {strings.save}
      if section == "permissions"
        header.ui-page-header
          div
            h1.ui-page-title {strings.permissionsTitle}
            p.ui-page-description {strings.permissionsDescription}
          div.ui-page-actions
            button.ui-button.ui-button-outline(type="button" @click=refresh)
              span.ui-icon(style={"--icon: url(/icons/admin/refresh-cw.svg)"})
              | {strings.refresh}
        section.ui-card
          div.ui-card-header
            h3.ui-card-title {strings.allPermissions}
            div.ui-card-action
              div.ui-data-search
                input.ui-input(type="search" value=search placeholder={strings.searchPermissions} @input=setSearch)
          div.ui-card-content
            div.ui-field
              span.ui-field-label {strings.newPermission}
              form.adm-form(@submit.prevent=createPermission)
                input.ui-input(type="text" value=newPermission placeholder={strings.permissionHint} @input=setNewPermission)
                div.adm-form-actions
                  button.ui-button(type="submit" disabled=busy) {strings.createPermission}
          div.ui-table-container
            table.ui-table
              thead.ui-table-header
                tr.ui-table-row
                  th.ui-table-head {strings.permission}
                  th.ui-table-head {strings.roles}
                  th.ui-table-head
              tbody.ui-table-body
                if permissions.length == 0
                  tr.ui-table-row
                    td.ui-table-cell(colspan="3")
                      p.adm-empty {strings.noPermissions}
                for permission in permissions key permission.name
                  tr.ui-table-row
                    td.ui-table-cell
                      strong {permission.name}
                    td.ui-table-cell
                      div.adm-badges
                        for role in permission.roles
                          span.ui-badge.ui-badge-outline {role}
                    td.ui-table-cell
                      div.adm-row-actions
                        button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=deletePermission(permission.name)) {strings.delete}
      if section == "sessions"
        header.ui-page-header
          div
            h1.ui-page-title {strings.sessionsTitle}
            p.ui-page-description {strings.sessionsDescription}
          div.ui-page-actions
            button.ui-button.ui-button-outline(type="button" @click=refresh)
              span.ui-icon(style={"--icon: url(/icons/admin/refresh-cw.svg)"})
              | {strings.refresh}
        section.ui-card.adm-table-card
          div.ui-card-header
            h3.ui-card-title {strings.activeSessions}
            div.ui-card-action
              div.ui-data-search
                input.ui-input(type="search" value=search placeholder={strings.searchSessions} @input=setSearch)
          div.ui-table-container
            table.ui-table
              thead.ui-table-header
                tr.ui-table-row
                  th.ui-table-head {strings.user}
                  th.ui-table-head {strings.started}
                  th.ui-table-head {strings.lastActive}
                  th.ui-table-head
              tbody.ui-table-body
                if sessions.length == 0
                  tr.ui-table-row
                    td.ui-table-cell(colspan="4")
                      p.adm-empty {strings.noSessions}
                for session in sessions key session.id
                  tr.ui-table-row
                    td.ui-table-cell
                      div.adm-user
                        div
                          strong {session.userName}
                          span.adm-muted {session.email}
                    td.ui-table-cell {session.createdAt.slice(0, 16)}
                    td.ui-table-cell {session.expiresAt.slice(0, 16)}
                    td.ui-table-cell
                      div.adm-row-actions
                        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=endSession(session.id)) {strings.end}
      if section == "tasks"
        header.ui-page-header
          div
            h1.ui-page-title {strings.tasksTitle}
            p.ui-page-description {strings.tasksDescription}
          div.ui-page-actions
            button.ui-button.ui-button-outline(type="button" @click=refresh)
              span.ui-icon(style={"--icon: url(/icons/admin/refresh-cw.svg)"})
              | {strings.refresh}
        section.ui-card.adm-table-card
          div.ui-card-header
            h3.ui-card-title {strings.allTasks}
          div.ui-card-content
            div.ui-field
              span.ui-field-label {strings.newTask}
              form.adm-form(@submit.prevent=createTask)
                select.ui-input(@change=setTaskKind)
                  for handler in taskHandlers key handler.name
                    option(value=handler.name selected={handler.name == newTaskKind}) {handler.label}
                input.ui-input(type="text" value=newTaskRunAt placeholder={strings.whenToRunIt} @input=setTaskRunAt)
                div.adm-form-actions
                  button.ui-button(type="submit" disabled=busy) {strings.createTask}
          div.ui-table-container
            table.ui-table
              thead.ui-table-header
                tr.ui-table-row
                  th.ui-table-head {strings.handler}
                  th.ui-table-head {strings.status}
                  th.ui-table-head {strings.schedule}
                  th.ui-table-head {strings.attempts}
                  th.ui-table-head
              tbody.ui-table-body
                if tasks.length == 0
                  tr.ui-table-row
                    td.ui-table-cell(colspan="5")
                      p.adm-empty {strings.noTasks}
                for task in tasks key task.id
                  tr.ui-table-row
                    td.ui-table-cell
                      div.adm-user
                        div
                          strong {task.kind}
                          span.adm-muted {task.handlerLabel}
                    td.ui-table-cell
                      span.ui-badge.ui-badge-default {task.statusLabel}
                    td.ui-table-cell {task.runAt.slice(0, 16)}
                    td.ui-table-cell {task.attempts}
                    td.ui-table-cell
                      div.adm-row-actions
                        if task.status != "running"
                          button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=runTask(task.id)) {strings.run}
                        if task.status == "running" || task.status == "queued"
                          button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=stopTask(task.id)) {strings.stop}
                        button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=deleteTask(task.id)) {strings.delete}
