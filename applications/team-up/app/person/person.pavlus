// The person page (`/app/people/:slug`): the member's head (the avatar, the
// name, the status), the relation with the viewer (the friend buttons, Write,
// Block, Report), the bio, the professions, the rated skills (a bar of ten
// segments each) and the contacts.
//
// The classes are the original's: pe__head, pe__avatar, pe__who, pe__name,
// pe__role, pe__meta, pe__relation, pe__note, pe__bio, pe__tags, pe__group,
// pe__skill, pf__meter.
import ReportDialog from "../report/report.pavlus"
if person
  div.pe(data-testid="person-page")
    section.shell__card.pe__head
      div.pe__avatar.pe__avatar--blank {person.initials}
      div.pe__who
        h1.pe__name(data-testid="person-name") {person.name}
        if person.role
          span.pe__role {person.role}
        if person.city || person.age > 0
          span.pe__meta
            if person.city
              | {person.city}
            if person.city && person.age > 0
              |  · 
            if person.age > 0
              | {person.ageLabel}
      div.pe__relation(data-testid="relation" data-relation={person.relation})
        if person.relation == "self"
          p.pe__note(data-testid="relation-note") {strings.self}
          a.shell__btn.shell__btn--ghost(href="/app/profile") {strings.edit}
        else if person.relation == "waiting"
          p.pe__note(data-testid="relation-note") {strings.waiting}
          button.shell__btn.shell__btn--ghost(type="button" data-testid="friend-cancel" disabled=busy @click=friend("remove")) {strings.cancelRequest}
        else if person.relation == "incoming"
          p.pe__note(data-testid="relation-note") {strings.incoming}
          button.shell__btn(type="button" data-testid="friend-accept" disabled=busy @click=friend("accept")) {strings.accept}
          button.shell__btn.shell__btn--ghost(type="button" data-testid="friend-decline" disabled=busy @click=friend("decline")) {strings.decline}
        else if person.relation == "friends"
          p.pe__note.pe__note--ok(data-testid="relation-note") {strings.friends}
          button.shell__btn.shell__btn--ghost(type="button" data-testid="friend-remove" disabled=busy @click=friend("remove")) {strings.removeFriend}
        else
          button.shell__btn(type="button" data-testid="friend-add" disabled=busy @click=friend("add")) {strings.addFriend}
        if person.relation != "self"
          button.shell__btn.shell__btn--ghost(type="button" data-testid="write-message" disabled=busy @click=write) {strings.write}
          if person.blocked
            button.shell__btn.shell__btn--ghost(type="button" data-testid="person-unblock" disabled=busy @click=block("unblock")) {strings.unblock}
          else
            button.shell__btn.shell__btn--ghost(type="button" data-testid="person-block" disabled=busy @click=block("block")) {strings.block}
          button.pf__link-btn(type="button" data-testid="person-report" @click=openReport) {strings.report}
    if person.bio
      section.shell__card
        h2.shell__h2 {strings.about}
        p.pe__bio {person.bio}
    if person.professions.length > 0 || person.domains.length > 0
      section.shell__card
        h2.shell__h2 {strings.professions}
        div.pe__tags
          for p in person.professions key p.slug
            span.pe__tag.pe__tag--prof {p.name} · {p.bucket}
          for d in person.domains key d
            span.pe__tag {d}
    if person.skillGroups.length > 0
      section.shell__card(data-testid="person-skills")
        h2.shell__h2 {strings.skills}
        for group in person.skillGroups key group.title
          div.pe__group(data-testid="person-skill-group")
            h3.pe__group-title {group.title}
            div.pe__skills
              for skill in group.skills key skill.slug
                div.pe__skill
                  span.pe__skill-name {skill.name}
                  div.pf__meter
                    for segment in skill.segments
                      span(class={segment})
                  span.pf__skill-level {skill.level} · {skill.zone}
    section.shell__card
      h2.shell__h2 {strings.contacts}
      if person.contacts
        p.pe__bio(data-testid="person-contacts") {person.contacts}
      else if person.contacts == ""
        p.shell__muted(data-testid="contacts-empty") {strings.noContacts}
      else
        p.shell__muted(data-testid="contacts-hidden") {strings.contactsHidden}
    +ReportDialog#report(report=report)
else
  div.shell__card
    p.shell__muted(data-testid="person-loading") {strings.loading}
