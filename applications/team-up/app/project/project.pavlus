// The project, in the original teamUP look: the header card (chips, tagline,
// founder), then the slots as st__slot rows — a filled one says who sits in
// it, an open one the requirements and the apply button.
div
  a.auth__link(href="/") ← the feed
  if data
    h1.shell__h1 {data.name}
    div.shell__card.st__card
      div.st__card-top
        if data.kind != "startup"
          span.st__chip.st__chip--kind {data.kind}
      if data.tagline
        p.st__tagline {data.tagline}
      p.st__owner by {data.owner}
      if data.description
        p.st__slot-desc {data.description}
    ul.st__slots
      for slot in data.slots key slot.id
        li.st__slot(data-status={slot.userId ? "joined" : null})
          div.st__slot-main
            p.st__slot-title {slot.profession} · {slot.bucket}
            if slot.pay
              p.st__slot-pay {slot.pay}
            if slot.description
              p.st__slot-desc {slot.description}
            if slot.skills.length
              div.pe__tags
                for skill in slot.skills key skill.name
                  span.pe__tag {skill.name} {skill.level}+
          div.st__slot-side
            if slot.userId
              span.st__chip {slot.userName}
            else
              if applied
                span.st__chip.st__chip--looking Application sent
              else
                div.st__join
                  button.shell__btn(type="button" @click=apply(slot.id)) Apply
  else
    if status == "failed"
      div.shell__card
        p.pf__notice.is-err No such project.
    else
      div.shell__card
        p.shell__muted Loading…
