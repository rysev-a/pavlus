// The signup page, in the original teamUP look: the brand panel on the left
// (the same one the login page wears), the form card on the right. The form
// creates the account and the session cookie at once, so the new member lands
// on the feed.
div.auth
  aside.auth-brand
    span.auth-brand__blob.auth-brand__blob--tl(aria-hidden="true")
      img(src="/images/auth/blob-tl.svg" alt="")
    span.auth-brand__blob.auth-brand__blob--tr(aria-hidden="true")
      img(src="/images/auth/blob-tr.svg" alt="")
    span.auth-brand__blob.auth-brand__blob--bl(aria-hidden="true")
      img(src="/images/auth/blob-bl.svg" alt="")
    span.auth-brand__blob.auth-brand__blob--br(aria-hidden="true")
      img(src="/images/auth/blob-br.svg" alt="")
    div.auth-brand__card
      div.auth-brand__head
        a.auth-brand__home(href="/app")
          div.auth-brand__mark T
          p.auth-brand__name teamUP
        p.auth-brand__tag a community of startup founders
      div.auth-brand__message
        p.auth-brand__headline Find your people. Build the future.
        p.auth-brand__text
          | Meet friends, like-minded people and future co-founders who want
          | to turn startup ideas into reality.
    div.auth-brand__trust
      span.auth-brand__trust-icon
        img(src="/images/auth/notification.svg" alt="" width="20" height="20")
        img.auth-brand__trust-dot(src="/images/auth/notification-dot.svg" alt="" width="8" height="8")
      div
        p.auth-brand__trust-title Start with the right people
        p.auth-brand__trust-text
          | Meet friends, like-minded people and future co-founders who want
          | to turn startup ideas into reality.
  div.auth__area
    div.auth__card
      div.auth__logo
        a(href="/app") teamUP
      h1.auth__title Create an account
      p.auth__subtitle Start working with a team in a couple of minutes.
      if error
        p.auth__hint(role="alert") {error}
      form.auth__form(@submit.prevent=submit)
        div.auth__field
          label.auth__label(for="signup-name") Name
          input.auth__input#signup-name(type="text" value=name placeholder="What is your name" autocomplete="name" @input=setName)
        div.auth__field
          label.auth__label(for="signup-email") Email
          input.auth__input#signup-email(type="email" value=email placeholder="you@example.com" autocomplete="username" @input=setEmail)
        div.auth__field
          label.auth__label(for="signup-password") Password
          input.auth__input#signup-password(type="password" value=password placeholder="at least six characters" autocomplete="new-password" @input=setPassword)
        div.auth__field
          label.auth__label(for="signup-confirm") Confirm the password
          input.auth__input#signup-confirm(type="password" value=confirm placeholder="repeat the password" autocomplete="new-password" @input=setConfirm)
        button.auth__btn.auth__btn__violet(type="submit" disabled=busy) {busy ? "Creating the account…" : "Sign up"}
      div.auth__alt
        span Already have an account?
        a.auth__link(href="/app/login") Log in
