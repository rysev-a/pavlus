// The footer of the public site (the original teamUP's partials/footer.html):
// three blocks (the brand, the contacts, the social links) and the bottom
// bar with the privacy policy and the copyright.
footer
  div.container
    div.footer__wrap
      div.footer__block
        div.footer__flex
          div.footer__flex__block
            h3 TeamUp
          div.footer__flex__block
            p {site.strings.footerBlurb}
      div.footer__block
        div.footer__flex
          div.footer__flex__block
            h3 {site.strings.contacts}
          div.footer__flex__block
            ul.footer__contacts
              li
                a(href="mailto:hello@teamup.com") hello@teamup.com
              li {site.strings.address}
              li
                a(href="tel:+70000000000") +7 (XXX) XXX-XX-XX
      div.footer__block
        div.footer__flex
          div.footer__flex__block
            h3 {site.strings.findUs}
          div.footer__flex__block
            ul.footer__social
              li
                a(href="#" aria-label="Telegram")
                  img(src="/images/footer__social.svg" alt="Telegram")
              li
                a(href="#" aria-label="VK")
                  img(src="/images/footer__social2.svg" alt="VK")
              li
                a(href="#" aria-label="YouTube")
                  img(src="/images/footer__social3.svg" alt="YouTube")
    div.footer__bottom
      a(href="#") {site.strings.privacy}
      p {site.strings.copyright}
