// The report dialog (the original's partials/report_modal.html): the reason,
// a few words about it, the error line and the two buttons.
//
// The texts are the original's English literals — the backend translates what
// it answers, so the error line carries the backend's own text; the labels of
// the form are the originals'.
dialog.amodal(open={report.open} aria-labelledby="report-modal-title" data-testid="report-modal" @keydown=onKey)
  form.amodal__card(@submit.prevent=submit)
    h3.amodal__title#report-modal-title(data-testid="report-title") {report.title}
    if !report.done
      div.amodal__card(style="padding: 0")
        label.amodal__field
          span.amodal__label Reason
          select.amodal__input(name="reason" data-testid="report-reason" value=report.reason @change=setReason)
            option(value="spam" selected={report.reason == "spam"}) Spam or advertising
            option(value="abuse" selected={report.reason == "abuse"}) Abuse or harassment
            option(value="fake" selected={report.reason == "fake"}) Fake or misleading
            option(value="other" selected={report.reason == "other"}) Something else
        label.amodal__field
          span.amodal__label What happened
          textarea.amodal__input.amodal__textarea(name="details" rows="4" maxlength="500" data-testid="report-details" value=report.details @input=setDetails)
    p.amodal__error(role="alert" data-testid="report-error" hidden={!report.error}) {report.error}
    p.amodal__hint(role="status" data-testid="report-done" hidden={!report.done}) Thank you. The moderators will look at it.
    div.amodal__actions
      button.work__btn(type="button" data-testid="report-cancel" @click=cancel) Cancel
      if !report.done
        button.work__btn.work__btn__bg(type="submit" data-testid="report-send") Send the report
