// The projects page: the list and the form of a new project. The flags it
// branches on (`loading`, `failed`, `ready`, `empty`) and the strings it shows
// are worked out in projects.ts: the template reads, it does not compare.
section.vd-projects
  div.vd-hero
    h1.vd-title Programs, drawn
    p.vd-lead A project is a diagram of the data flow of the backend and an interface that gets its data from that diagram. Both are kept here, in Postgres.

  form.ui-card.vd-new(@submit.prevent=create)
    div.ui-card-header
      h2.ui-card-title New project
      p.ui-card-description {about}
    div.ui-card-content.vd-new__body
      div.vd-templates(role="radiogroup" aria-label="Start from")
        for t in templates key t.id
          button.vd-template(type="button" role="radio" aria-checked=t.checkedAttr class:vd-template--on={t.on} @click=setTemplate(t.id))
            strong {t.title}
      div.vd-new__row
        input.ui-input(type="text" value=name placeholder="Project name" aria-label="Project name" maxlength="120" @input=setName)
        button.ui-button.ui-button-default(type="submit" disabled={busy}) Create
      if error
        p.ui-field-error {error}

  div.vd-list
    h2.vd-h2 Your projects
    if loading
      p.vd-hint Loading the projects...
    if failed
      div.ui-card.vd-failed
        div.ui-card-header
          h3.ui-card-title The projects could not be loaded
          p.ui-card-description {error}
        div.ui-card-footer
          button.ui-button.ui-button-default(type="button" @click=retry) Try again
    if ready
      if empty
        p.vd-hint Nothing here yet: start one above.
      for p in items key p.id
        article.ui-card.vd-project
          div.vd-project__main
            a.vd-project__name(href=p.flowHref @click.prevent=navigateTo(p.flowHref)) {p.name}
            span.vd-hint Edited {p.when}
          div.vd-project__actions
            a.ui-button.ui-button-outline.ui-button-sm(href=p.flowHref @click.prevent=navigateTo(p.flowHref)) Diagram
            a.ui-button.ui-button-outline.ui-button-sm(href=p.uiHref @click.prevent=navigateTo(p.uiHref)) Interface
            if p.asking
              button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=remove(p.id)) Delete for good
              button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=cancelDelete) Keep
            else
              button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label=p.deleteLabel @click=askDelete(p.id)) Delete
