{
  "name": "phone-crm-app",
  "private": true,
  "version": "0.1.0",
  "description": "Phone Retail CRM: ui-kit template on a pavlus frontend, a plain node backend and Postgres",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env backend/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env backend/server.ts",
    "db:init": "node --env-file-if-exists=.env backend/db/init.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@service-laboratory/pavlus": "*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
