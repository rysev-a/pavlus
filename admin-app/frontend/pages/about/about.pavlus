// A page without logic: only a template. State = the props passed by the
// shell (`pages`). Its events reach the shell prefixed with `about.`.
section.about
  div.ui-page-header
    div
      h1.page-title.ui-page-title About
      p.page-intro.ui-page-description
        | This admin panel is built with pavlus: the application code is pure
        | functions, and everything with side effects (DOM, HTTP, routing) is a plugin.
  div.ui-card
    div.ui-card-header
      h2.ui-card-title Pages
    div.ui-card-content
      ul.about__pages
        for page in pages key page.path
          li.about__page
            a.ui-button.ui-button-outline.ui-button-sm(href=page.path @click.prevent=navigate(page.path)) {page.title}
            span.about__path.muted {page.path}
