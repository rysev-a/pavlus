// State = the props passed by the parent: items, status.
section.roles.ui-card
  div.ui-card-header
    h2.ui-card-title Roles ({items.length})
    if status === "loading"
      p.status.ui-card-description Loading...
    else if status === "failed"
      p.status.status--error.ui-card-description Could not load roles
  div.ui-table-container
    table.ui-table
      thead.ui-table-header
        tr.ui-table-row
          th.ui-table-head Role
          th.ui-table-head Description
          th.ui-table-head Users
      tbody.ui-table-body
        for role in items key role.id
          tr.roles__item.ui-table-row
            td.roles__name.ui-table-cell {role.name}
            td.roles__description.ui-table-cell.ui-cell-muted {role.description}
            td.ui-table-cell
              span.roles__count.ui-badge.ui-badge-outline {role.users} {role.users === 1 ? "user" : "users"}
