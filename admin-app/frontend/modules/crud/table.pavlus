// The shadcn "tasks" data table: a toolbar (search, a faceted filter, reset),
// the table with row checkboxes and a delete per row, and the pagination
// footer. State = the table's slice (see table.ts) plus the props.
section(class=section)
  div.ui-page-header
    div
      h1.page-title.ui-page-title {title}
      p.page-intro.ui-page-description {subtitle}
    if createPath
      a.ui-button.ui-button-primary(href=createPath @click.prevent=navigate(createPath)) New
  if status === "loading"
    p.status.ui-page-description Loading...
  else if status === "failed"
    p.status.status--error.ui-page-description Could not load the list
  else
    div.ui-data-table
      if searchable || facetFilter
        div.ui-data-toolbar
          if searchable
            div.ui-data-search
              span.ui-icon(data-icon="search")
              input.ui-input(value=query @input=setQuery placeholder={searchPlaceholder} aria-label="Filter")
          if facetFilter
            details.ui-facet
              summary.ui-facet-button.ui-button.ui-button-outline.ui-button-sm
                span.ui-icon(data-icon="sliders-horizontal")
                span {facetFilter.label}
                if facet.length > 0
                  span.ui-facet-active {facet.length}
              div.ui-facet-panel
                div.ui-facet-heading {facetFilter.label}
                for option in facetFilter.options key option
                  label.ui-facet-option
                    input.ui-data-check(type="checkbox" checked=(facet.indexOf(option) > -1) @change=toggleFacet(facetFilter.field, option))
                    span {option}
          if (query !== "" || facet.length > 0)
            button.filters-reset.ui-button.ui-button-ghost.ui-button-sm(@click=resetFilters)
              span.ui-icon(data-icon="x")
              span Reset
      div.ui-data-scroll
        table.ui-table
          thead.ui-table-header
            tr.ui-table-row
              th.ui-resource-check
                input.ui-data-check(type="checkbox" checked=allSelected @change=togglePage aria-label="Select the page")
              for col in columns key col.field
                th.ui-table-head {col.title}
              if editPath
                th.ui-table-head
              th.ui-resource-actions-head
          tbody.ui-table-body
            for item in rows key item.id
              tr(class={section + "__row"} data-selected=(selected.indexOf(item.id) > -1 ? "true" : "false"))
                td.ui-resource-check
                  input.ui-data-check(type="checkbox" checked=(selected.indexOf(item.id) > -1) @change=toggleRow(item.id) aria-label={"Select row " + item.id})
                for col in columns key col.field
                  if (col.field === "status")
                    td.ui-table-cell
                      span(class={"ui-badge " + (item[col.field] === "done" ? "ui-badge-success" : (item[col.field] === "running" ? "ui-badge-info" : (item[col.field] === "failed" ? "ui-badge-destructive" : "ui-badge-secondary")))}) {item[col.field]}
                  else if (col.field === "price" || col.field === "total" || col.field === "stock" || col.field === "memory" || col.field === "progress" || col.field === "pid" || col.field === "cpu")
                    td.ui-table-cell
                      span.ui-cell-number {item[col.field]}
                  else
                    td.ui-table-cell {item[col.field]}
                if editPath
                  td.ui-table-cell
                    a.ui-button.ui-button-outline.ui-button-sm(href={editPath + "/" + item.id + "/edit"} @click.prevent=navigate(editPath + "/" + item.id + "/edit")) Edit
                td.ui-resource-actions
                  button.row-delete.ui-button.ui-button-ghost.ui-button-icon-sm(title="Delete" @click=removeRow(item.id))
                    span.ui-icon(data-icon="trash")
            if rows.length === 0
              tr.ui-resource-empty
                td(colspan=(editPath ? columns.length + 3 : columns.length + 2)) Nothing here yet.
      div.ui-resource-footer
        div.ui-data-footer-controls
          if selected.length > 0
            button.delete-selected.ui-button.ui-button-destructive.ui-button-sm(@click=removeSelected)
              span.ui-icon(data-icon="trash")
              span {"Delete selected (" + selected.length + ")"}
          span.ui-cell-muted {total} row(s)
        div.ui-data-footer-controls
          div.ui-data-rows
            span.ui-cell-muted Rows per page
            select.ui-select-control.ui-data-rows-select(value=pageSize @change=setPageSize aria-label="Rows per page")
              for size in pageSizes key size
                option(value=size selected=(pageSize == size)) {size}
          span.ui-cell-muted Page {page} of {pageCount}
          div.ui-resource-pager
            button.ui-button.ui-button-outline.ui-button-icon-sm(@click=goToPrev disabled=(page === 1) aria-label="Previous page")
              span.ui-icon(data-icon="chevron-left")
            for p in pages key p
              button.ui-button.ui-button-outline.ui-button-icon-sm(data-active=(p === page ? "true" : "false") @click=goToPage(p) aria-label={"Page " + p}) {p}
            button.ui-button.ui-button-outline.ui-button-icon-sm(@click=goToNext disabled=(page === pageCount) aria-label="Next page")
              span.ui-icon(data-icon="chevron-right")
