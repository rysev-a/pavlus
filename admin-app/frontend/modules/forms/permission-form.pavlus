// Create or edit a permission: the code (like `users.write`) and what it means.
section.permission-form.form
  div.ui-page-header
    div
      h1.page-title.ui-page-title {route.params.id ? "Edit permission" : "New permission"}
      p.page-intro.ui-page-description The permission's code and what it allows.
  div.ui-card
    div.ui-card-content
      if status === "loading"
        p.status.ui-card-description Loading...
      else if status === "failed"
        p.status.status--error.ui-card-description Could not load the permission
      else
        form.form__body(@submit.prevent=save)
          div.form__field
            label.form__label.ui-field-label(for="permission-code") Code
            input#permission-code.ui-input(value=values.code @input=setCode placeholder="users.write" autocomplete="off")
          div.form__field
            label.form__label.ui-field-label(for="permission-description") Description
            textarea#permission-description.ui-textarea-control(value=values.description @input=setDescription placeholder="Create and edit users")
          if saveStatus === "failed"
            p.status.status--error.form__error Could not save: the code must be non-empty and unique.
          div.form__actions
            button.ui-button.ui-button-primary(type="submit" disabled=(saveStatus === "saving")) Save
            a.ui-button.ui-button-outline(href="/auth/permissions" @click.prevent=navigate("/auth/permissions")) Cancel
