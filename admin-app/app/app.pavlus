// The shell of the page: the sidebar and whichever page the route selects.
// Each page is a route of its own (`/` the users table, `/new` the create
// form, `/:id/edit` one user's form), rendered in place by the matched
// routing entry — the pages paint themselves (a write answers "paint", the
// page diffs its slice, the boundary scopes the patches), and the shell
// paints the route itself: a route change swaps the outlet's content in the
// shell's own paint. The sidebar is a view-only child of the shell's view:
// the menu and the route arrive as props, and its clicks fall through to the
// framework's default (`sidebar.navigate` → `router.navigate("/")`).
import Sidebar from "./sidebar/sidebar.pavlus"

div.ui-shell
  +Sidebar#sidebar(menu=menu route=route)
  div.ui-shell-body
    main.ui-shell-content
      +outlet
