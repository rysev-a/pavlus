// The users page (`/`): the shell's header and the table, one mini-application
// that owns its slice (`list`). Every write answers "paint", and the paint
// handler diffs the slice and hands the patches to the dom plugin; the page is
// routed, so the outlet's boundary scopes them. The table is the ui-kit's data
// table: a toolbar filter, checkboxes that select rows, headers that sort, a
// badge for the role and a footer with the selection count, the rows-per-page
// select and the pager.
//
// The table's rows are keyed embeds: `for id in order` walks the page's ids
// and `+Row#row(key=id ...byId[id])` renders each row's own cells (the user's
// data and the star — user-list-row/), its events addressed `row.<id>.` to
// its own component instance. The row is one child in `children` with `each:
// "byId"`: the boundary hands each instance exactly its element of the map,
// and its writes land back in it. What belongs to the table as a whole — the
// checkbox (the selection is the table's state), the edit and delete buttons
// (they change what the whole page shows) — stays in this template, outside
// the embed: those messages are the page's, addressed without a key.
//
// The page header is a component of its own — the keyless `+Header#header`
// embed (user-list-header/): its events arrive as `header.…` at its own
// component, which sees the page's whole state (keyless: nothing to slice).
// The header's "new user" button and a row's edit button navigate to their
// pages; the bottom "reset" button rebuilds the demo database.
import Row from "./user-list-row/user-list-row.pavlus"
import Header from "./user-list-header/user-list-header.pavlus"
if status == "loading"
  p.status Loading...
else
  if error
    p.status.status--error {error}
  +Header#header
  div.table-card.ui-data-table
    div.toolbar.ui-data-toolbar
      div.ui-data-search
        span.ui-icon(data-icon="search")
        input.flt.ui-input(type="search" value=filter placeholder="Filter users..." @input=search)
    div.ui-data-scroll
      table.users
        thead
          tr
            th.ui-resource-check
              input.sel-all.ui-data-check(type="checkbox" aria-label="Select all rows on this page" checked=allOn @change=pickAll)
            th.sortable(@click=sort("id")) Id {sortKey == "id" ? (sortDir == 1 ? " ▲" : " ▼") : ""}
            th.sortable(@click=sort("name")) Name {sortKey == "name" ? (sortDir == 1 ? " ▲" : " ▼") : ""}
            th.sortable(@click=sort("email")) Email {sortKey == "email" ? (sortDir == 1 ? " ▲" : " ▼") : ""}
            th.sortable(@click=sort("role")) Role {sortKey == "role" ? (sortDir == 1 ? " ▲" : " ▼") : ""}
            th
            th
        tbody
          if order.length == 0
            tr
              td.ui-resource-empty(colspan="7") No users match — change the filter or create one.
          for id in order key id
            tr(data-selected={selected.includes(id) ? "true" : null})
              td.ui-resource-check
                input.ui-data-check(type="checkbox" aria-label="Select row" checked={selected.includes(id)} @change=pick(id))
              +Row#row(key=id ...byId[id])
              td.actions
                button.edit.ui-button.ui-button-ghost.ui-button-icon-sm(type="button" aria-label="Edit" @click=edit(id))
                  span.ui-icon(data-icon="pencil")
                button.del.ui-button.ui-button-ghost.ui-button-icon-sm.row-delete(type="button" aria-label="Delete" @click=remove(id))
                  span.ui-icon(data-icon="trash")
    div.table-foot.ui-resource-footer
      span.sel
        {selected.length} of {total} row(s) selected
      div.pager.ui-data-footer-controls
        label.ui-data-rows
          | Rows per page
          select.pages.ui-select-control.ui-data-rows-select(@change=resize)
            option(value="10" selected=(pageSize == 10)) 10
            option(value="20" selected=(pageSize == 20)) 20
            option(value="50" selected=(pageSize == 50)) 50
            option(value="100" selected=(pageSize == 100)) 100
        span.count Page {page} of {pages}
        div.ui-resource-pager
          button.pg.ui-button.ui-button-outline.ui-button-sm(type="button" disabled=(page == 1) @click=turn(-1)) Previous
          button.pg.ui-button.ui-button-outline.ui-button-sm(type="button" disabled=(page >= pages) @click=turn(1)) Next
  button.reset.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=reset) reset data
