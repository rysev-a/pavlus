{
  "name": "admin-app",
  "private": true,
  "version": "0.1.0",
  "description": "Admin dashboard: static pavlus frontend + plain node backend on Postgres",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env backend/server.ts",
    "build": "vite build && vite build --ssr frontend/entry-server.ts --outDir dist/server",
    "start": "NODE_ENV=production node --env-file-if-exists=.env backend/server.ts",
    "db:init": "node --env-file-if-exists=.env backend/db/init.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@service-laboratory/pavlus": "*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
