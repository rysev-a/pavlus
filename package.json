{
  "name": "pavlus-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "framework/frontend",
    "framework/backend",
    "framework/core",
    "framework/ui-kit",
    "applications/admin",
    "applications/visual-design",
    "applications/mobile-dev",
    "applications/phone-crm",
    "applications/coffee-shop",
    "applications/social-network"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "docs:build": "node docs/site/scripts/build.ts",
    "debug:sync-firefox": "node framework/debug-panel/sync-firefox.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5"
  }
}
