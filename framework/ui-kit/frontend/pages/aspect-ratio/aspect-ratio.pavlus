section.k-page
  section.k-demo
    h2.k-demo__title 16 / 9
    div.k-preview
      div.k-narrow
        div.k-aspect 16 / 9
  section.k-demo
    h2.k-demo__title 1 / 1 and 4 / 3
    div.k-preview
      div(style="width: 160px")
        div.k-aspect(style="aspect-ratio: 1 / 1") 1 / 1
      div(style="width: 240px")
        div.k-aspect(style="aspect-ratio: 4 / 3") 4 / 3
