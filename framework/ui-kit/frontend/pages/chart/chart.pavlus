// Charts without SVG: bars are boxes and the area is a box clipped by a
// polygon (the dom plugin knows the svg namespace now, but the kit keeps its
// box-built charts). Colors are the theme's chart tokens.
section.k-page
  section.k-demo
    h2.k-demo__title Bar chart
    div.k-preview.k-preview--block
      div.k-row(style="margin-bottom: 16px")
        button.ui-button.ui-button-sm(type="button" class:ui-button-default={metric === "revenue"} class:ui-button-outline={metric !== "revenue"} @click=show("revenue")) Revenue
        button.ui-button.ui-button-sm(type="button" class:ui-button-default={metric === "visitors"} class:ui-button-outline={metric !== "visitors"} @click=show("visitors")) Visitors
      div.k-chart
        div.k-chart__plot
          for bar in bars key bar.label
            div.k-chart__bar(style="height: {bar.height}%" title="{bar.label}: {bar.value}")
        div.k-chart__labels
          for bar in bars key bar.label
            span {bar.label}
  section.k-demo
    h2.k-demo__title Area chart
    div.k-preview.k-preview--block
      div.k-chart
        div.k-chart__plot
          div.k-chart__area(style="clip-path: {area}")
        div.k-chart__labels
          for bar in bars key bar.label
            span {bar.label}
  section.k-demo
    h2.k-demo__title Grouped bars with a legend
    div.k-preview.k-preview--block
      div.k-chart
        div.k-chart__legend
          span
            i
            | Desktop
          span
            i.k-chart__swatch--2
            | Mobile
        div.k-chart__plot
          for pair in grouped key pair.label
            div.k-chart__group
              div.k-chart__bar(style="height: {pair.a}%")
              div.k-chart__bar.k-chart__bar--2(style="height: {pair.b}%")
        div.k-chart__labels
          for pair in grouped key pair.label
            span {pair.label}
