section.k-page
  section.k-demo
    h2.k-demo__title Six digits
    div.k-preview
      div.ui-input-otp
        label.ui-input-otp-label(for="otp") Verification code
        div.ui-input-otp-control
          div.ui-input-otp-slots
            for slot in slots key slot.index
              span.ui-input-otp-slot {slot.char}
          input.ui-input-otp-input#otp(type="text" inputmode="numeric" autocomplete="one-time-code" value=code @input=change)
    p.k-hint
      | {complete ? "Code complete: " : "Typed: "}
      span.k-state {code ? code : "nothing"}
