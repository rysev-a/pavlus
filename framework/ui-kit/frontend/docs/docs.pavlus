// The Docs: language switcher, the page (Markdown parsed into blocks), the
// compiled demos, the playground, the table of contents and the neighbours.
// State = the props passed by the shell. Its clicks reach the shell
// (`setLang`, `jump`, `openDoc`, `pgInput`, `pgRun`, `pgReset`).
import Inline from "../blocks/docs-layout/inline.pavlus"
import Code from "./code.pavlus"
import Demo from "./demo.pavlus"

section.k-docs
  div.k-docs__bar
    h1.k-docs__title#docs-title(tabindex="-1") {title}
    div.k-docs__langs(role="group" aria-label={ui.language})
      for l in langs key l.code
        button.ui-button.ui-button-sm(type="button" lang={l.code} aria-pressed={l.code === lang ? "true" : "false"} class:ui-button-secondary={l.code === lang} class:ui-button-outline={l.code !== lang} @click=setLang(l.code)) {l.name}
  p.k-docs__lead {summary}
  div.k-docs__body
    article.k-docs__main
      if status === "loading"
        p.k-hint {ui.loading}
      if status === "failed"
        p.k-docs__error {ui.failed}
      if doc
        for block in doc.blocks key block.i
          if block.kind === "h2"
            h2.k-docs__h2(id=block.id tabindex="-1") {block.text}
          else if block.kind === "h3"
            h3.k-docs__h3(id=block.id tabindex="-1") {block.text}
          else if block.kind === "p"
            p.k-docs__p
              +Inline#runs(runs=block.runs)
          else if block.kind === "ul"
            ul.k-docs__list
              for item, j in block.items key j
                li
                  +Inline#runs(runs=item)
          else if block.kind === "ol"
            ol.k-docs__list
              for item, j in block.items key j
                li
                  +Inline#runs(runs=item)
          else if block.kind === "code"
            figure.k-docs__fig
              if block.title
                figcaption {block.title}
              +Code#code(lines=block.lines)
          else if block.kind === "callout"
            aside.k-docs__callout(data-tone=block.tone)
              strong {block.title ? block.title : ui.tone[block.tone]}
              p
                +Inline#runs(runs=block.runs)
          else if block.kind === "table"
            div.k-docs__table
              table.ui-table
                thead.ui-table-header
                  tr.ui-table-row
                    for cell, j in block.head key j
                      th.ui-table-head
                        +Inline#runs(runs=cell)
                tbody.ui-table-body
                  for row, r in block.rows key r
                    tr.ui-table-row
                      for cell, j in row key j
                        td.ui-table-cell
                          +Inline#runs(runs=cell)
          else if block.kind === "demo"
            if block.view
              +Demo#demo(view=block.view ui=ui)
            else
              p.k-docs__error demo "{block.name}" is missing
          else if block.kind === "playground"
            div.k-docs__pg
              p.k-docs__muted {ui.playground.hint}
              div.k-docs__pg-cols
                label.k-docs__pg-field
                  span {ui.playground.template}
                  textarea.ui-textarea.k-docs__pg-edit(rows="12" spellcheck="false" value=pgTemplate @input=pgInput("template"))
                label.k-docs__pg-field
                  span {ui.playground.state}
                  textarea.ui-textarea.k-docs__pg-edit(rows="12" spellcheck="false" value=pgState @input=pgInput("state"))
              div.k-docs__pg-actions
                button.ui-button.ui-button-sm(type="button" @click=pgRun) {ui.playground.run}
                button.ui-button.ui-button-sm.ui-button-outline(type="button" @click=pgReset) {ui.playground.reset}
              if pgError
                p.k-docs__error {ui.playground.stateError} {pgError}
              if pgView
                +Demo#pg(view=pgView ui=ui)
      div.k-docs__pager
        if prev
          a.k-dl__pager-link(href={root + "/docs/" + prev.slug} @click.prevent=openDoc(prev.slug))
            small {ui.previous}
            strong {prev.title}
        else
          span
        if next
          a.k-dl__pager-link.k-dl__pager-link--next(href={root + "/docs/" + next.slug} @click.prevent=openDoc(next.slug))
            small {ui.next}
            strong {next.title}
    aside.k-docs__toc
      if doc
        if doc.toc.length > 0
          p.k-dl__toc-title {ui.onThisPage}
          ul.k-dl__toc-list
            for item in doc.toc key item.id
              li(data-level={item.level})
                a(href={"#" + item.id} @click.prevent=jump(item.id)) {item.text}
