import Days from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Pick a day
    p.k-demo__note Days before today and Sundays are not available.
    div.k-preview.k-preview--center
      +Days#days(title=title weekdays=weekdays cells=cells canGoBack=canGoBack)
    p.k-hint
      | Selected:
      |
      span.k-state {label}
