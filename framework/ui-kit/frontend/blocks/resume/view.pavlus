// A resume, to embed. State = the props (see `ResumeData` in resume.ts):
// name, title, location, initials, contacts, summary, experience, education,
// skills, languages.
import Timeline from "../timeline/view.pavlus"
import Skills from "./skills.pavlus"

article.k-resume
  header.k-resume__head
    span.ui-avatar.k-resume__avatar
      span.ui-avatar-fallback {initials}
    div.k-resume__who
      h2.k-resume__name {name}
      p.k-resume__title {title}
      ul.k-resume__contacts
        for contact in contacts key contact.label
          li
            a.k-resume__contact(href=contact.href)
              span.k-icon(class="k-icon {contact.icon}")
              | {contact.label}
  div.k-resume__cols
    div.k-resume__main
      section.k-resume__section
        h3.k-resume__heading Summary
        p.k-resume__summary {summary}
      section.k-resume__section
        +Timeline#experience(items=experience heading="Experience")
      section.k-resume__section
        +Timeline#education(items=education heading="Education")
    aside.k-resume__side
      section.k-resume__section
        h3.k-resume__heading Skills
        +Skills#skills(skills=skills)
      section.k-resume__section
        h3.k-resume__heading Languages
        ul.k-resume__langs
          for lang in languages key lang.name
            li.k-resume__lang
              strong {lang.name}
              span.ui-badge.ui-badge-outline {lang.level}
