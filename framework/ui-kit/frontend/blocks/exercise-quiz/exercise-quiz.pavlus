import Choice from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title One answer
    div.k-preview.k-preview--column
      +Choice#one(...one)
      div.k-row
        button.ui-button.ui-button-default.ui-button-sm(type="button" @click=checkOne) Check
        if verdictOne === "correct"
          span.ui-pill.ui-pill-success Correct
        else if verdictOne === "wrong"
          span.ui-pill.ui-pill-destructive Not quite, try again
  section.k-demo
    h2.k-demo__title Select all that apply
    div.k-preview.k-preview--column
      +Choice#many(...many)
      div.k-row
        button.ui-button.ui-button-default.ui-button-sm(type="button" @click=checkMany) Check
        if verdictMany === "correct"
          span.ui-pill.ui-pill-success Correct
        else if verdictMany === "wrong"
          span.ui-pill.ui-pill-destructive Not quite, try again
