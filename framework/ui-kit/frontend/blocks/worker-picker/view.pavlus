// Cards to pick a person, to embed. State = the props: `workers`, a list of
// { id, name, role, initials, specialties, rating, reviews, tone (1-5),
// selected }. A click sends `pick(id)` (`<id>.pick` in a parent).
div.k-workers(role="radiogroup" aria-label="Choose a specialist")
  for worker in workers key worker.id
    button.k-worker(type="button" role="radio" aria-checked={worker.selected ? "true" : "false"} class:is-selected={worker.selected} @click=pick(worker.id))
      span.ui-avatar.ui-avatar-lg.k-worker__avatar(data-tone={worker.tone})
        span.ui-avatar-fallback {worker.initials}
      span.k-worker__body
        strong.k-worker__name {worker.name}
        span.k-worker__role {worker.role}
        span.k-worker__rating
          span.k-worker__stars ★
          | {worker.rating}
          span.k-muted ({worker.reviews} reviews)
        span.k-worker__tags
          for tag in worker.specialties key tag
            span.ui-badge.ui-badge-secondary {tag}
      if worker.selected
        span.k-worker__check
          span.k-icon.k-icon-check
