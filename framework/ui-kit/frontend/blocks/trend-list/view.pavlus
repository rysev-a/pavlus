// Trending topics, to embed: `+Trends#trends(...trends)`. State = title, items
// ({ id, rank, tag, sub (like "2.4k posts"), active }). A click sends `pick(id)`
// (`<name>.pick` in a parent).
section.ui-card.k-trends
  h3.k-trends__title {title}
  ol.k-trends__list
    for t in items key t.id
      li
        button.k-trends__row(type="button" class:is-active={t.active} @click=pick(t.id))
          span.k-trends__rank {t.rank}
          span.k-trends__text
            strong.k-trends__tag {t.tag}
            span.k-trends__sub {t.sub}
