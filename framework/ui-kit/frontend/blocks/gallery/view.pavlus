// A gallery, to embed as a child (it has its own state and messages: pick,
// open, close, next, prev). State = see `GalleryState` in gallery.ts.
section.k-gal
  div.ui-tabs-list.k-gal__tabs(role="tablist")
    for cat in categories key cat.id
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={cat.id === category ? "true" : "false"} @click=pick(cat.id))
        | {cat.label}
        span.k-gal__count {cat.count}
  div.k-gal__grid
    for item in shown key item.key
      figure.k-gal__item
        button.k-gal__tile(type="button" data-tone=item.tone data-shape=item.shape aria-label="Open {item.title}" @click=open(item.key))
          span.k-gal__emoji {item.emoji}
        figcaption.k-gal__caption
          strong {item.title}
          span {item.caption}
  if current
    div.k-gal__lightbox
      div.k-gal__scrim(@click=close)
      div.k-gal__stage#gal-lightbox(role="dialog" aria-modal="true" aria-label=current.title tabindex="-1" @keydown=key)
        button.ui-button.ui-button-secondary.ui-button-icon.k-gal__close(type="button" aria-label="Close" @click=close)
          span.k-icon.k-icon-x
        button.ui-button.ui-button-secondary.ui-button-icon.k-gal__nav.k-gal__nav--prev(type="button" aria-label="Previous photo" @click=prev)
          span.k-icon.k-icon-chevron-left
        figure.k-gal__figure
          div.k-gal__frame(data-tone=current.tone data-shape=current.shape)
            span.k-gal__emoji.k-gal__emoji--big {current.emoji}
          figcaption.k-gal__lbcaption
            strong {current.title}
            span {current.caption}
            small {position}
        button.ui-button.ui-button-secondary.ui-button-icon.k-gal__nav.k-gal__nav--next(type="button" aria-label="Next photo" @click=next)
          span.k-icon.k-icon-chevron-right
