import Nav from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Folders, labels and shortcuts
    p.k-demo__note The counts come from the mailbox: unread in the Inbox, Starred and Spam, the number of drafts in Drafts.
    div.k-preview.k-preview--block
      div.k-mfold-demo
        +Nav#nav(folders=folders labels=labels shortcuts=shortcuts)
      if last
        p.k-hint Pressed: {last}
