// The head of a wall or of a community, to embed: `+Head#head(...header)`. State = coverStyle,
// avatarStyle, avatarText, title, subtitle, about, badges ({ label, tone }), stats ({ label, value }),
// actions ({ id, label, variant, disabled }). Events (with the name of the embed in front): action(id).
div.ui-card.k-shead
  div.k-shead__cover(style={coverStyle})
  div.k-shead__main
    span.k-shead__avatar(style={avatarStyle}) {avatarText}
    div.k-shead__info
      div.k-shead__titleline
        h2.k-shead__title {title}
        for b in badges key b.label
          span(class="ui-badge ui-badge-{b.tone}") {b.label}
      if subtitle
        p.k-shead__sub {subtitle}
      if about
        p.k-shead__about {about}
      if stats.length > 0
        ul.k-shead__stats
          for s in stats key s.label
            li
              strong {s.value}
              span {s.label}
    if actions.length > 0
      div.k-shead__actions
        for a in actions key a.id
          button(type="button" class="ui-button ui-button-{a.variant} ui-button-sm" disabled={a.disabled} @click=action(a.id)) {a.label}
