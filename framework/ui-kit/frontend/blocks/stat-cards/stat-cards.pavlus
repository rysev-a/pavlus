import Stats from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Four KPIs with a trend
    div.k-preview.k-preview--block
      +Stats#stats(cards=cards)
  section.k-demo
    h2.k-demo__title Plain, without bars
    div.k-preview.k-preview--block
      +Stats#plain(cards=plain)
