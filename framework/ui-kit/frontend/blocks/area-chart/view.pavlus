// A line and area chart, to embed. State = the props: `chart` (areaChart()
// from area.ts: { points, ticks, area, line }) and an optional `height` (a CSS
// length). Labels under the plot are the labels of the points.
div.k-achart(style="height: {height ?? '230px'}")
  div.k-achart__axis
    for t in chart.ticks key t.id
      span.k-achart__tick(style="bottom: {t.y}%") {t.label}
  div.k-achart__plot
    for t in chart.ticks key t.id
      span.k-achart__rule(style="bottom: {t.y}%")
    div.k-achart__area(style="clip-path: {chart.area}")
    div.k-achart__stroke(style="clip-path: {chart.line}")
    for p in chart.points key p.id
      div.k-achart__hit(title="{p.label}: {p.text}" style="left: {p.left}%; width: {p.width}%")
        span.k-achart__dot(style="bottom: {p.y}%")
        span.k-achart__tip(style="bottom: {p.y}%") {p.text}
  div.k-achart__labels
    for p in chart.points key p.id
      span.k-achart__label(style="left: {p.x}%") {p.label}
