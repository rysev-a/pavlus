// Nested replies, to embed: `+Tree#tree(...tree)` with `rows` from `rowsOf` in
// reply-tree.ts, plus `draft`, `canSend`. A row = id, depth (0-4), name,
// initials, tone, text, ago, score, vote, badge, op, accepted, hidden,
// canAccept, canMod, replying; and `canReply` (false hides every Reply link).
// Messages (`<name>.vote` ...): vote([id, dir]), reply(id), accept(id),
// moderate(id), draft, send, cancel.
import Vote from "../vote-buttons/view.pavlus"

div.k-rtree
  for r in rows key r.id
    article.k-rtree__item(class:is-accepted={r.accepted} class:is-hidden={r.hidden} style="--depth: {r.depth}")
      +Vote#vote(id=r.id score=r.score vote=r.vote)
      div.k-rtree__body
        header.k-rtree__head
          span.k-rtree__av(style="--t: var(--chart-{r.tone})") {r.initials}
          strong.k-rtree__name {r.name}
          if r.op
            span.ui-badge.ui-badge-secondary OP
          if r.badge
            span.ui-badge.ui-badge-outline {r.badge}
          span.k-rtree__ago {r.ago}
          if r.accepted
            span.ui-badge.ui-badge-default
              span.k-icon.k-icon-check
              | Accepted
        if r.hidden
          p.k-rtree__text.k-rtree__text--hidden Hidden by a moderator.
        else
          p.k-rtree__text {r.text}
        footer.k-rtree__foot
          if canReply !== false
            button.k-rtree__link(type="button" @click=reply(r.id)) Reply
          if r.canAccept
            button.k-rtree__link(type="button" @click=accept(r.id)) {r.accepted ? "Unaccept" : "Accept answer"}
          if r.canMod
            button.k-rtree__link(type="button" @click=moderate(r.id)) {r.hidden ? "Unhide" : "Hide"}
        if r.replying
          form.k-rtree__form(novalidate @submit.prevent=send)
            textarea.ui-textarea-control(rows="3" aria-label="Your reply" placeholder="Write a reply to {r.name}" value=draft @input=draft)
            div.k-rtree__formrow
              button.ui-button.ui-button-default.ui-button-sm(type="submit" disabled={!canSend}) Post reply
              button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=cancel) Cancel
