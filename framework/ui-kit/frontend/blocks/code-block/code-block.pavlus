import CodeBlock from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title TypeScript with a title
    div.k-preview.k-preview--block
      +CodeBlock#ts(title="counter.ts" lang="ts" lines=ts)
  section.k-demo
    h2.k-demo__title Shell, no line numbers
    div.k-preview.k-preview--block
      +CodeBlock#sh(lang="sh" lines=sh plain="yes")
  section.k-demo
    h2.k-demo__title JSON
    div.k-preview.k-preview--block
      +CodeBlock#json(title="package.json" lang="json" lines=json)
