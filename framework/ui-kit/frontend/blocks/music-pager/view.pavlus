// Pages of a list, to embed. State = the props: `label` ("1-25 of 2,413"),
// `page`, `pages`, `jumps` ([{ n, active }]). Events, with the name of the
// embed in front: `prev`, `next`, `goto(n)`.
div.k-mpager
  span.k-mpager__label {label}
  div.k-mpager__nav
    button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={page <= 1} @click=prev) Previous
    for j in jumps key j.n
      button.ui-button.ui-button-sm.k-mpager__jump(type="button" aria-label="Page {j.n}" class:ui-button-secondary={j.active} class:ui-button-ghost={!j.active} @click=goto(j.n)) {j.n}
    button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={page >= pages} @click=next) Next
