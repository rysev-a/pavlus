// A profile top, to embed: `+Head#head(...head)`. State = id, name, handle ("" to
// hide), initials (or a logo emoji), tone (1-5), cover (1-5), square (true for a
// company logo), headline, bio, place, verified, stats ({ label, value }),
// primaryLabel ("" for no button), primaryDone, secondaryLabel ("" for none).
// Messages (`<name>.primary`, `<name>.secondary`) carry the id.
section.ui-card.k-phead
  div.k-phead__cover(style="--t: var(--chart-{cover})")
  div.k-phead__main
    span.k-phead__av(class:k-phead__av--square={square} style="--t: var(--chart-{tone})") {initials}
    div.k-phead__text
      h2.k-phead__name
        | {name}
        if verified
          span.k-icon.k-icon-check.k-phead__verified
      if handle
        span.k-phead__handle @{handle}
      p.k-phead__headline {headline}
    div.k-phead__acts
      if secondaryLabel
        button.ui-button.ui-button-outline(type="button" @click=secondary(id)) {secondaryLabel}
      if primaryLabel
        button.ui-button(type="button" class:ui-button-default={!primaryDone} class:ui-button-secondary={primaryDone} @click=primary(id))
          if primaryDone
            span.k-icon.k-icon-check
          | {primaryLabel}
  if bio
    p.k-phead__bio {bio}
  div.k-phead__foot
    if place
      span.k-phead__place
        span.k-icon.k-glyph(data-glyph="pin")
        | {place}
    ul.k-phead__stats
      for s in stats key s.label
        li
          strong {s.value}
          span {s.label}
