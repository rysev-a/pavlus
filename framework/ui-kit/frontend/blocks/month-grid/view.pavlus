// A month calendar, to embed. State = the props: `month` (monthCells():
// { title, weekdays, cells: [{ id, day, muted, today, selected, events: [{ id,
// label, tone }], more }] }). Events, with the name of the embed in front:
// `prev`, `next` (the buttons), `pick` (a day: its ISO date) and `open` (an
// event id).
div.k-mgrid
  div.k-mgrid__bar
    button.ui-button.ui-button-outline.ui-button-icon-sm(type="button" aria-label="Previous month" @click=prev)
      span.k-icon.k-icon-chevron-left
    strong.k-mgrid__title {month.title}
    button.ui-button.ui-button-outline.ui-button-icon-sm(type="button" aria-label="Next month" @click=next)
      span.k-icon.k-icon-chevron-right
  div.k-mgrid__week
    for name in month.weekdays key name
      span {name}
  div.k-mgrid__days
    for cell in month.cells key cell.id
      div.k-mgrid__cell(class:k-mgrid__cell--muted={cell.muted} class:k-mgrid__cell--today={cell.today} class:k-mgrid__cell--sel={cell.selected} @click=pick(cell.id))
        span.k-mgrid__num {cell.day}
        for ev in cell.events key ev.id
          button.k-mgrid__event(type="button" class="k-adm-t-{ev.tone}" title={ev.label} @click.stop=open(ev.id)) {ev.label}
        if cell.more > 0
          small.k-mgrid__more {cell.more} more
