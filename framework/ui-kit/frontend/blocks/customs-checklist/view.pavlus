// A document checklist for customs, to embed. State = the props: `rows`
// (docRows() from customs.ts) and `progress` (progressOf()). The button of a
// row moves the document one step: missing, uploaded, approved. Event:
// `<name>.cycle` (the document id). Optional `readonly`: no buttons.
div.k-cchk
  div.k-cchk__summary
    div.k-cchk__sumtext
      strong {progress.approved} of {progress.total} approved
      span(class="ui-pill ui-pill-{progress.ready ? 'success' : 'warning'}") {progress.text}
    div.ui-progress.ui-progress-sm.k-cchk__bar
      div.ui-progress-indicator(style="width: {progress.pct}%")
  ul.k-cchk__list
    for row in rows key row.id
      li(class="k-cchk__row k-cchk__row--{row.state}")
        span.k-cchk__check
          if row.state === "approved"
            span.k-icon.k-icon-check
        div.k-cchk__text
          p.k-cchk__title
            strong {row.title}
            if row.required
              span.ui-badge.ui-badge-secondary Required
          small {row.note}
        span(class="ui-pill ui-pill-{row.tone}") {row.stateLabel}
        if !readonly
          button.ui-button.ui-button-outline.ui-button-xs(type="button" @click=cycle(row.id)) {row.actionLabel}
