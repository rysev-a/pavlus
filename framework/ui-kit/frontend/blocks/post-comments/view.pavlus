// The comments of a post and a box to add one, to embed: `+Comments#cm(...thread)` where
// `thread` is `card.thread` from modules/wall/posts.ts. State = postId, comments
// ({ id, authorId, name, avatarStyle, avatarText, text, when, canDelete }), draft, canSend, me.
// Events (with the name of the embed in front): profile(authorId), remove(id), setDraft, send.
section.k-pcmt
  if comments.length === 0
    p.k-pcmt__empty No comments yet. Be the first.
  ul.k-pcmt__list
    for c in comments key c.id
      li.k-pcmt__item
        button.k-pcmt__av(type="button" aria-label="Open the wall of {c.name}" style={c.avatarStyle} @click=profile(c.authorId)) {c.avatarText}
        div.k-pcmt__body
          div.k-pcmt__bubble
            button.k-pcmt__name(type="button" @click=profile(c.authorId)) {c.name}
            p {c.text}
          div.k-pcmt__meta
            span {c.when}
            if c.canDelete
              button.k-pcmt__del(type="button" @click=remove(c.id)) Delete
  form.k-pcmt__form(novalidate @submit.prevent=send)
    input.ui-input(type="text" aria-label="Add a comment" placeholder="Write a comment" autocomplete="off" value={draft} @input=setDraft)
    button.ui-button.ui-button-default.ui-button-sm(type="submit" disabled={!canSend}) Send
