import Grid from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Class timetable, days by periods
    div.k-preview.k-preview--block
      +Grid#week(corner="Period" cols=weekCols rows=weekRows)
  section.k-demo
    h2.k-demo__title Day schedule, doctors by half hours
    div.k-preview.k-preview--block
      +Grid#day(corner="Time" cols=docCols rows=dayRows)
    p.k-demo__note {message}
