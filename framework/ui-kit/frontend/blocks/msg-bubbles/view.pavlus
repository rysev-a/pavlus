// The message bubbles of a chat, to embed. State = the props: `rows` (from
// `groupMessages` in messages.ts: day dividers and groups of bubbles),
// `typing` (a line like "Lena is typing...", or an empty string), `quick`
// (the emoji of the quick reaction bar) and `emptyText`. Events, with the
// name of the embed in front: `reply`, `pin`, `menu` (a message id), `react`
// (payload [message id, emoji]) and `jump` (the id of a quoted message).
div.k-bub
  if rows.length === 0
    div.k-bub__empty
      span.k-icon.k-icon-lg.k-mi-send
      p {emptyText}
  else
    div.k-bub__scroll
      div.k-bub__inner
        for r in rows key r.id
          if r.kind === "day"
            div.k-bub__day
              span {r.label}
          else
            div.k-bub__group(class:is-own={r.own})
              if r.showName
                span.k-mavatar.k-mavatar--sm.k-bub__avatar(style="--k-hue: {r.hue}") {r.initials}
              div.k-bub__stack
                if r.showName
                  span.k-bub__name(style="--k-hue: {r.hue}") {r.name}
                for b in r.bubbles key b.id
                  div.k-bub__item(class:is-own={b.own})
                    div.k-bub__line(class:is-own={b.own})
                      div.k-bub__bubble(id={"msg-" + b.id} tabindex="-1" class:is-own={b.own} class:is-first={b.first} class:is-last={b.last})
                        if b.reply
                          button.k-bub__quote(type="button" aria-label={"Go to the message from " + b.reply.name} @click=jump(b.reply.id))
                            strong {b.reply.name}
                            span {b.reply.text}
                        if b.text
                          p.k-bub__text {b.text}
                        if b.files.length > 0
                          ul.k-bub__files
                            for f in b.files key f.id
                              li.k-bub__file
                                span.k-icon.k-mi-clip
                                span.k-bub__file-name {f.name}
                                span.k-bub__file-size {f.sizeLabel}
                        span.k-bub__meta
                          if b.pinned
                            span.k-icon.k-mi-pin.k-bub__pin(title="Pinned")
                          span {b.time}
                          if b.state
                            span.k-icon.k-bub__state(class="{b.stateIcon}" data-state={b.state} title={b.stateLabel})
                      div.k-bub__actions
                        button.k-bub__act(type="button" aria-label="React" @click=menu(b.id))
                          span.k-icon.k-mi-smile
                        button.k-bub__act(type="button" aria-label="Reply" @click=reply(b.id))
                          span.k-icon.k-mi-reply
                        button.k-bub__act(type="button" aria-label={b.pinned ? "Unpin" : "Pin"} aria-pressed={b.pinned ? "true" : "false"} @click=pin(b.id))
                          span.k-icon.k-mi-pin
                    if b.menu
                      div.k-bub__quick(role="group" aria-label="Quick reactions")
                        for e in quick key e
                          button.k-bub__quick-btn(type="button" @click=react(b.id, e)) {e}
                    if b.reactions.length > 0
                      div.k-bub__reacts
                        for c in b.reactions key c.emoji
                          button.k-bub__react(type="button" class:is-mine={c.mine} title={c.title} aria-pressed={c.mine ? "true" : "false"} @click=react(b.id, c.emoji))
                            span {c.emoji}
                            span.k-bub__react-n {c.count}
        if typing
          div.k-bub__typing(role="status")
            span.k-bub__dots
              span
              span
              span
            span {typing}
