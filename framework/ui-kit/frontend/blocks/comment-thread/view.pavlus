// Comments and a box to add one, to embed: `+Comments#cm(...thread)`. State =
// comments ({ id, name, initials, tone, text, ago, likes, liked }), draft,
// canSend, me (my initials), placeholder. Messages (`<name>.like` ...): like(id),
// draft, send.
section.k-cthread
  if comments.length === 0
    p.k-cthread__empty Be the first to comment.
  ul.k-cthread__list
    for c in comments key c.id
      li.k-cthread__item
        span.k-cthread__av(style="--t: var(--chart-{c.tone})") {c.initials}
        div.k-cthread__body
          div.k-cthread__bubble
            strong {c.name}
            p {c.text}
          div.k-cthread__meta
            span {c.ago}
            button.k-cthread__like(type="button" aria-pressed={c.liked ? "true" : "false"} class:is-on={c.liked} @click=like(c.id))
              span.k-icon.k-icon-heart(class:k-icon-heart-fill={c.liked})
              | {c.likes}
  form.k-cthread__form(novalidate @submit.prevent=send)
    span.k-cthread__av.k-cthread__av--me {me}
    input.ui-input(type="text" aria-label="Add a comment" placeholder=placeholder autocomplete="off" value=draft @input=draft)
    button.ui-button.ui-button-default.ui-button-sm(type="submit" disabled={!canSend}) Post
