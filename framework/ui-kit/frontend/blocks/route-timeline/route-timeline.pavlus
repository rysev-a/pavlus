import Route from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A shipment on its way
    p.k-demo__note Shanghai to Hamburg by sea. The cargo reached Singapore two days late.
    div.k-preview.k-preview--block
      div.k-rtime-demo
        +Route#route(stops=stops)
  section.k-demo
    h2.k-demo__title A delivered route
    div.k-preview.k-preview--block
      div.k-rtime-demo
        +Route#done(stops=doneStops)
