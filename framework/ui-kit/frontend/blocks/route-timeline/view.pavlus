// The stops of a route as a vertical timeline, to embed. State = the props:
// `stops` (stopViews() from route.ts). Done stops are filled, the current one
// pulses, the next ones are hollow; a late stop shows how late.
ol.k-rtime
  for stop in stops key stop.id
    li(class="k-rtime__stop k-rtime__stop--{stop.state}")
      span.k-rtime__node {stop.icon}
      div.k-rtime__body
        p.k-rtime__kind {stop.kindText}
        h4.k-rtime__place {stop.place}
        p.k-rtime__dates
          span {stop.plannedText}
          span {stop.actualText}
          if stop.delayText
            span(class="ui-pill ui-pill-{stop.tone}") {stop.delayText}
        if stop.note
          p.k-rtime__note {stop.note}
