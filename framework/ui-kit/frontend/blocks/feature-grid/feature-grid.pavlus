import FeatureGrid from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Left aligned
    div.k-preview.k-preview--block
      +FeatureGrid#grid(items=items)
  section.k-demo
    h2.k-demo__title Centered
    div.k-preview.k-preview--block
      +FeatureGrid#centered(items=short align="center")
