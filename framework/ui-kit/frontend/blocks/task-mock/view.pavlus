// A working task list, to embed as a child: `+TaskMock#mock(...mock)` (state
// in task-mock.ts). Add a task, tick it, remove it, filter the list.
div.ui-card.k-tm
  div.ui-card-header.k-tm__head
    div
      h3.ui-card-title {title}
      p.ui-card-description {progress.done} of {progress.total} done
    span.ui-badge.ui-badge-secondary {left} left
  div.ui-card-content.k-tm__body
    div.ui-progress.ui-progress-sm(role="progressbar" aria-valuenow={progress.percent} aria-valuemin="0" aria-valuemax="100")
      div.ui-progress-indicator(style="width: {progress.percent}%")
    form.k-tm__form(novalidate @submit.prevent=add)
      div.ui-field(data-invalid={error ? "true" : null})
        input.ui-input(type="text" placeholder="Add a task, try #home" aria-label="New task" value=draft @input=setDraft)
      button.ui-button.ui-button-default(type="submit")
        span.k-icon.k-icon-plus
        | Add
    if error
      p.ui-field-error {error}
    div.ui-tabs-list.k-tm__tabs(role="tablist")
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={filter === "all" ? "true" : "false"} @click=setFilter("all")) All
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={filter === "open" ? "true" : "false"} @click=setFilter("open")) Open
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={filter === "done" ? "true" : "false"} @click=setFilter("done")) Done
    if shown.length > 0
      ul.k-tm__list
        for task in shown key task.id
          li.k-tm__item(class:k-tm__item--done={task.done})
            div.ui-checkbox
              input.ui-checkbox-input(id="tm-{task.id}" type="checkbox" checked={task.done} @change=toggle(task.id))
              label.ui-checkbox-label(for="tm-{task.id}") {task.title}
            if task.tag
              span.ui-badge.ui-badge-outline {task.tag}
            button.ui-button.ui-button-ghost.ui-button-icon-sm(type="button" aria-label="Remove {task.title}" @click=remove(task.id))
              span.k-icon.k-icon-x
    else
      p.k-tm__empty {filter === "done" ? "Nothing is done yet." : "All clear. Add the next thing."}
