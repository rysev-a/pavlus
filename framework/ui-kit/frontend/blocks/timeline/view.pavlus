// A vertical timeline, to embed. State = the props: `items`, a list of
// { key, period, title, org, text, points, tags } (see `withLists` in
// timeline.ts: org, text, points and tags must be there, possibly empty), and
// `heading` (an optional title above the list).
section.k-timeline
  if heading
    h3.k-timeline__heading {heading}
  ol.k-timeline__list
    for item in items key item.key
      li.k-timeline__item
        span.k-timeline__dot
        div.k-timeline__body
          p.k-timeline__period {item.period}
          h3.k-timeline__title {item.title}
          if item.org
            p.k-timeline__org {item.org}
          if item.text
            p.k-timeline__text {item.text}
          if item.points.length > 0
            ul.k-timeline__points
              for point in item.points key point
                li {point}
          if item.tags.length > 0
            div.k-timeline__tags
              for tag in item.tags key tag
                span.ui-badge.ui-badge-secondary {tag}
