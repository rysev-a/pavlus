import Timeline from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Work experience
    div.k-preview.k-preview--block
      +Timeline#work(items=work heading="Experience")
  section.k-demo
    h2.k-demo__title Product milestones
    p.k-demo__note Short entries: a date, a title and a line of text.
    div.k-preview.k-preview--block
      +Timeline#releases(items=releases)
