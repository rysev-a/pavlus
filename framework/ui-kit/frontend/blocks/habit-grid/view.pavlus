// The week grid of a habit tracker, to embed. State = the props: `days`
// (weekDays() from habits.ts) and `rows` (weekRows()). A click on a cell
// sends `<name>.toggle` with [habit id, ISO date] (future days are inert); a
// click on a habit's name sends `<name>.edit` with its id.
div.k-hgrid
  div.k-hgrid__head
    span.k-hgrid__corner Habit
    div.k-hgrid__days
      for day in days key day.iso
        span.k-hgrid__day(data-today={day.today ? "true" : null})
          small {day.name}
          strong {day.num}
    span.k-hgrid__streakhead Streak
  for row in rows key row.id
    div(class="k-hgrid__row k-adm-t-{row.tone}")
      button.k-hgrid__habit(type="button" aria-label="Edit {row.name}" @click=edit(row.id))
        span.k-hgrid__icon {row.icon}
        span.k-hgrid__text
          strong {row.name}
          small {row.freqText} · {row.weekText}
      div.k-hgrid__cells
        for cell in row.cells key cell.key
          button.k-hgrid__cell(type="button" data-state={cell.state} disabled={cell.state === "future"} aria-label={cell.label} aria-pressed={cell.state === "done" ? "true" : "false"} title={cell.label} @click=toggle(row.id, cell.iso))
            if cell.state === "done"
              span.k-icon.k-icon-check
      span.k-hgrid__streak(class:k-hgrid__streak--on={row.streak > 0}) {row.streakText}
  if rows.length === 0
    p.k-hgrid__empty No habits yet. Add the first one.
