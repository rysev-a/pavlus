// The dock doors by hours grid, to embed. State = the props: `hours`
// (hoursFrom) and `rows` (rowsOf: { id, name, kind, segs }). A seg is a free
// hour or a truck bar that spans some hours. Events, with the name of the embed
// in front: `book` (door id, hour index) on a free hour, `open` (appointment id).
div.k-dsched(style="--hours: {hours.length}")
  div.k-dsched__scroll
    div.k-dsched__table
      div.k-dsched__row.k-dsched__head
        div.k-dsched__door Door
        for hour in hours key hour.i
          div.k-dsched__hour(class:k-dsched__hour--now={hour.now}) {hour.label}
      for row in rows key row.id
        div.k-dsched__row
          div.k-dsched__door
            strong {row.name}
            small {row.kind}
          for seg in row.segs key seg.key
            if seg.kind === "free"
              button.k-dsched__free(type="button" aria-label="Book {row.name} at {seg.hour}" @click=book(row.id, seg.hour))
            else
              button(type="button" class="k-dsched__appt k-adm-t-{seg.tone}" style="grid-column: span {seg.span}" @click=open(seg.id))
                strong {seg.label}
                small {seg.sub}
