// The comments under a diary entry and a form to add one, to embed. State =
// the props: `heading`, `comments` (a list of cardOf() from comments.ts),
// `draft` (the text of the box), `error`. Events: `<name>.type` (the input),
// `<name>.send`.
section.k-jcom
  h3.k-jcom__heading {heading}
  if comments.length === 0
    p.k-jcom__empty Nobody has commented yet. Be the first.
  ul.k-jcom__list
    for c in comments key c.id
      li.k-jcom__item
        span.k-jcom__pic(style="--hue: {c.hue}") {c.initials}
        div.k-jcom__body
          p.k-jcom__head
            strong {c.author}
            span {c.when}
          p.k-jcom__text {c.text}
  form.k-jcom__form(@submit.prevent=send)
    div.ui-field(data-invalid={error ? "true" : null})
      label.ui-label(for="jcom-box") Add a comment
      textarea.ui-textarea-control#jcom-box(rows="3" placeholder="Say something kind..." value=draft @input=type)
      if error
        p.ui-field-error {error}
    div.k-jcom__actions
      button.ui-button.ui-button-default.ui-button-sm(type="submit") Post comment
