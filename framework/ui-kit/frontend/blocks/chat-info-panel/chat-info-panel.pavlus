import Info from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Group info
    p.k-demo__note Mute and archive are switches, pinned messages can be unpinned, members are listed with their role and presence.
    div.k-preview.k-preview--block
      div.k-cinfo-demo
        +Info#info(info=info)
      if note
        p.k-hint {note}
