// The header of a chat, to embed. State = the props: `header` (from
// `headerView` in chat-header.ts: title, subtitle, live, initials, hue,
// emoji, online, muted, pinned). Events, with the name of the embed in front:
// `infoPane` (open the info as a pane on small screens),
// `back` (small screens), `info`, `mute` and `jump` (the pinned message id).
div.k-chead
  div.k-chead__bar
    button.ui-button.ui-button-ghost.ui-button-sm.k-chead__back(type="button" aria-label="Back to chats" @click=back)
      span.k-icon.k-icon-chevron-left
    button.k-chead__who(type="button" aria-label="Chat info" @click=infoPane)
      if header.emoji
        span.k-mavatar.k-mavatar--emoji(style="--k-hue: {header.hue}") {header.emoji}
      else
        span.k-mavatar(style="--k-hue: {header.hue}" data-online={header.online ? "true" : null}) {header.initials}
      span.k-chead__text
        strong.k-chead__title {header.title}
        span.k-chead__sub(class:is-live={header.live}) {header.subtitle}
    div.k-chead__tools
      button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label={header.muted ? "Unmute" : "Mute"} aria-pressed={header.muted ? "true" : "false"} @click=mute)
        span.k-icon(class="{header.muteIcon}")
      button.ui-button.ui-button-ghost.ui-button-sm.k-chead__info-d(type="button" aria-label="Show or hide the info panel" @click=info)
        span.k-icon.k-icon-info
      button.ui-button.ui-button-ghost.ui-button-sm.k-chead__info-m(type="button" aria-label="Chat info" @click=infoPane)
        span.k-icon.k-icon-info
  if header.pinned
    button.k-chead__pinned(type="button" @click=jump(header.pinned.id))
      span.k-icon.k-mi-pin
      span.k-chead__pinned-text
        strong Pinned message
        span {header.pinned.text}
      if header.pinned.count > 1
        span.k-mbadge.k-mbadge--quiet {header.pinned.count}
