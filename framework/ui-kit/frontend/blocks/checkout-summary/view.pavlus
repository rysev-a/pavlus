// The confirmation after checkout, to embed. State = the props (see
// `confirmationOf` in checkout-summary.ts): title, text, orderNo, rows (name,
// note, amountLabel, and a download link when `hasDownload`), figures, ctaLabel.
// Message: done.
section.k-confirm
  div.k-confirm__head
    span.k-confirm__check
      span.k-icon.k-icon-check.k-icon-lg
    div.k-confirm__text
      h2.k-confirm__title {title}
      p {text}
      span.ui-badge.ui-badge-outline Order {orderNo}
  if rows.length > 0
    ul.k-confirm__rows
      for row in rows key row.id
        li.k-confirm__row
          span.k-confirm__art(style="--hue: {row.hue}") {row.emoji}
          div.k-confirm__info
            strong {row.name}
            if row.note
              span.k-confirm__note {row.note}
          span.k-confirm__amount {row.amountLabel}
          if row.hasDownload
            a.ui-button.ui-button-outline.ui-button-sm.k-confirm__download(href=row.href download=row.file) Download
  if figures.length > 0
    dl.k-confirm__figures
      for f in figures key f.label
        div.k-confirm__figure(class:is-total={f.strong})
          dt {f.label}
          dd {f.value}
  button.ui-button.ui-button-default(type="button" @click=done) {ctaLabel}
