import Entry from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A feed entry with an excerpt
    p.k-demo__note Click the title or "Read more" to open it, a tag to pick it, "Reading mode" for the quiet page.
    div.k-preview.k-preview--block
      +Entry#feed(entries=feed full=false)
      p.k-jentry-demo__out {said}
  section.k-demo
    h2.k-demo__title The whole entry
    div.k-preview.k-preview--block
      +Entry#whole(entries=whole full=true)
  section.k-demo
    h2.k-demo__title Reading mode
    div.k-preview.k-preview--block
      +Entry#reader(entries=whole full=true reader=true)
