// The checklist next to a terminal exercise, to embed. State = the props:
// `goals`, a list of { label, ok } (from `verify` in goals.ts). A goal turns
// green as soon as the file system satisfies it.
ul.k-tgoal
  for goal in goals key goal.label
    li(class="k-tgoal__item" class:is-ok={goal.ok})
      span.k-tgoal__mark
        if goal.ok
          span.k-icon.k-icon-check
      span.k-tgoal__label {goal.label}
