import Terminal from "./view.pavlus"
import Goals from "./goals.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A shell on a virtual file system
    p.k-demo__note Try ls, cd docs, cat notes.txt, mkdir, touch, rm, echo hi > file, and git init, git status, git add, git commit -m "message". The arrow keys walk through the history.
    div.k-preview.k-preview--block
      +Terminal#term(...term prompt=prompt inputId="tsim-demo-input" title="user@learn-box: a practice shell")
  section.k-demo
    h2.k-demo__title Goals checked on the result
    p.k-demo__note The task is verified from the resulting files, not from the typed commands: any way of getting there counts.
    div.k-preview.k-preview--block
      div.k-tsim-demo
        +Terminal#task(...task prompt=taskPrompt inputId="tsim-demo-task" title="Task: a folder docs with a file readme.md")
        div.k-tsim-demo__side
          +Goals#goals(goals=goals)
          button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=reset) Start again
