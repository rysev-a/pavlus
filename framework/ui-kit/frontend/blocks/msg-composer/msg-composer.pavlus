import Composer from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Message input
    p.k-demo__note Press Enter or the arrow to send. Attach picks files from a menu and shows them as chips; the reply banner can be closed.
    div.k-preview.k-preview--block
      div.k-mc-demo
        +Composer#mc(draft=draft placeholder="Write a message" replyTo=replyTo files=chips menu=menu menuOpen=menuOpen emojiOpen=emojiOpen canSend=canSend)
      if sent.length > 0
        ul.k-mc-log
          for line, i in sent key i
            li {line}
