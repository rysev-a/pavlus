// The input row of a chat, to embed. State = the props: `draft`, `placeholder`,
// `replyTo` ({ id, name, text } or null), `files` (chips: { id, name,
// sizeLabel }), `menu` (the attach menu: chips with `added`), `menuOpen`,
// `emojiOpen`, `canSend`. Events, with the name of the embed in front:
// `setDraft` (the input event), `key` (keydown: Enter sends), `send`,
// `emoji` (toggle the picker the parent shows), `attachMenu`, `attach` and
// `removeAttach` (a file id), `cancelReply`.
div.k-mc
  if replyTo
    div.k-mc__reply
      span.k-icon.k-mi-reply
      div.k-mc__reply-text
        strong Replying to {replyTo.name}
        span {replyTo.text}
      button.k-mc__x(type="button" aria-label="Cancel the reply" @click=cancelReply)
        span.k-icon.k-icon-x
  if files.length > 0
    ul.k-mc__files(aria-label="Attachments")
      for f in files key f.id
        li.k-mc__file
          span.k-icon.k-mi-clip
          span.k-mc__file-name {f.name}
          span.k-muted {f.sizeLabel}
          button.k-mc__x(type="button" aria-label={"Remove " + f.name} @click=removeAttach(f.id))
            span.k-icon.k-icon-x
  div.k-mc__row
    div.k-mc__attach
      button.k-mc__btn(type="button" aria-label="Attach a file" aria-expanded={menuOpen ? "true" : "false"} @click=attachMenu)
        span.k-icon.k-mi-clip
      if menuOpen
        ul.k-mc__menu(role="menu")
          for f in menu key f.id
            li
              button.k-mc__menu-item(type="button" role="menuitemcheckbox" aria-checked={f.added ? "true" : "false"} @click=attach(f.id))
                span.k-mc__file-name {f.name}
                span.k-muted {f.sizeLabel}
                if f.added
                  span.k-icon.k-icon-check
    input.k-mc__input#k-mc-input(type="text" autocomplete="off" aria-label="Message" placeholder=placeholder value=draft @input=setDraft @keydown=key)
    button.k-mc__btn(type="button" aria-label="Emoji" aria-pressed={emojiOpen ? "true" : "false"} @click=emoji)
      span.k-icon.k-mi-smile
    button.k-mc__send(type="button" aria-label="Send" disabled={!canSend} @click=send)
      span.k-icon.k-mi-send
