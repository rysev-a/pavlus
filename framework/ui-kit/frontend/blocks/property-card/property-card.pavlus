import Props from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Listings
    div.k-preview.k-preview--block
      +Props#list(properties=properties empty="No listing matches.")
    p.k-demo__note {message}
  section.k-demo
    h2.k-demo__title Empty
    div.k-preview.k-preview--block
      +Props#none(properties=none empty="No listing matches your search.")
