// A side sheet that shows a record and lets you edit it, to embed. State =
// the props: `open`, `title`, `description`, `details` ([{ label, value,
// tone }], read only), `fields` (field() from sheet.ts: text, number, date,
// select, textarea), `buttons` ([{ id, label, variant }]). Events, with the
// name of the embed in front: `close`, `field` (the field id; the value is in
// the event), `press` (the button id).
div.k-rsheet-host
  if open
    div.k-modal.k-modal--sheet
      div.k-modal__scrim(@click=close)
      div.ui-sheet.k-rsheet(role="dialog" aria-modal="true" aria-label={title})
        div.ui-dialog-header
          h2.ui-dialog-title {title}
          if description
            p.ui-dialog-description {description}
        if details.length > 0
          dl.k-rsheet__details
            for row in details key row.label
              div
                dt {row.label}
                dd
                  if row.tone
                    span(class="ui-pill ui-pill-{row.tone}") {row.value}
                  else
                    | {row.value}
        if fields.length > 0
          div.ui-form.k-rsheet__form
            for item in fields key item.id
              div.ui-field(data-invalid={item.error ? "true" : null})
                label.ui-label(for={"rs-" + item.id}) {item.label}
                if item.kind === "select"
                  select.ui-select-control(id={"rs-" + item.id} @change=field(item.id))
                    for option in item.options key option.value
                      option(value=option.value selected={option.selected}) {option.label}
                else if item.kind === "textarea"
                  textarea.ui-textarea-control(id={"rs-" + item.id} rows="3" placeholder=item.placeholder value=item.value @input=field(item.id))
                else
                  input.ui-input(id={"rs-" + item.id} type=item.kind placeholder=item.placeholder value=item.value @input=field(item.id))
                if item.error
                  p.ui-field-error {item.error}
                else if item.hint
                  p.ui-field-description {item.hint}
        div.ui-dialog-footer.k-rsheet__foot
          button.ui-button.ui-button-outline(type="button" @click=close) Close
          for b in buttons key b.id
            button(type="button" class="ui-button ui-button-{b.variant}" @click=press(b.id)) {b.label}
