// A ranking, to embed. State = the props: `rows` (rankRows(): { id, rank,
// name, initials, value, sub, pct, goal, tone }) and `empty`. Events, with
// the name of the embed in front: `pick` (row id).
ol.k-lboard
  for row in rows key row.id
    li(class="k-lboard__row k-adm-t-{row.tone}" class:k-lboard__row--first={row.rank === 1} @click=pick(row.id))
      span.k-lboard__rank {row.rank}
      span.ui-avatar
        span.ui-avatar-fallback {row.initials}
      div.k-lboard__main
        div.k-lboard__line
          strong {row.name}
          span.k-lboard__value {row.value}
        div.ui-progress.ui-progress-sm.k-lboard__bar
          div.ui-progress-indicator(style="width: {row.pct}%")
        div.k-lboard__line.k-lboard__meta
          small {row.sub}
          small {row.goal}
  if rows.length === 0
    li.k-lboard__empty {empty}
