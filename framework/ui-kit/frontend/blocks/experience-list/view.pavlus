// A work history, to embed: `+Jobs#jobs(...jobs)`. State = title, items ({ id, role,
// company, companyId, emoji (the logo), tone (1-5), period, place, text, current }).
// A click on the company sends `company(companyId)` (`<name>.company`).
section.ui-card.k-expl
  h3.k-expl__title {title}
  ol.k-expl__list
    for j in items key j.id
      li.k-expl__item
        span.k-expl__logo(style="--t: var(--chart-{j.tone})") {j.emoji}
        div.k-expl__body
          strong.k-expl__role {j.role}
          button.k-expl__company(type="button" @click=company(j.companyId)) {j.company}
          span.k-expl__when
            | {j.period} · {j.place}
            if j.current
              span.ui-badge.ui-badge-secondary Current
          p.k-expl__text {j.text}
