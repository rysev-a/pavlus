// The reading pane of a mail client, to embed. State = the props: `thread`
// (from `threadView` in thread.ts; null shows the empty pane) and `actions`
// (the toolbar: [{ id, name, icon }]). Events, with the name of the embed in
// front: `back` (small screens), `act` (the action id), `toggle` (a message
// id: expand or collapse), `reply`, `replyAll` and `forward` (a message id).
div.k-mread
  if thread
    div.k-mread__bar
      button.ui-button.ui-button-ghost.ui-button-sm.k-mread__back(type="button" aria-label="Back to the list" @click=back)
        span.k-icon.k-icon-chevron-left
        | Back
      div.k-mread__tools
        for a in actions key a.id
          button.ui-button.ui-button-ghost.ui-button-sm(type="button" title={a.name} aria-label={a.name} @click=act(a.id))
            span.k-icon(class="{a.icon}")
    div.k-mread__scroll
      header.k-mread__head
        h2.k-mread__subject {thread.subject}
        div.k-mread__meta
          for l in thread.labels key l
            span.ui-badge.ui-badge-secondary {l}
          if thread.count > 1
            span.k-muted {thread.count} messages
      for m in thread.messages key m.id
        article.k-mread__msg(class:is-open={m.expanded} class:is-unread={m.unread})
          button.k-mread__who(type="button" aria-expanded={m.expanded ? "true" : "false"} @click=toggle(m.id))
            span.k-mavatar.k-mavatar--sm(style="--k-hue: {m.hue}") {m.initials}
            span.k-mread__names
              span.k-mread__from
                strong {m.from}
                if m.expanded
                  span.k-muted ({m.email})
              if m.expanded
                span.k-mread__to {m.recipients}
              else
                span.k-mread__snippet {m.snippet}
            span.k-mread__date {m.expanded ? m.date : m.short}
          if m.expanded
            div.k-mread__body
              for p, i in m.paragraphs key i
                if p.quote
                  blockquote.k-mread__quote {p.text}
                else
                  p {p.text}
            if m.attachments.length > 0
              ul.k-mread__files
                for a in m.attachments key a.id
                  li.k-mread__file
                    span.k-icon.k-mi-clip
                    span.k-mread__file-name {a.name}
                    span.k-muted {a.sizeLabel}
            div.k-mread__reply
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=reply(m.id))
                span.k-icon.k-mi-reply
                | Reply
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=replyAll(m.id))
                span.k-icon.k-mi-reply-all
                | Reply all
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=forward(m.id))
                span.k-icon.k-mi-forward
                | Forward
  else
    div.k-mread__empty
      span.k-icon.k-icon-lg.k-mi-mail-open
      strong Select a conversation
      p Nothing is open. Pick a message from the list to read it here.
