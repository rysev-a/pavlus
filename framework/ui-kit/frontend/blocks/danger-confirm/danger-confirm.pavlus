import Dialog from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Ask before deleting
    p.k-demo__note The first button needs the name typed back, the second one only a click.
    div.k-preview
      button.ui-button.ui-button-destructive(type="button" @click=askDelete) Delete machine
      button.ui-button.ui-button-outline(type="button" @click=askRestore) Restore snapshot
      +Dialog#dialog(...dialog)
    p.k-demo__note {last}
