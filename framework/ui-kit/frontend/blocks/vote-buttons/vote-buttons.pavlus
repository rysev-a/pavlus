import Vote from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Column and row
    p.k-demo__note The score includes your own vote. Click an arrow twice to take the vote back.
    div.k-preview
      +Vote#a(id="a" score=a.score vote=a.vote)
      +Vote#b(id="b" score=b.score vote=b.vote row=true)
    p.k-hint
      | Votes:
      |
      span.k-state {summary}
