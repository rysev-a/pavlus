// A popover to pick contacts for an address field, to embed. State = the
// props: `open`, `field` (the label: To, Cc), `query` and `rows` (from
// `contactRows` in contact-pop.ts). Events, with the name of the embed in
// front: `setQuery` (the input event), `pick` (an address) and `close`.
div.k-cpop-host
  if open
    div.k-cpop(role="dialog" aria-label={"Choose " + field + " contacts"})
      div.k-cpop__head
        strong Contacts for {field}
        button.k-cpop__x(type="button" aria-label="Close contacts" @click=close)
          span.k-icon.k-icon-x
      div.k-input-group.k-cpop__search
        span.k-input-group__addon.k-input-group__addon--start
          span.k-icon.k-icon-search
        input.ui-input(type="search" placeholder="Find a contact" aria-label="Find a contact" autocomplete="off" value=query @input=setQuery)
      if rows.length === 0
        p.k-cpop__empty Nobody matches "{query}".
      else
        ul.k-cpop__list
          for c in rows key c.email
            li
              button.k-cpop__item(type="button" class:is-added={c.added} @click=pick(c.email))
                span.k-mavatar.k-mavatar--sm(style="--k-hue: {c.hue}") {c.initials}
                span.k-cpop__text
                  strong {c.name}
                  span.k-muted {c.email}
                if c.added
                  span.k-icon.k-icon-check
                else
                  span.k-icon.k-icon-plus
