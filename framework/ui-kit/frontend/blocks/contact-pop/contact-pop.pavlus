import Pop from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Contacts popover
    p.k-demo__note Filter by name or address, click to add a contact to the field (a second click does nothing).
    div.k-preview.k-preview--block
      div.k-cpop-demo
        div.k-row
          button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=show) Choose contacts
          code.k-code {text || "(empty)"}
        +Pop#pop(open=open field=field query=query rows=rows)
