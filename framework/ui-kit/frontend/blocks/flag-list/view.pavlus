// A list of feature flags, to embed. State = the props: `rows` (flagRows()
// from flags.ts). Events, with the name of the embed in front: `toggle` (flag
// id) and `rollout` (flag id; the chosen percentage is in the event).
ul.k-flags
  for row in rows key row.id
    li.k-flags__row(class:k-flags__row--off={!row.on})
      div.ui-switch.ui-switch-with-description.k-flags__switch
        input.ui-switch-input(id="flag-{row.id}" type="checkbox" role="switch" checked={row.on} @change=toggle(row.id))
        div.ui-switch-text
          label.ui-switch-label(for="flag-{row.id}") {row.name}
          p.ui-switch-description {row.desc}
      div.k-flags__meta
        code.k-flags__key {row.key}
        span(class="ui-pill ui-pill-{row.envTone}") {row.env}
        span.k-flags__owner {row.owner}
      div.k-flags__rollout
        div.k-flags__rollhead
          span.k-flags__state {row.state}
          select.ui-select-control.k-flags__select(aria-label="Rollout of {row.name}" disabled={!row.on} @change=rollout(row.id))
            for option in row.options key option.value
              option(value=option.value selected={option.selected}) {option.label}
        div.ui-progress.ui-progress-sm.k-flags__bar
          div.ui-progress-indicator(style="width: {row.rolloutPct}%")
