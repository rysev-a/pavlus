// A funnel, to embed. State = the props from funnel() in funnel.ts:
// `stages` ([{ id, label, count, width, kept, lost, step }]), `overall`
// (the share that reached the end) and `summary`.
div.k-funnel
  ol.k-funnel__list
    for stage in stages key stage.id
      li.k-funnel__row
        span.k-funnel__label {stage.label}
        div.k-funnel__track
          span.k-funnel__bar(data-step={stage.step} style="width: {stage.width}%")
            strong {stage.count}
        span.k-funnel__kept
          if stage.kept
            | {stage.kept}
            small kept
          else
            small start
  p.k-funnel__foot
    strong {overall}
    | overall: {summary}
