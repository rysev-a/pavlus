// The form to add or edit a habit, to embed. State = the props: `draft`
// ({ name, tone, icon, freq }), `errors` ({ name }), `tones`, `icons`,
// `freqs` (toneChoices(), iconChoices(), freqChoices() from form.ts: each
// { id, label, active }) and `editing` (true: an existing habit). Events:
// `<name>.name` (input), `<name>.tone`, `<name>.icon`, `<name>.freq` (ids),
// `<name>.save`, `<name>.cancel`, `<name>.remove`.
form.k-hform(@submit.prevent=save)
  div(class="k-hform__preview k-adm-t-{draft.tone}")
    span.k-hform__previewicon {draft.icon}
    div
      strong {draft.name || "Your new habit"}
      small Preview
  div.ui-field(data-invalid={errors.name ? "true" : null})
    label.ui-label(for="hform-name") Name
    input.ui-input#hform-name(type="text" placeholder="Drink two litres of water" value=draft.name @input=name)
    if errors.name
      p.ui-field-error {errors.name}
  fieldset.k-hform__group
    legend.ui-label Colour
    div.k-hform__swatches(role="radiogroup" aria-label="Colour")
      for t in tones key t.id
        button(type="button" role="radio" aria-label={t.label} aria-checked={t.active ? "true" : "false"} title={t.label} data-active={t.active ? "true" : null} class="k-hform__swatch k-adm-t-{t.id}" @click=tone(t.id))
  fieldset.k-hform__group
    legend.ui-label Icon
    div.k-hform__icons(role="radiogroup" aria-label="Icon")
      for i in icons key i.id
        button.k-hform__icon(type="button" role="radio" aria-checked={i.active ? "true" : "false"} data-active={i.active ? "true" : null} @click=icon(i.id)) {i.label}
  fieldset.k-hform__group
    legend.ui-label How often
    div.k-hform__freqs(role="radiogroup" aria-label="Frequency")
      for f in freqs key f.id
        button.k-hform__freq(type="button" role="radio" aria-checked={f.active ? "true" : "false"} data-active={f.active ? "true" : null} @click=freq(f.id)) {f.label}
  div.k-hform__actions
    if editing
      button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=remove) Delete
    button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=cancel) Cancel
    button.ui-button.ui-button-default.ui-button-sm(type="submit")
      if editing
        | Save habit
      else
        | Add habit
