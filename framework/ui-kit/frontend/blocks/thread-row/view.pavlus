// A thread in a list, to embed: `+Row#row(...thread)`. State = id, title, name
// (author), category, emoji (of the category), score, replies, views, ago,
// pinned, locked, solved, hidden. A click on the title sends `open(id)`
// (`<name>.open` in a parent).
article.k-trow(class:is-pinned={pinned} class:is-hidden={hidden})
  div.k-trow__score
    strong {score}
    span votes
  div.k-trow__main
    div.k-trow__flags
      if pinned
        span.ui-badge.ui-badge-default Pinned
      if solved
        span.ui-badge.ui-badge-secondary
          span.k-icon.k-icon-check
          | Solved
      if locked
        span.ui-badge.ui-badge-outline Locked
      if hidden
        span.ui-badge.ui-badge-outline Hidden
    button.k-trow__title(type="button" @click=open(id)) {title}
    p.k-trow__meta {emoji} {category} · {name} · {ago}
  div.k-trow__stats
    span {replies} replies
    span {views} views
