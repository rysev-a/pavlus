// A grid of shaded cells, to embed. State = the props: `columns` ([{ id,
// label }]), `rows` (heatRow() from heat.ts), optional `corner` (the text above
// the row labels) and `steps` (heatSteps(); the legend shows when given).
// Event, with the name of the embed in front: `pick` (row id, cell id).
div.k-htab(style="--cols: {columns.length}")
  div.k-htab__scroll
    div.k-htab__grid
      div.k-htab__row.k-htab__head
        div.k-htab__label {corner}
        for col in columns key col.id
          div.k-htab__colhead {col.label}
      for row in rows key row.id
        div.k-htab__row
          div.k-htab__label
            strong {row.label}
            if row.sub
              small {row.sub}
          for cell in row.cells key cell.id
            button.k-htab__cell(type="button" data-level="{cell.level}" title=cell.tip aria-label=cell.tip @click=pick(row.id, cell.id))
              span.k-htab__text {cell.text}
  if steps
    div.k-htab__legend
      span Low
      for step in steps key step
        span.k-htab__swatch(data-level="{step}")
      span High
