import Heat from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Cohort retention
    div.k-preview.k-preview--block
      +Heat#cohort(corner="Signup month" columns=cohortCols rows=cohortRows steps=steps)
    p.k-demo__note {message}
  section.k-demo
    h2.k-demo__title Visits by hour and weekday
    div.k-preview.k-preview--block
      +Heat#visits(corner="Day" columns=hourCols rows=visitRows steps=steps)
