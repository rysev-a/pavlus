// The "create a virtual machine" wizard, to embed. State = the props (from
// `wizardProps` in wizard.ts): steps, stepId, name, nameError, regions,
// images, sizes, sizeError, keys, keysError, ipv4, backups, vpcs, firewalls,
// hourlyText, monthlyText, lines, summary, canBack, isLast, nextLabel.
// Events, with the name of the embed in front: `act` (kind, id: a click on a
// region, image, size, key, ipv4, backups or a step), `field` (the field
// name; the text is in the event), `next`, `back`, `cancel`.
div.k-vmw
  ol.k-vmw__steps
    for s in steps key s.id
      li
        button.k-vmw__step(type="button" data-state={s.state} disabled={!s.reachable} aria-current={s.state === "current" ? "step" : null} @click=act("goto", s.n - 1))
          span.k-vmw__n {s.n}
          span.k-vmw__steplabel {s.label}
  div.k-vmw__body
    if stepId === "basics"
      div.ui-field(data-invalid={nameError ? "true" : null})
        label.ui-label(for="vmw-name") Machine name
        input.ui-input(id="vmw-name" type="text" value=name placeholder="web-frontend-01" autocomplete="off" @input=field("name"))
        if nameError
          p.ui-field-error {nameError}
        else
          p.ui-field-description Lowercase letters, digits and hyphens. It becomes the hostname.
      div.ui-field
        span.ui-label Region
        div.k-vmw__grid
          for region in regions key region.id
            button.k-vmw__card(type="button" aria-pressed={region.selected ? "true" : "false"} class:is-selected={region.selected} @click=act("region", region.id))
              span.k-vmw__big {region.flag}
              span.k-vmw__cardtext
                strong {region.label}
                small {region.note}
    else if stepId === "image"
      div.ui-field
        span.ui-label Operating system
        div.k-vmw__grid
          for image in images key image.id
            button.k-vmw__card(type="button" aria-pressed={image.selected ? "true" : "false"} class:is-selected={image.selected} @click=act("image", image.id))
              span.k-vmw__big {image.emoji}
              span.k-vmw__cardtext
                strong {image.label}
                small {image.note}
    else if stepId === "size"
      div.ui-field(data-invalid={sizeError ? "true" : null})
        span.ui-label Size
        div.k-vmw__sizes
          for size in sizes key size.id
            button.k-vmw__size(type="button" aria-pressed={size.selected ? "true" : "false"} class:is-selected={size.selected} class:is-small={size.tooSmall} @click=act("size", size.id))
              span.k-vmw__radio
              span.k-vmw__cardtext
                strong {size.label}
                small {size.spec}
              span.k-vmw__sizeprice
                strong {size.monthly}
                small {size.price}
        if sizeError
          p.ui-field-error {sizeError}
    else if stepId === "access"
      div.ui-field(data-invalid={keysError ? "true" : null})
        span.ui-label SSH keys
        div.k-vmw__sizes
          for sk in keys key sk.id
            button.k-vmw__size(type="button" role="checkbox" aria-checked={sk.selected ? "true" : "false"} class:is-selected={sk.selected} @click=act("key", sk.id))
              span.k-vmw__check
                if sk.selected
                  span.k-icon.k-icon-check
              span.k-vmw__cardtext
                strong {sk.name}
                small {sk.fingerprint}
        if keysError
          p.ui-field-error {keysError}
      div.k-vmw__toggles
        button.k-vmw__size(type="button" role="switch" aria-checked={ipv4 ? "true" : "false"} class:is-selected={ipv4} @click=act("ipv4", ""))
          span.k-vmw__check
            if ipv4
              span.k-icon.k-icon-check
          span.k-vmw__cardtext
            strong Public IPv4 address
            small Reachable from the internet. $0.005/hr.
        button.k-vmw__size(type="button" role="switch" aria-checked={backups ? "true" : "false"} class:is-selected={backups} @click=act("backups", ""))
          span.k-vmw__check
            if backups
              span.k-icon.k-icon-check
          span.k-vmw__cardtext
            strong Weekly backups
            small Adds 20% to the compute price.
      div.k-vmw__selects
        div.ui-field
          label.ui-label(for="vmw-vpc") Private network
          select.ui-select-control(id="vmw-vpc" @change=field("vpc"))
            for vpc in vpcs key vpc.value
              option(value=vpc.value selected={vpc.selected}) {vpc.label}
        div.ui-field
          label.ui-label(for="vmw-fw") Firewall
          select.ui-select-control(id="vmw-fw" @change=field("firewall"))
            for fw in firewalls key fw.value
              option(value=fw.value selected={fw.selected}) {fw.label}
    else
      dl.k-vmw__summary
        for row in summary key row.label
          div
            dt {row.label}
            dd {row.value}
  div.k-vmw__price
    div.k-vmw__total
      small Estimated cost
      strong {monthlyText}
      small {hourlyText} while it runs
    ul.k-vmw__lines
      for line in lines key line.label
        li
          span {line.label}
          span {line.value}
  div.k-vmw__nav
    button.ui-button.ui-button-ghost(type="button" @click=cancel) Cancel
    div.k-vmw__navmain
      if canBack
        button.ui-button.ui-button-outline(type="button" @click=back) Back
      button.ui-button.ui-button-default(type="button" @click=next) {nextLabel}
