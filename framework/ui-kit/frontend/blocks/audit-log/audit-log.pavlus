import Log from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Account activity
    div.k-preview.k-preview--block
      +Log#log(groups=groups empty="Nothing happened yet.")
    p.k-demo__note {message}
  section.k-demo
    h2.k-demo__title Empty
    div.k-preview.k-preview--block
      +Log#none(groups=none empty="Nothing matches that search.")
