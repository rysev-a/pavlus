import Fav from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Heart toggles
    p.k-demo__note The state is only a list of ids; the heart fills when its id is in it.
    div.k-preview
      +Fav#icon(id="a" active=a)
      +Fav#named(id="b" active=b label={b ? "Saved" : "Save"})
      +Fav#big(id="c" active=c size="lg" label="Add to favorites")
    p.k-hint
      | Favorites:
      |
      span.k-state {summary}
