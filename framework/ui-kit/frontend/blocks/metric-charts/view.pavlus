// Small box charts for a machine's metrics, to embed. State = the props:
// `charts` (from `chartsFor` in metrics.ts: { id, title, current, detail,
// tone, bars: [{ id, h, tip, last, hot }], axis }), `ranges` ([{ id, label }])
// and `range` (the id of the one shown). Sends `pick(id)`.
div.k-mch
  div.k-mch__top
    span.k-mch__label Last
    div.k-mch__ranges(role="group" aria-label="Time range")
      for item in ranges key item.id
        button.k-mch__range(type="button" aria-pressed={item.id === range ? "true" : "false"} class:is-on={item.id === range} @click=pick(item.id)) {item.label}
  div.k-mch__grid
    for chart in charts key chart.id
      section(class="k-mch__card k-adm-t-{chart.tone}")
        header.k-mch__head
          h4.k-mch__title {chart.title}
          strong.k-mch__now {chart.current}
        div.k-mch__plot
          for bar in chart.bars key bar.id
            span.k-mch__col(title={bar.tip})
              span.k-mch__fill(style="height: {bar.h}%" class:is-last={bar.last} class:is-hot={bar.hot})
        div.k-mch__axis
          span {chart.axis.start}
          span {chart.axis.mid}
          span {chart.axis.end}
        small.k-mch__detail {chart.detail}
