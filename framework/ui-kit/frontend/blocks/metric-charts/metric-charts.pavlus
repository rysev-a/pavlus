import Charts from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A running machine
    p.k-demo__note The curves come from a seed, so a range always draws the same chart. Red bars are above 85% of the scale.
    div.k-preview.k-preview--block
      +Charts#charts(charts=charts ranges=ranges range=range)
  section.k-demo
    h2.k-demo__title A stopped machine
    div.k-preview.k-preview--block
      +Charts#off(charts=offline ranges=ranges range=range)
