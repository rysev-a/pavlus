// Contact cards, to embed. State = the props: `contacts` (contactViews(): { id,
// name, initials, role, company, email, phone, status, tone, tags, last,
// selected }), `empty` (the text when the list is empty) and `single` (true
// for one wide card with no grid). Events, with the name of the embed in
// front: `pick` (contact id).
div.k-ccard(class:k-ccard--single={single})
  for c in contacts key c.id
    article.k-ccard__card(class:k-ccard__card--sel={c.selected} @click=pick(c.id))
      header.k-ccard__top
        span.ui-avatar
          span.ui-avatar-fallback {c.initials}
        div.k-ccard__who
          strong {c.name}
          small {c.role}, {c.company}
        span(class="ui-pill ui-pill-{c.tone}") {c.status}
      if c.tags.length > 0
        div.k-ccard__tags
          for tag in c.tags key tag
            span.ui-badge.ui-badge-secondary {tag}
      dl.k-ccard__lines
        div
          dt
            span.k-icon.k-icon-mail
          dd {c.email}
        div
          dt
            span.k-icon.k-rs-icon-phone
          dd {c.phone}
      small.k-ccard__last {c.last}
  if contacts.length === 0
    p.k-ccard__empty {empty}
