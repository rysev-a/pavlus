import BarChart from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Sales per day
    div.k-preview.k-preview--block
      +BarChart#sales(columns=sales)
  section.k-demo
    h2.k-demo__title Load, with values and tones
    div.k-preview.k-preview--block
      +BarChart#load(columns=load height="140px")
