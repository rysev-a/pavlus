// A bar chart made of boxes, to embed. State = the props: `columns`, a list of
// { id, label, value (text above the bar), tip, h (percent), tone }; build them
// with `columns()` from chart.ts. Optional `height` (a CSS length).
div.k-bchart(style="height: {height ?? '180px'}")
  for col in columns key col.id
    div.k-bchart__col(title=col.tip)
      span.k-bchart__value {col.value}
      div.k-bchart__track
        span(class="k-bchart__bar k-adm-t-{col.tone}" style="height: {col.h}%")
      span.k-bchart__label {col.label}
