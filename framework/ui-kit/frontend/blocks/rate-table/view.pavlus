// A comparison of carrier offers for one lane, to embed. State = the props:
// `columns` (rateColumns() from rates.ts) and `rows` (rateRows()). The
// cheapest, fastest, most reliable and best value offers wear a badge.
// Events: `<name>.sort` (the column key), `<name>.pick` (the offer id, a
// click on a row), `<name>.book` (the offer id).
div.ui-data-table.k-rtable
  div.ui-data-scroll
    table
      thead
        tr
          for col in columns key col.key
            th(style="text-align: {col.align}")
              button.ui-resource-sort(type="button" @click=sort(col.key)) {col.label}
                span.k-icon.k-icon-chevrons-up-down(class:ui-sort-idle={!col.sorted})
          th.k-rtable__actionhead
      tbody
        for row in rows key row.id
          tr.k-rtable__row(data-selected={row.selected ? "true" : null} @click=pick(row.id))
            td
              div.k-rtable__carrier
                span.k-rtable__mode(title={row.mode}) {row.modeIcon}
                div.k-rtable__name
                  strong {row.carrier}
                  small {row.note}
                  if row.badges.length > 0
                    span.k-rtable__badges
                      for badge in row.badges key badge
                        span.ui-badge.ui-badge-secondary {badge}
            td.k-rtable__num
              strong {row.priceText}
              if row.extraText
                small {row.extraText}
            td.k-rtable__num {row.daysText}
            td
              div.k-rtable__rel
                div(class="ui-progress ui-progress-sm k-rtable__bar k-adm-t-{row.tone}")
                  div.ui-progress-indicator(style="width: {row.reliability}%")
                span {row.reliabilityText}
            td.k-rtable__act
              button.ui-button.ui-button-xs(type="button" class:ui-button-default={row.selected} class:ui-button-outline={!row.selected} @click.stop=book(row.id)) Book
        if rows.length === 0
          tr
            td.ui-resource-empty(colspan="5") No offers for this lane.
