// The contacts of a group or person, to embed: `+Contacts#contacts(...contacts)`. State = title,
// empty, contacts ({ id, name, avatarStyle, avatarText, role, canMessage }). Events (with the name
// of the embed in front): open(id), message(id).
div.ui-card.k-cts
  h3.k-cts__title {title}
  if contacts.length === 0
    p.k-cts__empty {empty}
  ul.k-cts__list
    for c in contacts key c.id
      li.k-cts__row
        button.k-cts__av(type="button" aria-label="Open the wall of {c.name}" style={c.avatarStyle} @click=open(c.id)) {c.avatarText}
        div.k-cts__who
          button.k-cts__name(type="button" @click=open(c.id)) {c.name}
          span {c.role}
        if c.canMessage
          button.ui-button.ui-button-outline.ui-button-xs(type="button" @click=message(c.id)) Message
