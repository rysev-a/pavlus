// A queue in lanes, to embed. State = the props: `lanes` (lanesOf() from
// queue.ts). Events, with the name of the embed in front: `act` (ticket id,
// "next" or "back").
div.k-queue
  for lane in lanes key lane.id
    section(class="k-queue__lane k-adm-t-{lane.tone}")
      header.k-queue__head
        h3.k-queue__title {lane.label}
        span.k-queue__count {lane.count}
      ul.k-queue__list
        for item in lane.items key item.id
          li(class="k-queue__card k-adm-t-{item.tone}" class:k-queue__card--urgent={item.urgent})
            span.k-queue__ticket {item.ticket}
            div.k-queue__body
              strong {item.name}
              small {item.reason}
              div.k-queue__meta
                span {item.doctor}
                span.k-queue__wait {item.wait}
            div.k-queue__side
              if item.urgent
                span.ui-pill.ui-pill-destructive Urgent
              else
                span(class="ui-pill ui-pill-{item.tone}") {item.status}
              div.k-queue__actions
                for a in item.actions key a.id
                  button(type="button" class="ui-button ui-button-xs ui-button-{a.variant}" @click=act(item.id, a.id)) {a.label}
        if lane.items.length === 0
          li.k-queue__none {lane.empty}
