// A list of categories with a form to add one, to embed. State = the props
// from categoryView() in cats.ts: `rows` ([{ id, name, tone, used, removable,
// error }]), `draft` ({ name, tone, error }) and `tones` ([{ tone, on }]).
// Events, with the name of the embed in front: `setname` (the new name),
// `settone` (a tone), `add`, `rename` (id; the name is in the event),
// `recolor` (id), `remove` (id).
div.ui-card.k-catman
  form.k-catman__form(novalidate @submit.prevent=add)
    div.ui-field(data-invalid={draft.error ? "true" : null})
      label.ui-label(for="catman-name") New category
      div.k-catman__newrow
        input.ui-input#catman-name(type="text" placeholder="Reading, Music, Commute..." value=draft.name @input=setname)
        button.ui-button.ui-button-default(type="submit")
          span.k-icon.k-icon-plus
          | Add
      if draft.error
        p.ui-field-error {draft.error}
    div.k-catman__tones(role="group" aria-label="Colour of the new category")
      for t in tones key t.tone
        button(type="button" class="k-catman__swatch k-wcal-c-{t.tone}" class:is-on={t.on} aria-pressed={t.on ? "true" : "false"} aria-label={"Colour " + t.tone} @click=settone(t.tone))
  ul.k-catman__list
    for row in rows key row.id
      li(class="k-catman__row k-wcal-c-{row.tone}")
        button.k-catman__swatch.is-on(type="button" aria-label={"Change the colour of " + row.name} @click=recolor(row.id))
        div.k-catman__name
          input.ui-input(type="text" aria-label={"Name of " + row.name} value=row.name @input=rename(row.id))
          if row.error
            small.k-catman__err {row.error}
        span.k-catman__used {row.used}
        button.ui-button.ui-button-ghost.ui-button-icon-xs(type="button" aria-label={"Remove " + row.name} title={row.removable ? "Remove" : "Still has time logged"} disabled={!row.removable} @click=remove(row.id))
          span.k-icon.k-ai-trash
