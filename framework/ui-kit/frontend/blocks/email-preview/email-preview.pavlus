import Mail from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Newsletter
    div.k-preview.k-preview--block
      div.k-emailp__demo
        +Mail#news(mail=news)
  section.k-demo
    h2.k-demo__title Promo
    div.k-preview.k-preview--block
      div.k-emailp__demo
        +Mail#promo(mail=promo)
  section.k-demo
    h2.k-demo__title Announcement
    div.k-preview.k-preview--block
      div.k-emailp__demo
        +Mail#note(mail=note)
