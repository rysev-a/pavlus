// Address, contacts and opening hours, to embed. State = the props (see
// `placeOf` in place-card.ts): name, kicker, lines, phone, email, note, hours
// ({ day, text, today, closed }), status ({ open, text }).
section.k-place
  div.k-place__head
    span.k-place__kicker {kicker}
    h3.k-place__name {name}
    span.k-place__status(class:is-open={status.open})
      span.k-place__dot
      | {status.text}
  div.k-place__cols
    address.k-place__address
      for line in lines key line
        span {line}
      a(href="tel:{phone}") {phone}
      a(href="mailto:{email}") {email}
    ul.k-place__hours
      for row in hours key row.day
        li.k-place__hours-row(class:is-today={row.today} class:is-closed={row.closed})
          span {row.day}
          span {row.text}
  if note
    p.k-place__note {note}
