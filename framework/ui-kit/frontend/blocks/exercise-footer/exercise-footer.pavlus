import Footer from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Check, hint, continue
    p.k-demo__note Pick a state to see the footer. The footer is the same under every kind of exercise.
    div.k-preview.k-preview--column
      div.k-row
        for item in states key item.id
          button.ui-button.ui-button-sm(type="button" class:ui-button-default={item.id === current} class:ui-button-outline={item.id !== current} @click=pick(item.id)) {item.label}
      +Footer#footer(...footer)
