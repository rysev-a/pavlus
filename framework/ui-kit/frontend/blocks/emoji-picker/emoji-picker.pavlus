import Picker from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Picker with tabs, search and recent emoji
    p.k-demo__note Search by name ("fire", "party"), switch the tab, click an emoji: it joins the text and moves to Recent.
    div.k-preview
      +Picker#ep(tabs=tabs emojis=emojis title=title recent=recent query=query)
      div.k-ep-out
        p.k-hint Your message
        p.k-ep-text {text || "Nothing yet"}
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=clear) Clear
