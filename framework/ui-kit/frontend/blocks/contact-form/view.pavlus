// A contact form with validation and a success state. A part with its own
// state (contact-form.ts): embed it as a child, `+Contact#contact(...contact)`.
div.ui-card.k-contact
  div.ui-card-header
    h3.ui-card-title {title}
    p.ui-card-description {intro}
  if sent
    div.ui-card-content.k-contact__done
      span.k-contact__check
        span.k-icon.k-icon-lg.k-icon-check
      h4.k-contact__thanks Message sent
      p.k-contact__text Thank you, {name}. We will write to {email} within one business day.
      button.ui-button.ui-button-outline(type="button" @click=again) Send another message
  else
    form.ui-card-content(novalidate @submit.prevent=submit)
      div.ui-form
        div.k-contact__row
          div.ui-field(data-invalid={errors.name ? "true" : null})
            label.ui-label(for="cf-name") Your name
            input.ui-input#cf-name(type="text" placeholder="Ann Lee" value=name @input=setField("name"))
            if errors.name
              p.ui-field-error {errors.name}
          div.ui-field(data-invalid={errors.email ? "true" : null})
            label.ui-label(for="cf-email") Email
            input.ui-input#cf-email(type="email" placeholder="ann@company.com" value=email @input=setField("email"))
            if errors.email
              p.ui-field-error {errors.email}
        div.k-contact__row
          div.ui-field(data-invalid={errors.topic ? "true" : null})
            label.ui-label(for="cf-topic") Topic
            select.ui-select-control#cf-topic(@change=setField("topic"))
              for t in topics key t
                option(value=t selected={t === topic}) {t}
            if errors.topic
              p.ui-field-error {errors.topic}
          div.ui-field
            label.ui-label(for="cf-budget") Budget
            select.ui-select-control#cf-budget(@change=setField("budget"))
              for b in budgets key b
                option(value=b selected={b === budget}) {b}
        div.ui-field(data-invalid={errors.message ? "true" : null})
          label.ui-label(for="cf-message") Message
          textarea.ui-textarea-control#cf-message(rows="5" placeholder="What are you building, and by when?" @input=setField("message")) {message}
          if errors.message
            p.ui-field-error {errors.message}
        div.ui-field(data-invalid={errors.consent ? "true" : null})
          div.ui-checkbox
            input.ui-checkbox-input#cf-consent(type="checkbox" checked={consent} @change=setField("consent"))
            label.ui-checkbox-label(for="cf-consent") You may email me about this request
          if errors.consent
            p.ui-field-error {errors.consent}
        button.ui-button.ui-button-default.ui-button-lg(type="submit")
          span.k-icon.k-glyph(data-glyph="send")
          | Send message
