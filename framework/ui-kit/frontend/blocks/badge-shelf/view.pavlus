// A shelf of achievements, to embed. State = the props: `badges`
// (badgeList() from badges.ts: { id, emoji, title, hint, earned, pct,
// progressText }). Earned badges shine, the others show how far you are.
ul.k-bshelf
  for badge in badges key badge.id
    li.k-bshelf__badge(data-earned={badge.earned ? "true" : null})
      span.k-bshelf__medal {badge.emoji}
      strong.k-bshelf__title {badge.title}
      small.k-bshelf__hint {badge.hint}
      div.ui-progress.ui-progress-sm.k-bshelf__bar
        div.ui-progress-indicator(style="width: {badge.pct}%")
      small.k-bshelf__progress {badge.progressText}
