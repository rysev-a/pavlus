// A tracking board, to embed. State = the props: `lanes` (lanesOf() from
// tracker.ts): one lane per status, each with cards that show a bar with a
// vehicle on it. No map, only boxes. A click on a card sends
// `<name>.pick` with the shipment id.
div.k-shtrack
  for lane in lanes key lane.id
    section(class="k-shtrack__lane k-adm-t-{lane.tone}")
      header.k-shtrack__head
        span.k-shtrack__dot
        h3.k-shtrack__label {lane.label}
        span.k-shtrack__count {lane.count}
      ul.k-shtrack__cards
        for card in lane.cards key card.id
          li
            button.k-shtrack__card(type="button" @click=pick(card.id))
              span.k-shtrack__ref {card.ref}
              span.k-shtrack__route {card.route}
              span.k-shtrack__carrier {card.carrier} · ETA {card.eta}
              span.k-shtrack__track
                span.k-shtrack__fill(style="width: {card.pct}%")
                span.k-shtrack__marker(style="left: {card.pct}%") {card.icon}
              span.k-shtrack__pct {card.pctText}
        if lane.cards.length === 0
          li.k-shtrack__none Nothing here
