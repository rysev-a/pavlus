// A class register, to embed. State = the props: `rows` (rowsOf() from
// attendance.ts) and `summary` (summarize()). Events, with the name of the
// embed in front: `mark` (pupil id, mark id), `rest` (mark everyone not marked
// as present) and `clear`.
div.k-att
  div.k-att__summary
    div.k-att__figures
      for s in summary.segs key s.id
        div(class="k-att__fig k-adm-t-{s.tone}")
          strong {s.count}
          span {s.label}
      div.k-att__fig.k-att__rate
        strong {summary.rate}%
        span Attendance
    div.k-att__bar(role="img" aria-label="Attendance split")
      for s in summary.segs key s.id
        span(class="k-att__seg k-adm-t-{s.tone}" style="width: {s.pct}%")
    div.k-att__tools
      button.ui-button.ui-button-sm.ui-button-outline(type="button" disabled={summary.unmarked === 0} @click=rest) Mark the rest present
      button.ui-button.ui-button-sm.ui-button-ghost(type="button" disabled={summary.unmarked === summary.total} @click=clear) Clear
  ul.k-att__list
    for row in rows key row.id
      li.k-att__row(class:k-att__row--open={row.mark === ""})
        span.k-att__avatar {row.initials}
        div.k-att__who
          strong {row.name}
          if row.note
            small {row.note}
        div.k-att__marks(role="group" aria-label="Mark {row.name}")
          for m in row.marks key m.id
            button(type="button" class="k-att__mark k-adm-t-{m.tone}" aria-pressed={m.active ? "true" : "false"} @click=mark(row.id, m.id)) {m.label}
