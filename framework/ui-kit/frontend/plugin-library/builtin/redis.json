{
  "name": "redis",
  "about": "built in: the redis plugin of @pavlus/backend",
  "external": "Redis",
  "latency": 2,
  "timeout": 1000,
  "errorCode": "ECONNRESET",
  "effects": [
    {
      "type": "redis.cmd",
      "plugin": "redis",
      "hint": "any command: GET / SET / INCR / EXPIRE / DEL ...",
      "detail": "GET cache:todos:{userId}",
      "replies": true,
      "optionalReply": true
    },
    {
      "type": "redis.pipeline",
      "plugin": "redis",
      "hint": "several commands in one round trip",
      "detail": "DEL cache:todos:{userId}; PUBLISH todos:{userId} changed",
      "replies": true,
      "optionalReply": true
    }
  ],
  "builtin": true,
  "server": "server/src/plugins/redis",
  "unmodelled": [
    "multi",
    "subscribe",
    "unsubscribe",
    "publish"
  ]
}
