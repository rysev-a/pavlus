// A service for finding partners by skills, built from the kit's blocks.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Hero from "../../blocks/hero/view.pavlus"
import SkillFilter from "../../blocks/skill-filter/view.pavlus"
import ProfileCard from "../../blocks/profile-card/view.pavlus"

div.k-template.tm#top
  div.tm__wrap
    +SiteNav#nav(brand="Pairup" links=nav ctaLabel="Post a project" ctaHref="#people")
  div.tm__wrap
    +Hero#hero(eyebrow="1,240 developers looking for a team" title="Find the people your project is missing" text="Pick the skills you need. Pairup ranks developers by how well they cover them, shows who has time, and lets you invite in one click.")
  main.tm__wrap.tm__layout#people
    aside.tm__side
      div.ui-card.tm__panel
        div.ui-card-content
          +SkillFilter#filter(title="I need" chips=chips selectedCount=selected.length)
          div.ui-switch.tm__open
            input.ui-switch-input#tm-open(type="checkbox" role="switch" checked={onlyOpen} @change=setOpen)
            label.ui-switch-label(for="tm-open") Hide people who are not available
          div.ui-field
            label.ui-label(for="tm-q") Name or role
            input.ui-input#tm-q(type="text" placeholder="designer, Nora..." value=query @input=setQuery)
    section.tm__main
      div.ui-tabs-list.tm__tabs(role="tablist")
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={tab === "people" ? "true" : "false"} @click=setTab("people")) People ({cards.length})
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={tab === "projects" ? "true" : "false"} @click=setTab("projects")) Projects ({projects.length})
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={tab === "sent" ? "true" : "false"} @click=setTab("sent")) Sent ({sent.length})
      if tab === "people"
        if cards.length === 0
          div.ui-empty-state
            strong Nobody matches
            p Try fewer skills, or show people who are busy too.
        else
          p.tm__note
            if selected.length > 0
              | Ranked by how many of your {selected.length} skills they cover.
            else
              | Pick some skills to see a match score.
          div.tm__grid
            for card in cards key card.id
              +ProfileCard#card(...card)
      else if tab === "projects"
        p.tm__note Projects that need people. The fit is how much of their stack your skills cover.
        div.tm__projects
          for project in projects key project.id
            article.ui-card.tm__project
              div.ui-card-header
                div.tm__project-top
                  span.tm__emoji {project.emoji}
                  div
                    h3.ui-card-title {project.title}
                    p.ui-card-description by {project.owner}
                  if project.fit !== null
                    span.ui-badge.ui-badge-success {project.fit}% fit
              div.ui-card-content.tm__project-body
                p.tm__summary {project.summary}
                ul.tm__needs
                  for need in project.needs key need.label
                    li.ui-badge(class:ui-badge-default={need.hit} class:ui-badge-secondary={!need.hit}) {need.label}
                div.tm__project-foot
                  span.k-muted {project.seats} {project.seats === 1 ? "seat" : "seats"} · {project.commitment}
                  button.ui-button.ui-button-sm(type="button" class:ui-button-default={!project.interested} class:ui-button-secondary={project.interested} @click=toggleInterest(project.id))
                    if project.interested
                      span.k-icon.k-icon-check
                      | Requested
                    else
                      | I am interested
      else
        if sent.length === 0
          div.ui-empty-state
            strong Nothing sent yet
            p Invite a developer or ask to join a project, and it will show up here.
            button.ui-button.ui-button-outline(type="button" @click=setTab("people")) Browse people
        else
          p.tm__note Everything you sent. Take one back any time.
          ul.tm__sent
            for item in sent key item.key
              li.k-item.k-item--outline
                span.k-item__media
                  span.k-icon.k-glyph(data-glyph={item.kind === "invite" ? "send" : "rocket"})
                div.k-item__content
                  span.k-item__title {item.title}
                  span.k-item__description {item.note}
                div.k-item__actions
                  span.ui-badge.ui-badge-warning Waiting
                  if item.kind === "invite"
                    button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=withdraw(item.id)) Take back
                  else
                    button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=toggleInterest(item.id)) Take back
  footer.tm__footer
    div.tm__wrap.tm__footer-row
      span Pairup. Teams are made, not found. Built with pavlus.
      a(href="#top") Back to top
