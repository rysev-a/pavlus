// A sales CRM: a deal pipeline with a detail sheet, contacts, a leaderboard
// and a forecast. The shell, and one view at a time (`screen`), made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Deals from "../../blocks/deal-card/view.pavlus"
import Contacts from "../../blocks/contact-card/view.pavlus"
import Feed from "../../blocks/activity-feed/view.pavlus"
import Board from "../../blocks/leaderboard/view.pavlus"
import Bars from "../../blocks/bar-chart/view.pavlus"
import Progress from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.sales(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Ledgerline" tagline="Sales CRM" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "pipeline"
        +Stats#stats(cards=stats)
        +FilterBar#ownerfilter(filters=ownerFilters query="" placeholder="" actions=none)
        +Deals#board(columns=columns)
      else if screen === "contacts"
        +FilterBar#cfilter(filters=contactFilters query=contactQuery placeholder="Search by name, company or tag" actions=none)
        +Contacts#contacts(contacts=contactList empty="No contact matches your search." single=false)
        if picked
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Deals with this contact
              p.ui-card-description {contactNote}
            div.ui-card-content.sales__flush
              +StatusList#cdeals(rows=contactDeals empty="No deals yet.")
      else if screen === "leaders"
        +Stats#teamstats(cards=teamStats)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Won this quarter
            p.ui-card-description Click a rep to see their pipeline.
          div.ui-card-content
            +Board#leaders(rows=leaders empty="No scores yet.")
      else if screen === "forecast"
        +Stats#fcstats(cards=fcStats)
        div.sales__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Weighted forecast by stage
              p.ui-card-description Each deal counts for the chance of its stage.
            div.ui-card-content
              +Bars#fcstage(columns=fcStage height="220px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Expected by month
              p.ui-card-description Weighted open deals, by close date.
            div.ui-card-content
              +Bars#fcmonth(columns=fcMonth height="220px")
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Quota attainment
            p.ui-card-description Won plus the weighted open pipeline, against the quota.
          div.ui-card-content
            +Progress#quota(items=quota)
  if detail.open
    div.k-modal.k-modal--sheet
      div.k-modal__scrim(@click=closeDetail)
      div.ui-sheet.sales__detail(role="dialog" aria-modal="true" aria-label={detail.title})
        div.ui-dialog-header
          h2.ui-dialog-title {detail.title}
          p.ui-dialog-description {detail.subtitle}
        div.sales__kpis
          div
            small Stage
            span(class="ui-pill ui-pill-{detail.tone}") {detail.stage}
          div
            small Amount
            strong {detail.amount}
          div
            small Chance
            strong {detail.chance}
          div
            small Weighted
            strong {detail.weighted}
          div
            small Close
            strong {detail.close}
        +Contacts#dcontact(contacts=detail.contact empty="" single=true)
        div.ui-field
          label.ui-label(for="sales-next") Next step
          div.sales__inline
            input.ui-input#sales-next(value=nextDraft placeholder="What happens next" @input=nextInput)
            button.ui-button.ui-button-outline(type="button" @click=saveNext) Save
        div.ui-field(data-invalid={noteError ? "true" : null})
          label.ui-label(for="sales-note") Add a note
          textarea.ui-textarea-control#sales-note(rows="2" placeholder="What did you learn?" value=noteDraft @input=noteInput)
          if noteError
            p.ui-field-error {noteError}
          button.ui-button.ui-button-secondary.ui-button-sm.sales__addnote(type="button" @click=saveNote) Add to the timeline
        div.sales__history
          h3 Activity
          +Feed#dfeed(items=detail.feed empty="Nothing has happened yet.")
        div.ui-dialog-footer.sales__foot
          button.ui-button.ui-button-outline(type="button" @click=closeDetail) Close
          if detail.canLose
            button.ui-button.ui-button-destructive(type="button" @click=detailLose) Mark lost
          if detail.canBack
            button.ui-button.ui-button-outline(type="button" @click=detailMove("left")) Back a stage
          if detail.canForward
            button.ui-button.ui-button-default(type="button" @click=detailMove("right")) {detail.forwardLabel}
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=none fields=sheet.fields buttons=sheet.buttons)
