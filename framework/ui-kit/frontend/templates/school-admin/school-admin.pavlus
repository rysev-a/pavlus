// A school office: the shell, and one view at a time (`screen`), all made of
// blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import BarChart from "../../blocks/bar-chart/view.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import Timetable from "../../blocks/timetable-grid/view.pavlus"
import Register from "../../blocks/attendance-sheet/view.pavlus"
import Log from "../../blocks/audit-log/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.sc(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Oakridge School" tagline="School office" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026, week 9" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "overview"
        +Stats#stats(cards=stats)
        div.sc__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Grade distribution
              p.ui-card-description How many students have an average in each band, all classes
            div.ui-card-content
              +BarChart#dist(columns=schoolBars height="200px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Register today
              p.ui-card-description Students here, by class
            div.ui-card-content
              +Meters#attendance(items=attItems)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Latest announcements
            p.ui-card-description What parents, students and staff were told
          div.ui-card-content
            +Log#latest(groups=latest empty="No announcements yet.")
      else if screen === "students"
        +FilterBar#sfilter(filters=studentFilters query=query placeholder="Search a student or a guardian" actions=none)
        +DataGrid#students(columns=sCols rows=sRows empty="No student matches." footer=sFooter pickable=true)
      else if screen === "classes"
        +FilterBar#cls(filters=classFilters query="" placeholder="" actions=none)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Timetable of {classId}
            p.ui-card-description {ttNote} Click a lesson to change it, or an empty period to plan one.
          div.ui-card-content
            +Timetable#tt(corner="Period" cols=ttCols rows=ttRows)
      else if screen === "attendance"
        +FilterBar#attfilter(filters=classFilters query="" placeholder="" actions=none)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Register for {classId}
            p.ui-card-description Tuesday morning. Press a mark again to clear it.
          div.ui-card-content
            +Register#reg(rows=attRows summary=attSummary)
      else if screen === "grades"
        +FilterBar#gfilter(filters=classFilters query="" placeholder="" actions=none)
        +Stats#gstats(cards=gStats)
        +DataGrid#grades(columns=gCols rows=gRows empty="No students in this class." footer="" pickable=true)
        div.sc__cols.sc__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Distribution of averages
              p.ui-card-description Students of {classId} by band
            div.ui-card-content
              +BarChart#classdist(columns=classBars height="170px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Average by subject
              p.ui-card-description Class {classId}
            div.ui-card-content
              +Meters#subjects(items=subItems)
      else if screen === "teachers"
        +FilterBar#tfilter(filters=teacherFilters query="" placeholder="" actions=none)
        +StatusList#teachers(rows=teacherList empty="No teacher in this group.")
      else if screen === "news"
        div.sc__cols.sc__cols--news
          div.ui-card
            div.ui-card-header
              h3.ui-card-title New announcement
              p.ui-card-description Posted at once, with your name
            div.ui-card-content.sc__form
              div.ui-field
                label.ui-label(for="ann-title") Title
                input.ui-input#ann-title(type="text" placeholder="Parents' evening" value=annTitle @input=annTitleInput)
              div.ui-field
                label.ui-label(for="ann-text") Message
                textarea.ui-textarea-control#ann-text(rows="4" placeholder="What should people know?" value=annText @input=annTextInput)
              div.ui-field
                label.ui-label(for="ann-aud") For
                select.ui-select-control#ann-aud(@change=annAudienceChange)
                  for o in audienceOptions key o.value
                    option(value=o.value selected={o.selected}) {o.value}
              if annError
                p.ui-field-error {annError}
              button.ui-button.ui-button-default(type="button" @click=post) Post announcement
          div.sc__feed
            +FilterBar#nfilter(filters=newsFilters query="" placeholder="" actions=none)
            +Log#news(groups=newsGroups empty="Nothing was posted for this audience.")
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
