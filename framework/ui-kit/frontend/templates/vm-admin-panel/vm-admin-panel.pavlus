// A cloud console for a user's own virtual machines: the list (cards or a
// table), a detail view per machine, a creation wizard, the month's bill and
// SSH keys. Made of the blocks admin-shell, stat-cards, list-filter, vm-card,
// data-grid, metric-charts, terminal-sim, status-list, rules-table, vm-wizard,
// bar-chart, record-sheet, code-block and danger-confirm.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import VmCard from "../../blocks/vm-card/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import Charts from "../../blocks/metric-charts/view.pavlus"
import Terminal from "../../blocks/terminal-sim/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import Rules from "../../blocks/rules-table/view.pavlus"
import Wizard from "../../blocks/vm-wizard/view.pavlus"
import BarChart from "../../blocks/bar-chart/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"
import Code from "../../blocks/code-block/view.pavlus"
import Confirm from "../../blocks/danger-confirm/view.pavlus"

div.k-template.k-ashell.vmp(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Cumulus" tagline="Virtual machines" groups=groups active=navActive user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle=subtitle notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "machines"
        +Stats#fleet(cards=fleetStats)
        +FilterBar#mfilter(filters=mFilters query=query placeholder="Search by name, tag, IP or region" actions=mActions)
        if layout === "cards"
          if mCards.length === 0
            div.ui-empty-state
              p {mEmpty}
          else
            div.vmp__cards
              for c in mCards key c.id
                +VmCard#card(...c)
        else
          +DataGrid#mtable(columns=mColumns rows=mRows empty=mEmpty footer=mFooter pickable=true)
      else if screen === "detail"
        if dvm
          div.vmp__dhead
            button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=back)
              span.k-icon.k-ai-arrow-left
              | All machines
            div.vmp__dtitle
              span.vmp__dos {dvm.card.emoji}
              div.vmp__dnames
                h2 {dvm.card.name}
                small {dvm.card.osLabel}, {dvm.card.flag} {dvm.card.regionLabel}
              span(class="ui-pill ui-pill-{dvm.card.pill}") {dvm.card.statusLabel}
            div.vmp__dactions
              for b in dvm.card.buttons key b.id
                button(type="button" class="ui-button ui-button-sm ui-button-{b.variant}" @click=detailAct(b.id))
                  span(class="k-icon {b.icon}")
                  | {b.label}
          +Stats#dstats(cards=dStats)
          div.ui-tabs-list.vmp__tabs(role="tablist")
            for t in dTabs key t.id
              button.ui-tabs-trigger(type="button" role="tab" aria-selected={t.active ? "true" : "false"} @click=tab(t.id)) {t.label}
          if tab === "overview"
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Connect
                p.ui-card-description Use the SSH key you picked when you created the machine.
              div.ui-card-content
                +Code#ssh(lines=sshLines title="Terminal" lang="sh")
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Metrics
                p.ui-card-description Averaged over a few minutes. A stopped machine reports nothing.
              div.ui-card-content
                +Charts#charts(charts=charts ranges=ranges range=range)
          else if tab === "console"
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Console
                p.ui-card-description A simulated shell on this machine. Your files stay while you look at another tab.
              div.ui-card-content
                if dvm.consoleReady
                  +Terminal#term(...term prompt=prompt inputId="vm-console-input" title="deploy@{dvm.card.name}")
                else
                  div.ui-empty-state
                    p The console is off while the machine is {dvm.card.statusLabel}.
                    if dvm.card.status === "stopped"
                      button.ui-button.ui-button-default.ui-button-sm(type="button" @click=detailAct("start")) Start the machine
          else if tab === "snapshots"
            div.ui-card
              div.ui-card-header.vmp__cardbar
                div
                  h3.ui-card-title Snapshots
                  p.ui-card-description A copy of the disk you can restore. Billed by size.
                button.ui-button.ui-button-default.ui-button-sm(type="button" @click=snapCreate)
                  span.k-icon.k-icon-plus
                  | Take a snapshot
              div.ui-card-content.vmp__flush
                +StatusList#snaps(rows=snapList empty="No snapshots yet.")
          else if tab === "network"
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Inbound firewall
                p.ui-card-description Everything not listed is blocked. Outbound traffic is always allowed.
              div.ui-card-content
                +Rules#rules(...rulesView)
          else
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Disks and volumes
                p.ui-card-description The boot disk and the volumes attached to this machine.
              div.ui-card-content.vmp__flush
                +DataGrid#vols(columns=volColumns rows=volRows empty="Nothing attached." footer="" pickable=false)
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Free volumes in this region
                p.ui-card-description Attach one to make it available as a disk.
              div.ui-card-content.vmp__flush
                +StatusList#free(rows=freeList empty="No free volumes in this region.")
      else if screen === "create"
        div.ui-card.vmp__wizard
          div.ui-card-header
            h3.ui-card-title Create a virtual machine
            p.ui-card-description It starts a few seconds after you confirm. You pay by the hour while it runs.
          div.ui-card-content
            +Wizard#wiz(...wiz)
      else if screen === "billing"
        +Stats#bstats(cards=billStats)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Spend per day
            p.ui-card-description Compute and storage for each day of the month so far.
          div.ui-card-content
            +BarChart#bills(columns=billBars height="140px")
        div.ui-card
          div.ui-card-header
            h3.ui-card-title By machine
            p.ui-card-description Hours are counted while a machine is running; storage is billed in all states.
          div.ui-card-content.vmp__flush
            +DataGrid#bill(columns=billColumns rows=billRows empty="No machines." footer=billFooter pickable=false)
      else
        div.vmp__keysbar
          p.vmp__lead Machines accept these keys. There is no password login.
          button.ui-button.ui-button-default.ui-button-sm(type="button" @click=keyAdd)
            span.k-icon.k-icon-plus
            | Add a key
        +DataGrid#keys(columns=keyColumns rows=keyRows empty="No SSH keys yet." footer=keyFooter pickable=false)
  +Sheet#sheet(...sheet)
  +Confirm#confirm(...confirm)
