// A subscription business dashboard: the shell, and one view at a time
// (`screen`), all made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import BarChart from "../../blocks/bar-chart/view.pavlus"
import Area from "../../blocks/area-chart/view.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import Heat from "../../blocks/heat-table/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Flags from "../../blocks/flag-list/view.pavlus"
import Log from "../../blocks/audit-log/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.sa(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Pulseboard" tagline="Revenue analytics" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "overview"
        +Stats#stats(cards=kpis)
        div.sa__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Monthly recurring revenue
              p.ui-card-description The last twelve months, ending with today's figure
            div.ui-card-content
              +Area#mrr(chart=mrrArea)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title MRR by plan
              p.ui-card-description Where the money comes from
            div.ui-card-content
              +Meters#plans(items=planBars)
        div.sa__cols.sa__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Subscriptions by status
              p.ui-card-description Customers in each state
            div.ui-card-content
              +Meters#states(items=statusBars)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Recent activity
              p.ui-card-description The last four changes by the team
            div.ui-card-content
              +Log#recent(groups=recent empty="Nothing happened yet.")
      else if screen === "revenue"
        div.ui-card
          div.ui-card-header.sa__head
            div
              h3.ui-card-title Revenue growth
              p.ui-card-description MRR at the end of each month
            div.ui-tabs-list(role="tablist")
              button.ui-tabs-trigger(type="button" role="tab" aria-selected={range === "12" ? "true" : "false"} @click=setRange("12")) 12 months
              button.ui-tabs-trigger(type="button" role="tab" aria-selected={range === "6" ? "true" : "false"} @click=setRange("6")) 6 months
          div.ui-card-content
            +Area#growth(chart=mrrArea height="270px")
        div.sa__cols.sa__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title MRR movement this month
              p.ui-card-description New, expansion, contraction and churn, in thousands of dollars
            div.ui-card-content
              +BarChart#move(columns=moveCols height="200px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title MRR by plan
              p.ui-card-description Share of the monthly total
            div.ui-card-content
              +Meters#plans2(items=planBars)
      else if screen === "retention"
        +Stats#retstats(cards=retCards)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Cohort retention
            p.ui-card-description Share of each signup month's customers still subscribed
          div.ui-card-content
            +Heat#cohort(corner="Signup month" columns=cohortCols rows=cohortRows steps=steps)
            p.sa__note {cohortNote}
      else if screen === "customers"
        +FilterBar#cfilter(filters=planFilters query=query placeholder="Search a company, a person or an email" actions=cActions)
        +DataGrid#customers(columns=cCols rows=cRows empty="No customer matches." footer=cFooter pickable=true)
      else if screen === "subscriptions"
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Subscriptions by status
            p.ui-card-description Customers in each state, with their monthly value
          div.ui-card-content
            +Meters#states2(items=statusBars)
        +FilterBar#sfilter(filters=subFilters query="" placeholder="" actions=none)
        +DataGrid#subs(columns=subCols rows=subRows empty="No subscription in this state." footer="")
      else if screen === "flags"
        div.ui-alert
          span.ui-alert-icon
            span.k-icon.k-icon-info
          div.ui-alert-body
            p.ui-alert-title Changes go live at once
            div.ui-alert-description {flagFooter} Switching a flag or changing its rollout is written to the audit log.
        +Flags#flags(rows=flagList)
      else if screen === "audit"
        +FilterBar#afilter(filters=auditFilters query=auditQuery placeholder="Search the log" actions=none)
        +Log#audit(groups=auditGroups empty="Nothing matches that search.")
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
