// A template is a page built from the kit's blocks. Its root has `k-template`;
// its look (meta.ts) is applied while it is open. State = the component's.
import LinkList from "../../blocks/link-list/view.pavlus"

div.k-template.lh
  main.lh__card
    span.ui-avatar.lh__avatar
      span.ui-avatar-fallback {name.slice(0, 1)}
    h1.lh__name {name}
    p.lh__handle {handle}
    p.lh__bio {bio}
    +LinkList#list(links=links)
    div.lh__socials
      for social in socials key social.label
        a.ui-button.ui-button-outline.ui-button-sm(href=social.href target="_blank" rel="noreferrer") {social.label}
    p.lh__footer Made with pavlus
