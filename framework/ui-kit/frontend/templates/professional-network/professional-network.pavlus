// A professional network: a feed of updates, my network (invitations, people you
// may know, connections), a job board with filters, messaging, profiles with
// experience, skills and endorsements, and company pages. Built from social-nav,
// post-composer, feed-post, comment-thread, people-list, job-card, pick-list,
// profile-header, experience-list, skill-endorse, conversation-list, chat-thread.
import Nav from "../../blocks/social-nav/view.pavlus"
import Composer from "../../blocks/post-composer/view.pavlus"
import Post from "../../blocks/feed-post/view.pavlus"
import Comments from "../../blocks/comment-thread/view.pavlus"
import People from "../../blocks/people-list/view.pavlus"
import Job from "../../blocks/job-card/view.pavlus"
import Picks from "../../blocks/pick-list/view.pavlus"
import Head from "../../blocks/profile-header/view.pavlus"
import Experience from "../../blocks/experience-list/view.pavlus"
import Skills from "../../blocks/skill-endorse/view.pavlus"
import Inbox from "../../blocks/conversation-list/view.pavlus"
import Chat from "../../blocks/chat-thread/view.pavlus"

div.k-template.pro
  +Nav#nav(...nav)
  if view === "home"
    div.pro__home
      div.pro__col
        +Composer#composer(...composer)
        for item in feed key item.post.id
          div.pro__item
            +Post#post(...item.post)
            if item.open
              div.ui-card.pro__comments
                +Comments#cm(...item.thread)
      aside.pro__col
        +People#suggest(...suggest)
        +People#invites(...invites)
  else if view === "network"
    div.pro__network
      div.pro__col
        +People#invites(...invites)
        +People#suggest(...suggest)
      div.pro__col
        +People#conns(...conns)
  else if view === "jobs"
    div.pro__jobs
      div.ui-card.pro__filters
        div.k-input-group
          span.k-input-group__addon.k-input-group__addon--start
            span.k-icon.k-icon-search
          input.ui-input(type="search" aria-label="Search jobs" placeholder="Title, company, skill or city" value=filters.query @input=setQuery)
        +Picks#kindPick(...kindPick)
        div.pro__row
          label.ui-label(for="pro-level") Level
          select.ui-select-control#pro-level(@change=setLevel)
            for l in levels key l
              option(value=l selected={filters.level === l}) {l}
          label.pro__check
            input(type="checkbox" checked={filters.savedOnly} @change=toggleSavedOnly)
            | Saved only
          if jobsFiltered
            button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=clearFilters) Clear filters
      p.pro__count {jobsLabel}
      if jobs.length === 0
        div.ui-empty-state
          h3 No jobs match
          p.k-muted Try fewer words, or clear the filters.
      for j in jobs key j.id
        +Job#job(...j)
  else if view === "messages"
    div.pro__messages
      +Inbox#inbox(...inbox)
      +Chat#chat(...chat)
  else if view === "profile"
    div.pro__profile
      +Head#head(...head)
      +Experience#experience(...experience)
      +Skills#skills(...skills)
  else if view === "company"
    div.pro__profile
      +Head#companyHead(...companyHead)
      h2.pro__h Open roles
      if roles.length === 0
        div.ui-empty-state
          h3 No open roles right now
      for r in roles key r.id
        +Job#role(...r)
      +People#staff(...staff)
