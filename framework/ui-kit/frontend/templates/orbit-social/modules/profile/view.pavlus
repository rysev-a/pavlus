// The profile screen. State = the props: the slice of the `profile` module, spread.
// Events are `profile.<name>` (see index.ts). Pictures are painted with `style`.
div.orbp
  if !found
    div.ui-card
      div.ui-card-header
        h3.ui-card-title This profile does not exist
        p.ui-card-description The person may have left Orbit.
  else
    section.ui-card.orbp__head
      div.orbp__av.orbp__av--xl(style={head.style}) {head.glyph}{head.initials}
      div.orbp__who
        div.orbp__line
          h2.orbp__name {head.name}
          span.ui-badge(class="ui-badge-{head.roleTone}") {head.role}
        p.orbp__meta
          if head.city
            span {head.city}
          span Last seen {head.lastSeen}
          span
            strong {head.friends}
            |  friends
      div.orbp__acts
        if !own
          button.ui-button.ui-button-default(type="button" @click=message(head.id)) Message
          if relation === "none"
            button.ui-button.ui-button-outline(type="button" @click=add(head.id)) Add friend
          else if relation === "received"
            button.ui-button.ui-button-outline(type="button" @click=accept(head.id)) Accept request
          else if relation === "sent"
            button.ui-button.ui-button-outline(type="button" @click=cancel(head.id)) Cancel request
        button.ui-button.ui-button-outline(type="button" @click=photos(head.id)) Photos
    div.ui-tabs-list.orbp__tabs(role="tablist")
      for t in tabs key t.id
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={t.active ? "true" : "false"} @click=tab(t.id)) {t.label}

    if tab === "about"
      if editing
        form.ui-card.orbp__form(novalidate @submit.prevent=editSave)
          div.ui-card-header
            h3.ui-card-title Edit my profile
            p.ui-card-description Everything here is visible on your page.
          div.ui-card-content.orbp__fields
            div.ui-field(data-invalid={errors.name ? "true" : null})
              label.ui-field-label Name
              input.ui-input(type="text" value={form.name} @input=formField("name"))
              if errors.name
                p.ui-field-error {errors.name}
            div.ui-field(data-invalid={errors.city ? "true" : null})
              label.ui-field-label City
              input.ui-input(type="text" value={form.city} @input=formField("city"))
              if errors.city
                p.ui-field-error {errors.city}
            div.ui-field(data-invalid={errors.birthday ? "true" : null})
              label.ui-field-label Birthday
              input.ui-input(type="date" value={form.birthday} @input=formField("birthday"))
              if errors.birthday
                p.ui-field-error {errors.birthday}
            div.ui-field(data-invalid={errors.website ? "true" : null})
              label.ui-field-label Website
              input.ui-input(type="text" placeholder="https://example.com" value={form.website} @input=formField("website"))
              if errors.website
                p.ui-field-error {errors.website}
            div.ui-field(data-invalid={errors.phone ? "true" : null})
              label.ui-field-label Phone
              input.ui-input(type="text" placeholder="+1 555 0100" value={form.phone} @input=formField("phone"))
              if errors.phone
                p.ui-field-error {errors.phone}
            div.ui-field(data-invalid={errors.interests ? "true" : null})
              label.ui-field-label Interests
              input.ui-input(type="text" placeholder="music, hiking, chess" value={form.interests} @input=formField("interests"))
              p.ui-field-description Separated by commas.
              if errors.interests
                p.ui-field-error {errors.interests}
            div.ui-field.orbp__wide(data-invalid={errors.about ? "true" : null})
              label.ui-field-label About me
              textarea.ui-textarea-control(rows="4" value={form.about} @input=formField("about"))
              if errors.about
                p.ui-field-error {errors.about}
          div.ui-card-footer.orbp__foot
            button.ui-button.ui-button-default(type="button" @click=editSave) Save
            button.ui-button.ui-button-outline(type="button" @click=editCancel) Cancel
      else
        section.ui-card.orbp__about
          div.ui-card-header.orbp__sechead
            h3.ui-card-title About me
            if own
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=editStart) Edit
          div.ui-card-content
            dl.orbp__facts
              div
                dt Name
                dd {about.name}
              div
                dt City
                dd {about.city || "Not set"}
              div
                dt Birthday
                dd {about.birthday || "Not set"}
              div
                dt Website
                dd {about.website || "Not set"}
            h4.orbp__sub About
            p.orbp__text {about.text || "Nothing here yet."}
            h4.orbp__sub Interests
            if about.hasInterests
              ul.orbp__chips
                for i in about.interests key i
                  li.ui-badge.ui-badge-secondary {i}
            else
              p.orbp__text Nothing here yet.

    else if tab === "contacts"
      section.ui-card
        div.ui-card-header
          h3.ui-card-title Contact info
        div.ui-card-content
          dl.orbp__facts
            div
              dt Email
              dd {contact.email || (contact.visible ? "Not set" : "Visible to friends only")}
            div
              dt Phone
              dd {contact.phone || (contact.visible ? "Not set" : "Visible to friends only")}
            div
              dt Website
              dd {contact.website || "Not set"}
      if own
        if incoming.length > 0
          section.ui-card
            div.ui-card-header
              h3.ui-card-title Friend requests
              p.ui-card-description These people want to be your friends.
            div.ui-card-content
              ul.orbp__people
                for r in incoming key r.id
                  li.orbp__person
                    button.orbp__av(type="button" style={r.style} aria-label="Open {r.name}" @click=open(r.id)) {r.glyph}{r.initials}
                    div.orbp__pinfo
                      button.orbp__link(type="button" @click=open(r.id)) {r.name}
                      span {r.since}
                    div.orbp__pacts
                      button.ui-button.ui-button-default.ui-button-sm(type="button" @click=accept(r.id)) Accept
                      button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=decline(r.id)) Decline
        if outgoing.length > 0
          section.ui-card
            div.ui-card-header
              h3.ui-card-title Requests I sent
              p.ui-card-description Waiting for an answer.
            div.ui-card-content
              ul.orbp__people
                for r in outgoing key r.id
                  li.orbp__person
                    button.orbp__av(type="button" style={r.style} aria-label="Open {r.name}" @click=open(r.id)) {r.glyph}{r.initials}
                    div.orbp__pinfo
                      button.orbp__link(type="button" @click=open(r.id)) {r.name}
                      span {r.since}
                    div.orbp__pacts
                      button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=cancel(r.id)) Cancel
      section.ui-card
        div.ui-card-header
          h3.ui-card-title Friends
          p.ui-card-description {friendTotal} in the list
        div.ui-card-content.orbp__friends
          input.ui-input(type="search" placeholder="Search friends by name or city" value={friendQuery} @input=friendSearch)
          if friends.length === 0
            p.orbp__text No friends to show.
          else
            ul.orbp__people
              for r in friends key r.id
                li.orbp__person
                  button.orbp__av(type="button" style={r.style} aria-label="Open {r.name}" @click=open(r.id)) {r.glyph}{r.initials}
                  div.orbp__pinfo
                    button.orbp__link(type="button" @click=open(r.id)) {r.name}
                    span {r.city}
                  div.orbp__pacts
                    button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=message(r.id)) Message
                    if own
                      button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=remove(r.id)) Remove
          if friendPages > 1
            div.orbp__pager
              button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={!hasPrev} @click=friendPage(-1)) Previous
              span Page {friendPageNo} of {friendPages}
              button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={!hasNext} @click=friendPage(1)) Next

    else if tab === "photo"
      section.ui-card
        div.ui-card-header
          h3.ui-card-title My photo
          p.ui-card-description Upload your own picture, or pick one of the generated avatars.
        div.ui-card-content.orbp__photo
          div.orbp__av.orbp__av--xxl(style={avatarStyle}) {avatarGlyph}{avatarInitials}
          div.orbp__photoacts
            button.ui-button.ui-button-default(type="button" @click=upload) Upload a photo
            button.ui-button.ui-button-outline(type="button" @click=removePhoto) Remove photo
            p.orbp__hint The picture is scaled down to 512 pixels and kept in your browser.
      section.ui-card
        div.ui-card-header
          h3.ui-card-title Generated avatars
        div.ui-card-content
          div.orbp__presets
            for p in presets key p.i
              button.orbp__preset(type="button" style={p.style} class:is-on={p.active} aria-label="Avatar {p.i}" aria-pressed={p.active ? "true" : "false"} @click=preset(p.i)) {p.glyph}

    else if tab === "settings"
      section.ui-card
        div.ui-card-header
          h3.ui-card-title Account
        form.ui-card-content.orbp__fields(novalidate @submit.prevent=accSave)
          div.ui-field(data-invalid={accErrors.name ? "true" : null})
            label.ui-field-label Name
            input.ui-input(type="text" value={acc.name} @input=accField("name"))
            if accErrors.name
              p.ui-field-error {accErrors.name}
          div.ui-field(data-invalid={accErrors.email ? "true" : null})
            label.ui-field-label Email
            input.ui-input(type="email" value={acc.email} @input=accField("email"))
            if accErrors.email
              p.ui-field-error {accErrors.email}
          div.orbp__wide
            button.ui-button.ui-button-default(type="button" @click=accSave) Save account
      section.ui-card
        div.ui-card-header
          h3.ui-card-title Change password
        form.ui-card-content.orbp__fields(novalidate @submit.prevent=pwSave)
          div.ui-field.orbp__wide(data-invalid={pwErrors.current ? "true" : null})
            label.ui-field-label Current password
            input.ui-input(type="password" value={pw.current} @input=pwField("current"))
            if pwErrors.current
              p.ui-field-error {pwErrors.current}
          div.ui-field(data-invalid={pwErrors.next ? "true" : null})
            label.ui-field-label New password
            input.ui-input(type="password" value={pw.next} @input=pwField("next"))
            if pwErrors.next
              p.ui-field-error {pwErrors.next}
          div.ui-field(data-invalid={pwErrors.confirm ? "true" : null})
            label.ui-field-label Repeat the new password
            input.ui-input(type="password" value={pw.confirm} @input=pwField("confirm"))
            if pwErrors.confirm
              p.ui-field-error {pwErrors.confirm}
          div.orbp__wide
            button.ui-button.ui-button-default(type="button" @click=pwSave) Change password
      section.ui-card
        div.ui-card-header
          h3.ui-card-title Leave
        div.ui-card-content.orbp__leave
          div.orbp__leaverow
            p.orbp__text Sign out of this browser. Your data stays.
            button.ui-button.ui-button-outline(type="button" @click=signOut) Sign out
          div.orbp__leaverow
            p.orbp__text Delete my account removes your friends, posts, comments, articles, albums, photos, messages, playlists and scores for good.
            if !confirmDelete
              button.ui-button.ui-button-destructive(type="button" @click=deleteAsk) Delete my account
          if deleteError
            p.ui-field-error {deleteError}
          if confirmDelete
            div.ui-alert.ui-alert-danger.orbp__confirm
              div.ui-alert-body
                p.ui-alert-title Delete your account?
                p.ui-alert-description This cannot be undone.
              div.orbp__pacts
                button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=deleteConfirm) Yes, delete everything
                button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=deleteCancel) Keep my account
