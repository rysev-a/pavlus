// A marketing manager: campaigns with budgets, performance charts, an audience
// segment builder, an email composer with a live preview and a calendar of sends.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import Bars from "../../blocks/bar-chart/view.pavlus"
import Segment from "../../blocks/segment-builder/view.pavlus"
import Mail from "../../blocks/email-preview/view.pavlus"
import Picker from "../../blocks/template-picker/view.pavlus"
import Month from "../../blocks/month-grid/view.pavlus"
import Agenda from "../../blocks/agenda-list/view.pavlus"

div.k-template.k-ashell.mkt(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Lumen Studio" tagline="Marketing" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "campaigns"
        +Stats#stats(cards=stats)
        +FilterBar#channel(filters=channelFilters query="" placeholder="" actions=none)
        +DataGrid#campaigns(columns=cols rows=rows empty="No campaign on this channel." footer="" pickable=false)
      else if screen === "performance"
        +FilterBar#pchannel(filters=channelFilters query="" placeholder="" actions=none)
        div.mkt__split
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Open rate
              p.ui-card-description Opens per email sent. Only email has opens.
            div.ui-card-content
              +Bars#open(columns=openBars height="180px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Click rate
              p.ui-card-description Clicks per send or impression.
            div.ui-card-content
              +Bars#click(columns=clickBars height="180px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Conversion rate
              p.ui-card-description Conversions per click.
            div.ui-card-content
              +Bars#conv(columns=convBars height="180px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Cost per conversion
              p.ui-card-description Spend divided by conversions.
            div.ui-card-content
              +Bars#cpa(columns=cpaBars height="180px")
      else if screen === "audience"
        div.mkt__split
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Build a segment
              p.ui-card-description The count follows every change.
            div.ui-card-content
              +Segment#seg(rules=ruleList all=all count=count total=total pct=pct text=text)
              div.ui-field.mkt__save(data-invalid={segError ? "true" : null})
                label.ui-label(for="mkt-segname") Save this segment
                div.mkt__inline
                  input.ui-input#mkt-segname(placeholder="Name, for example Big spenders" value=segName @input=typeSegName)
                  button.ui-button.ui-button-default(type="button" @click=saveSeg) Save
                if segError
                  p.ui-field-error {segError}
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Saved segments
              p.ui-card-description Use one as the audience of an email.
            div.ui-card-content
              ul.mkt__saved
                for s in savedList key s.id
                  li
                    div
                      strong {s.name}
                      small {s.count}
                    button.ui-button.ui-button-outline.ui-button-xs(type="button" @click=useSeg(s.id)) Use in an email
      else if screen === "composer"
        div.mkt__split.mkt__split--composer
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Write the email
              p.ui-card-description Sending to {audienceText}.
            div.ui-card-content.mkt__form
              div.ui-field
                label.ui-label Audience
                select.ui-select-control(aria-label="Audience" @change=sendTarget)
                  for o in targets key o.value
                    option(value=o.value selected={o.selected}) {o.label}
              div.ui-field
                label.ui-label Layout
                +Picker#layouts(options=layouts)
              div.ui-field(data-invalid={errors.subject ? "true" : null})
                label.ui-label(for="mkt-subject") Subject
                input.ui-input#mkt-subject(value=draft.subject @input=edit("subject"))
                if errors.subject
                  p.ui-field-error {errors.subject}
                else
                  p.ui-field-description Use name in double braces to add the first name.
              div.ui-field
                label.ui-label(for="mkt-pre") Preview line
                input.ui-input#mkt-pre(value=draft.preheader @input=edit("preheader"))
              div.ui-field
                label.ui-label(for="mkt-head") Headline
                input.ui-input#mkt-head(value=draft.headline @input=edit("headline"))
              div.ui-field(data-invalid={errors.body ? "true" : null})
                label.ui-label(for="mkt-body") Body
                textarea.ui-textarea-control#mkt-body(rows="6" value=draft.body @input=edit("body"))
                if errors.body
                  p.ui-field-error {errors.body}
                else
                  p.ui-field-description A blank line starts a new paragraph.
              div.ui-field(data-invalid={errors.cta ? "true" : null})
                label.ui-label(for="mkt-cta") Button label
                input.ui-input#mkt-cta(value=draft.cta @input=edit("cta"))
                if errors.cta
                  p.ui-field-error {errors.cta}
              div.mkt__when
                div.ui-field(data-invalid={errors.date ? "true" : null})
                  label.ui-label(for="mkt-date") Send on
                  input.ui-input#mkt-date(type="date" value=sendDate @input=sendField("sendDate"))
                  if errors.date
                    p.ui-field-error {errors.date}
                div.ui-field(data-invalid={errors.time ? "true" : null})
                  label.ui-label(for="mkt-time") At
                  input.ui-input#mkt-time(value=sendTime placeholder="09:00" @input=sendField("sendTime"))
                  if errors.time
                    p.ui-field-error {errors.time}
              button.ui-button.ui-button-default.mkt__schedule(type="button" @click=schedule) Schedule the send
          div.mkt__preview
            h3.mkt__previewtitle Preview for Anna
            +Mail#mail(mail=preview)
      else if screen === "calendar"
        div.mkt__split.mkt__split--calendar
          div.ui-card
            div.ui-card-content
              +Month#cal(month=month)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title {dayTitle}
              p.ui-card-description Scheduled sends and launches of the day.
            div.ui-card-content
              +Agenda#day(days=dayList empty="Nothing is planned for this day.")
