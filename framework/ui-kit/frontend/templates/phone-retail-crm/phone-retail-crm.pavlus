// The Phone Retail CRM: the shell (navigation and top bar) and one view at a
// time (`view`): a data table, a create / update form, the shops map, the sales
// and budget dashboards, or Settings. All of it is made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Table from "../../blocks/crud-table/view.pavlus"
import Form from "../../blocks/crud-form/view.pavlus"
import Sales from "./orders-dashboard.pavlus"
import BudgetBoard from "./budget-dashboard.pavlus"
import ShopsMap from "./shops-map.pavlus"

div.k-template.k-ashell.pcrm(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="PhoneHub" tagline="Retail CRM" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle=subtitle notice=notice actions=actions user=user)
    main.k-ashell__content
      if view === "loading"
        div.ui-card
          div.ui-card-content.pcrm__loading
            span.k-icon.k-icon-loader
            p Opening the database in your browser...
      else if view === "list"
        if guardNote
          div.ui-alert.ui-alert-danger.pcrm__alert
            span.ui-alert-icon
              span.k-icon.k-icon-alert
            div.ui-alert-body
              p.ui-alert-title Not allowed
              div.ui-alert-description {guardNote}
        if confirm.open
          div.ui-alert.pcrm__alert.pcrm__confirm
            span.ui-alert-icon
              span.k-icon.k-icon-alert
            div.ui-alert-body
              p.ui-alert-title Are you sure?
              div.ui-alert-description {confirm.text}
              div.pcrm__confirmbar
                button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=confirmYes) Delete
                button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=confirmNo) Cancel
        +Table#table(...grid)
      else if view === "form"
        if confirm.open
          div.ui-alert.pcrm__alert.pcrm__confirm
            span.ui-alert-icon
              span.k-icon.k-icon-alert
            div.ui-alert-body
              p.ui-alert-title Are you sure?
              div.ui-alert-description {confirm.text}
              div.pcrm__confirmbar
                button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=confirmYes) Delete
                button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=confirmNo) Cancel
        if guardNote
          div.ui-alert.ui-alert-danger.pcrm__alert
            span.ui-alert-icon
              span.k-icon.k-icon-alert
            div.ui-alert-body
              p.ui-alert-title Not allowed
              div.ui-alert-description {guardNote}
        +Form#form(...form)
      else if view === "sales"
        +Sales#sales(...sales)
      else if view === "budget"
        +BudgetBoard#budgetdash(...budgetDash)
      else if view === "shopsMap"
        +ShopsMap#map(...map)
      else if view === "settings"
        div.pcrm__settings
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Your data
              p.ui-card-description {settings.total} rows in {settings.counts.length} tables, about {settings.size}. Everything is stored in this browser (IndexedDB), nowhere else.
            div.ui-card-content
              div.pcrm__counts
                for item in settings.counts key item.id
                  div.pcrm__count
                    span.pcrm__countlabel {item.label}
                    strong {item.count}
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Export and import
              p.ui-card-description Save all the data as one JSON file, or load a file you exported before. An import replaces everything.
            div.ui-card-content.pcrm__row
              button.ui-button.ui-button-default(type="button" @click=settingsExport)
                span.k-icon.k-ai-arrow-down
                | Export all data (JSON)
              button.ui-button.ui-button-outline(type="button" @click=settingsImport)
                span.k-icon.k-ai-file
                | Import from a JSON file
            if settings.importError
              div.ui-card-content
                div.ui-alert.ui-alert-danger
                  span.ui-alert-icon
                    span.k-icon.k-icon-alert
                  div.ui-alert-body
                    p.ui-alert-title The file was not imported
                    div.ui-alert-description {settings.importError}
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Reset
              p.ui-card-description Delete every change and bring back the sample data: 200 users, 50 roles, 100 permissions, 20 sessions, the phone catalogue, 50 shops and 500 orders.
            div.ui-card-content.pcrm__row
              if settings.askReset
                span.pcrm__ask All your changes will be lost. Reset everything?
                button.ui-button.ui-button-destructive(type="button" @click=settingsReset) Yes, reset all data
                button.ui-button.ui-button-outline(type="button" @click=settingsCancelReset) Cancel
              else
                button.ui-button.ui-button-outline.pcrm__danger(type="button" @click=settingsAskReset)
                  span.k-icon.k-ai-refresh
                  | Reset all data
