// A gym back office: the shell, and one view at a time (`screen`): overview,
// check-in desk, members, classes, trainers, payments and plans. All made of
// blocks; the data and the views worked out from it are in the state.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import BarChart from "../../blocks/bar-chart/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"
import Capacity from "../../blocks/capacity-meter/view.pavlus"
import Catalog from "../../blocks/catalog-editor/view.pavlus"

div.k-template.k-ashell.gm(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Ironworks Gym" tagline="Membership admin" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday 3 November, open until 22:00" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "overview"
        +Stats#stats(cards=stats)
        div.gm__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Check-ins today
              p.ui-card-description People through the door, by hour
            div.ui-card-content
              +BarChart#hours(columns=bars height="170px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title On the floor
              p.ui-card-description Members and day passes
            div.ui-card-content
              +Capacity#floor(...meter)
        div.gm__cols.gm__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Plans to renew
              p.ui-card-description Expired, or ending within two weeks
            div.ui-card-content.gm__flush
              +StatusList#soon(rows=soon empty="Every plan is up to date.")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Classes today
              p.ui-card-description Spots taken so far
            div.ui-card-content.gm__flush
              +StatusList#nextc(rows=nextClasses empty="No class today.")
      else if screen === "checkin"
        div.gm__cols.gm__cols--desk
          div.gm__stack
            +FilterBar#deskfilter(filters=deskFilters query=deskQuery placeholder="Search a name or a plan" actions=none)
            +StatusList#desk(rows=deskRows empty="Nobody matches.")
          div.ui-card.gm__sticky
            div.ui-card-header
              h3.ui-card-title Capacity
              p.ui-card-description The floor holds {meter.max} people
            div.ui-card-content
              +Capacity#cap(...meter)
      else if screen === "members"
        +FilterBar#mfilter(filters=memberFilters query=memberQuery placeholder="Search a member or a plan" actions=none)
        +DataGrid#members(columns=memberCols rows=memberRows empty="No member matches." footer=memberFooter pickable=true)
      else if screen === "classes"
        div.gm__bar
          +FilterBar#dayfilter(filters=dayFilters query="" placeholder="" actions=none)
          div.gm__actor
            label.ui-label(for="gm-actor") Booking for
            select.ui-select-control#gm-actor(@change=setActor)
              for opt in actorOptions key opt.value
                option(value=opt.value selected={opt.selected}) {opt.label}
        +StatusList#classes(rows=classRows empty="No class this day.")
      else if screen === "trainers"
        +StatusList#trainers(rows=trainerRows empty="No trainers.")
      else if screen === "payments"
        +Stats#pstats(cards=payStats)
        +FilterBar#payfilter(filters=payFilters query="" placeholder="" actions=none)
        +DataGrid#pay(columns=payCols rows=payRows empty="No payment here." footer="" pickable=false)
      else if screen === "plans"
        p.k-muted.gm__intro Switch a plan off to stop selling it; members who already have it keep it. Prices are in dollars.
        +Catalog#plans(rows=planRows empty="No plans." symbol="$")
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
