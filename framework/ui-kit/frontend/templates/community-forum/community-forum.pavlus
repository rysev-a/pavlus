// A community forum: categories, a thread list with sort (new, top, unanswered),
// a thread page with voting, nested replies and an accepted answer, a new-thread
// form with a live preview, reputation badges, and moderator actions (pin, lock,
// hide). Built from social-nav, pick-list, thread-row, vote-buttons, reply-tree,
// markup-preview and rep-badge.
import Nav from "../../blocks/social-nav/view.pavlus"
import Picks from "../../blocks/pick-list/view.pavlus"
import Row from "../../blocks/thread-row/view.pavlus"
import Vote from "../../blocks/vote-buttons/view.pavlus"
import Tree from "../../blocks/reply-tree/view.pavlus"
import Preview from "../../blocks/markup-preview/view.pavlus"
import Rep from "../../blocks/rep-badge/view.pavlus"

div.k-template.cf
  +Nav#nav(...nav)
  div.cf__tools
    div.k-input-group.cf__search
      span.k-input-group__addon.k-input-group__addon--start
        span.k-icon.k-icon-search
      input.ui-input(type="search" aria-label="Search threads" placeholder="Search threads" value=query @input=setQuery)
    label.cf__mod
      input(type="checkbox" checked={mod} @change=toggleMod)
      | Moderator mode
  if view === "list"
    div.cf__layout
      aside.cf__side
        div.ui-card.cf__card
          +Picks#cats(...cats)
        div.ui-card.cf__card
          h3.cf__h Top members
          ul.cf__members
            for m in top key m.id
              li
                span.cf__av(style="--t: var(--chart-{m.tone})") {m.initials}
                span.cf__name {m.name}
                +Rep#rep(...m.badge)
      div.cf__main
        div.cf__sort
          +Picks#sortPick(...sortPick)
          button.ui-button.ui-button-default.ui-button-sm(type="button" @click=nav.go("new"))
            span.k-icon.k-icon-plus
            | New thread
        if listEmpty
          div.ui-empty-state
            h3 No threads here
            p.k-muted Nothing matches. Try another category or sort, or start a thread.
        for t in list key t.id
          +Row#row(...t)
  else if view === "thread"
    div.cf__thread
      button.ui-button.ui-button-ghost.ui-button-sm.cf__back(type="button" @click=back)
        span.k-icon.k-icon-chevron-left
        | All threads
      if detail
        article.ui-card.cf__op(class:is-hidden={detail.hidden})
          div.cf__opgrid
            +Vote#opvote(...opVote)
            div.cf__opmain
              div.cf__flags
                if detail.pinned
                  span.ui-badge.ui-badge-default Pinned
                if detail.locked
                  span.ui-badge.ui-badge-outline Locked
                if detail.solved
                  span.ui-badge.ui-badge-secondary Solved
                if detail.hidden
                  span.ui-badge.ui-badge-outline Hidden
              h1.cf__title {detail.title}
              p.cf__by
                span.cf__av(style="--t: var(--chart-{detail.tone})") {detail.initials}
                strong {detail.author}
                +Rep#authorRep(...detail.badge)
                span.k-muted {detail.emoji} {detail.category} · {detail.ago} · {detail.views} views
              +Preview#body(blocks=detail.blocks)
          if mod
            div.cf__modbar
              strong Moderator
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=togglePin) {detail.pinned ? "Unpin" : "Pin"}
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=toggleLock) {detail.locked ? "Unlock" : "Lock"}
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=toggleHide) {detail.hidden ? "Unhide" : "Hide"}
        h2.cf__h {replyCount} {replyCount === 1 ? "reply" : "replies"}
        +Tree#tree(...tree)
        if canAnswer
          form.ui-card.cf__answer(novalidate @submit.prevent=postAnswer)
            label.ui-label(for="cf-answer") Your answer
            textarea.ui-textarea-control#cf-answer(rows="4" placeholder="Share what worked for you" value=answerDraft @input=setAnswer)
            div
              button.ui-button.ui-button-default(type="submit" disabled={!canSendAnswer}) Post answer
        else
          div.ui-alert
            div.ui-alert-body
              p.ui-alert-title This thread is locked
              div.ui-alert-description New replies are turned off.
  else if view === "new"
    div.cf__new
      form.ui-card.cf__form(novalidate @submit.prevent=createThread)
        div.ui-card-header
          h1.ui-card-title Start a new thread
          p.ui-card-description Use # for a heading, - for a list, > for a quote, and **bold**, *italic* or `code` inside a line.
        div.ui-card-content
          div.ui-form
            div.ui-field(data-invalid={errors.title ? "true" : null})
              label.ui-label(for="cf-title") Title
              input.ui-input#cf-title(type="text" placeholder="What is your question?" value=form.title @input=setField("title"))
              if errors.title
                p.ui-field-error {errors.title}
            div.ui-field(data-invalid={errors.category ? "true" : null})
              label.ui-label(for="cf-cat") Category
              select.ui-select-control#cf-cat(@change=setField("category"))
                option(value="" selected={form.category === ""}) Choose...
                for c in catOptions key c.id
                  option(value=c.id selected={form.category === c.id}) {c.label}
              if errors.category
                p.ui-field-error {errors.category}
            div.ui-field(data-invalid={errors.body ? "true" : null})
              label.ui-label(for="cf-body") Details
              textarea.ui-textarea-control#cf-body(rows="9" placeholder="Describe what you tried" value=form.body @input=setField("body"))
              if errors.body
                p.ui-field-error {errors.body}
            div
              button.ui-button.ui-button-default(type="submit") Post thread
      div.ui-card.cf__preview
        h3.cf__h Live preview
        if previewTitle
          h2.cf__ptitle {previewTitle}
        +Preview#preview(...preview)
