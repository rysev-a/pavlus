// A habit tracker: the admin shell and one view at a time, all made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import Grid from "../../blocks/habit-grid/view.pavlus"
import Heat from "../../blocks/habit-grid/heatmap.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import Form from "../../blocks/habit-form/view.pavlus"
import Remind from "../../blocks/reminder-list/view.pavlus"
import Shelf from "../../blocks/badge-shelf/view.pavlus"

div.k-template.k-ashell.ht(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Streaks" tagline="Habit tracker" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle=todayLine notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "today"
        +Stats#stats(cards=stats)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title This week
            p.ui-card-description Click a box to check a day in or out. Click a habit to edit it.
          div.ui-card-content
            +Grid#grid(days=days rows=rows)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Last 30 days
            p.ui-card-description Share of the due days you did each habit
          div.ui-card-content
            +Meters#rates(items=rates)
      else if screen === "heatmap"
        div.ht__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title The month at a glance
              p.ui-card-description The darker a box, the more of that day's habits you did.
            div.ui-card-content
              +Heat#heat(title=heatTitle weekdays=weekdays weeks=weeks)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Completion by habit
              p.ui-card-description Last 30 days
            div.ui-card-content
              +Meters#rates2(items=rates)
      else if screen === "habits"
        div.ht__cols.ht__cols--form
          +StatusList#hl(rows=habitRows empty="No habits yet. Add the first one.")
          if core.formOpen
            div.ui-card
              div.ui-card-header
                h3.ui-card-title
                  if editing
                    | Edit habit
                  else
                    | New habit
              div.ui-card-content
                +Form#form(draft=core.draft errors=core.errors tones=tones icons=icons freqs=freqs editing=editing)
          else
            div.ui-card.ht__hint
              div.ui-card-content
                p Pick Edit on a habit, or add a new one with the button above.
      else if screen === "reminders"
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Reminders
            p.ui-card-description A nudge at the time you choose, one per habit.
          div.ui-card-content
            +Remind#remind(rows=reminderRows summary=summary)
      else if screen === "badges"
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Achievements
            p.ui-card-description Earned badges first, the rest show how close you are.
          div.ui-card-content
            +Shelf#shelf(badges=badges)
