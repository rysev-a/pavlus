// A practice room: a piano, a guitar neck, a note display and a "find the note"
// quiz. The two instruments are the blocks piano-keyboard and guitar-neck; the
// page only decides which keys are lit and what the app asks.
import Piano from "../../blocks/piano-keyboard/view.pavlus"
import Neck from "../../blocks/guitar-neck/view.pavlus"

div.k-template.mtt
  header.mtt__bar
    div.mtt__brand
      span.ui-brand-mark ♪
      div.mtt__brand-text
        strong Fretboard Gym
        span.k-muted Learn the notes on piano and guitar
    div.ui-tabs-list(role="tablist")
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={tab === "free" ? "true" : "false"} @click=setTab("free")) Free play
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={tab === "quiz" ? "true" : "false"} @click=setTab("quiz")) Find the note
  div.mtt__layout
    aside.mtt__side
      div.ui-card.mtt__display
        div.ui-card-header
          h2.ui-card-title Now playing
          p.ui-card-description {info.where}
        div.ui-card-content
          div.mtt__big(class:is-empty={info.empty})
            span.mtt__big-name {info.name}
            span.mtt__big-oct {info.octave}
          div.ui-detail-list
            div.ui-detail-row
              span.k-muted Frequency
              strong {info.hz}
            div.ui-detail-row
              span.k-muted MIDI number
              strong {info.midi}
            div.ui-detail-row
              span.k-muted From the last note
              strong {info.interval}
            if info.elsewhere
              div.ui-detail-row
                span.k-muted Same note
                strong {info.elsewhere}
      if tab === "quiz"
        div.ui-card.mtt__quiz(data-mood={quiz.mood || null})
          div.ui-card-header
            h2.ui-card-title Find the note
            p.ui-card-description Question {quiz.number} of {quiz.total}: click it on the piano or on the guitar.
          div.ui-card-content
            div.ui-progress.ui-progress-sm(role="progressbar" aria-valuenow={quiz.progress} aria-valuemin="0" aria-valuemax="100")
              div.ui-progress-indicator(style="width: {quiz.progress}%")
            if quiz.finished
              div.mtt__prompt Round complete
              p.mtt__verdict You got {score} of {quiz.total} on the first try ({quiz.accuracy}%). Best streak: {best}.
              button.ui-button.ui-button-default(type="button" @click=restart) Play another round
            else
              div.mtt__prompt {quiz.prompt}
              p.mtt__verdict(role="status") {quiz.verdict}
              div.k-row
                if status === "correct"
                  button.ui-button.ui-button-default.ui-button-sm(type="button" @click=advance) Next
                else if status === "skipped"
                  button.ui-button.ui-button-default.ui-button-sm(type="button" @click=advance) Next
                else
                  button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=skip) Show me
                div.ui-switch
                  input.ui-switch-input#mtt-hint(type="checkbox" role="switch" checked={hint} @change=toggleHint)
                  label.ui-switch-label(for="mtt-hint") Hint
            div.mtt__stats
              div.mtt__stat
                span.k-muted Score
                strong {score}/{asked}
              div.mtt__stat
                span.k-muted Streak
                strong {streak}
              div.mtt__stat
                span.k-muted Best
                strong {best}
              div.mtt__stat
                span.k-muted Accuracy
                strong {quiz.accuracy}%
      else
        div.ui-card.mtt__tips
          div.ui-card-header
            h2.ui-card-title How to play
          div.ui-card-content
            ul.mtt__tips-list
              li Click a key or a fret. The note, its frequency and the interval from the last note show above.
              li Click the piano, then type on your keyboard: the home row plays the white keys, the row above plays the black ones.
              li Switch to Find the note for a quiz: the app names a note and you find it.
    div.mtt__instruments
      div.mtt__controls
        fieldset.ui-toggle-group
          legend.ui-toggle-group-label.ui-sr-only Accidentals
          div.ui-toggle-group-options
            div.ui-toggle-option
              input.ui-toggle-option-input#mtt-sharp(type="radio" name="mtt-accidental" checked={accidental === "sharp"} @change=setAccidental("sharp"))
              label.ui-toggle-option-label(for="mtt-sharp") Sharps ♯
            div.ui-toggle-option
              input.ui-toggle-option-input#mtt-flat(type="radio" name="mtt-accidental" checked={accidental === "flat"} @change=setAccidental("flat"))
              label.ui-toggle-option-label(for="mtt-flat") Flats ♭
        fieldset.ui-toggle-group
          legend.ui-toggle-group-label.ui-sr-only Octaves
          div.ui-toggle-group-options
            div.ui-toggle-option
              input.ui-toggle-option-input#mtt-oct2(type="radio" name="mtt-octaves" checked={octaves === 2} @change=setOctaves(2))
              label.ui-toggle-option-label(for="mtt-oct2") 2 octaves
            div.ui-toggle-option
              input.ui-toggle-option-input#mtt-oct3(type="radio" name="mtt-octaves" checked={octaves === 3} @change=setOctaves(3))
              label.ui-toggle-option-label(for="mtt-oct3") 3 octaves
        div.ui-switch
          input.ui-switch-input#mtt-labels(type="checkbox" role="switch" checked={labels} @change=toggleLabels)
          label.ui-switch-label(for="mtt-labels") Note names
      section.ui-card.mtt__instrument
        div.ui-card-header
          h2.ui-card-title Piano
          p.ui-card-description Three octaves from C3. Click the keyboard, then play it with A W S E D F T G Y H U J.
        div.ui-card-content
          +Piano#piano(...piano)
      section.ui-card.mtt__instrument
        div.ui-card-header
          h2.ui-card-title Guitar
          p.ui-card-description Standard tuning, E A D G B E, twelve frets. The thick line is the nut.
        div.ui-card-content
          +Neck#neck(...neck)
