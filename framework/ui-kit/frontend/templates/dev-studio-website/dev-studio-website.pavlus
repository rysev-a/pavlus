// The site of a software studio, built from the kit's blocks.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Hero from "../../blocks/hero/view.pavlus"
import StatsStrip from "../../blocks/stats-strip/view.pavlus"
import FeatureGrid from "../../blocks/feature-grid/view.pavlus"
import ProcessSteps from "../../blocks/process-steps/view.pavlus"
import Testimonials from "../../blocks/testimonials/view.pavlus"
import Contact from "../../blocks/contact-form/view.pavlus"

div.k-template.ds#top
  div.ds__wrap
    +SiteNav#nav(brand="Northline" links=nav ctaLabel="Start a project" ctaHref="#contact")
  header.ds__hero
    div.ds__wrap.ds__hero-grid
      div
        +Hero#hero(eyebrow="Software studio, Lisbon and remote" title="We build the software your business runs on" text="A senior team of 24 that designs, builds and looks after web apps, mobile apps and platforms. Fixed scope, honest estimates, code you can own." primaryLabel="Start a project" primaryHref="#contact" secondaryLabel="See our work" secondaryHref="#work")
      div.ds__terminal(aria-hidden="true")
        div.ds__terminal-bar
          span
          span
          span
        pre.ds__terminal-body
          span.ds__dim $ northline new freight-portal
          span ✔ discovery workshop booked
          span ✔ prototype approved
          span ✔ 14 of 14 sprints shipped
          span.ds__ok → live in production, 0 incidents
  section.ds__section
    div.ds__wrap
      +StatsStrip#stats(stats=stats)
  section.ds__section#services
    div.ds__wrap
      div.ds__head
        span.ds__kicker Services
        h2.ds__title One team from the first sketch to the pager
        p.ds__lead Everything a product needs, without handing it between agencies.
      +FeatureGrid#grid(items=services)
  section.ds__section.ds__section--alt#stack
    div.ds__wrap
      div.ds__head
        span.ds__kicker Tech stack
        h2.ds__title Tools we trust in production
        p.ds__lead We pick boring technology on purpose and stay current on the rest.
      div.ds__stack
        for group in stack key group.title
          div.ui-card.ds__stack-card
            div.ui-card-header
              h3.ui-card-title {group.title}
            div.ui-card-content
              ul.ds__chips
                for item in group.items key item
                  li.ui-badge.ui-badge-secondary {item}
  section.ds__section#process
    div.ds__wrap
      div.ds__head
        span.ds__kicker Process
        h2.ds__title How a project runs
        p.ds__lead Four stages, one point of contact, a demo every two weeks.
      +ProcessSteps#steps(steps=steps)
  section.ds__section.ds__section--alt#work
    div.ds__wrap
      div.ds__head
        span.ds__kicker Case studies
        h2.ds__title Results, not screenshots
        div.ui-tabs-list(role="tablist" aria-label="Project type")
          for cat in categories key cat.id
            button.ui-tabs-trigger(type="button" role="tab" aria-selected={cat.id === category ? "true" : "false"} @click=setCategory(cat.id)) {cat.label}
      div.ds__projects
        for project in shown key project.id
          article.ui-card.ds__project
            div.ds__cover(data-cover=project.cover)
              span.ds__cover-emoji {project.emoji}
              span.ui-badge.ui-badge-secondary {project.client}
            div.ui-card-header
              h3.ui-card-title {project.title}
              p.ui-card-description {project.summary}
            div.ui-card-content.ds__project-body
              div.ds__results
                for result in project.results key result.label
                  div.ds__result
                    strong {result.value}
                    span {result.label}
              ul.ds__chips
                for tag in project.tags key tag
                  li.ui-badge.ui-badge-outline {tag}
      div.ds__quotes
        +Testimonials#quotes(items=quotes)
  section.ds__section#team
    div.ds__wrap
      div.ds__head
        span.ds__kicker Team
        h2.ds__title The people you will actually work with
        p.ds__lead Senior engineers and designers, no juniors hidden behind a rate card.
      div.ds__team
        for member in team key member.name
          div.ui-card.ds__member
            div.ui-card-content
              span.ds__avatar(data-tone=member.tone) {member.initials}
              h3.ds__member-name {member.name}
              p.ds__member-role {member.role}
              p.ds__member-bio {member.bio}
  section.ds__section.ds__section--alt#contact
    div.ds__wrap.ds__contact
      div.ds__contact-copy
        span.ds__kicker Contact
        h2.ds__title Let us talk about what you are building
        p.ds__lead We reply within one business day, and the first call is free.
        ul.ds__facts
          li
            span.k-icon.k-glyph(data-glyph="mail")
            span hello@northline.dev
          li
            span.k-icon.k-glyph(data-glyph="pin")
            span Rua da Alfandega 12, Lisbon
          li
            span.k-icon.k-glyph(data-glyph="clock")
            span Mon to Fri, 9:00 to 18:00 WET
      +Contact#contact(...contact)
  footer.ds__footer
    div.ds__wrap.ds__footer-row
      span Northline Studio. Built with pavlus.
      a(href="#top") Back to top
