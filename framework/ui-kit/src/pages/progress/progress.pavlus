section.k-page
  section.k-demo
    h2.k-demo__title Default
    div.k-preview
      div.k-narrow
        div.ui-progress(role="progressbar" aria-valuenow="66" aria-valuemin="0" aria-valuemax="100")
          div.ui-progress-indicator(style="width: 66%")
  section.k-demo
    h2.k-demo__title With a label
    div.k-preview
      div.ui-progress-field.k-narrow
        div.ui-progress-header
          span.ui-progress-label Uploading
          span.ui-progress-value 45%
        div.ui-progress(role="progressbar")
          div.ui-progress-indicator(style="width: 45%")
  section.k-demo
    h2.k-demo__title Colors and sizes
    div.k-preview.k-preview--column
      div.ui-progress.ui-progress-sm.ui-progress-success
        div.ui-progress-indicator(style="width: 80%")
      div.ui-progress.ui-progress-warning
        div.ui-progress-indicator(style="width: 55%")
      div.ui-progress.ui-progress-danger
        div.ui-progress-indicator(style="width: 30%")
      div.ui-progress.ui-progress-lg.ui-progress-info
        div.ui-progress-indicator(style="width: 65%")
  section.k-demo
    h2.k-demo__title Striped and indeterminate
    div.k-preview.k-preview--column
      div.ui-progress.ui-progress-lg.ui-progress-striped
        div.ui-progress-indicator(style="width: 70%")
      div.ui-progress.ui-progress-indeterminate
        div.ui-progress-indicator
