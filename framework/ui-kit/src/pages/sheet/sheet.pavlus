section.k-page
  section.k-demo
    h2.k-demo__title Sides
    div.k-preview
      button.ui-button.ui-button-outline(type="button" @click=open("top")) Top
      button.ui-button.ui-button-outline(type="button" @click=open("right")) Right
      button.ui-button.ui-button-outline(type="button" @click=open("bottom")) Bottom
      button.ui-button.ui-button-outline(type="button" @click=open("left")) Left
  if open
    div.k-modal.k-modal--sheet
      div.k-modal__scrim(@click=hide)
      div.ui-sheet(role="dialog" aria-modal="true" class:ui-sheet-left=fromLeft class:ui-sheet-top=fromTop class:ui-sheet-bottom=fromBottom)
        div.ui-dialog-header
          h2.ui-dialog-title Edit profile
          p.ui-dialog-description Make changes to your profile here. Click save when you are done.
        div.ui-form(style="margin-top: 16px")
          div.ui-field
            label.ui-label(for="sh-name") Name
            input.ui-input#sh-name(type="text" value="Pedro Duarte")
        div.ui-dialog-footer
          button.ui-dialog-close(type="button" @click=hide) Close
          button.ui-button.ui-button-default(type="button" @click=hide) Save changes
