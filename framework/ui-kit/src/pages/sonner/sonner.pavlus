// The toaster is fixed to the bottom right of the window. Each toast's place in
// the stack (--toast-index, --toast-offset-y) is data computed in sonner.ts.
section.k-page
  section.k-demo
    h2.k-demo__title Toasts
    div.k-preview
      button.ui-button.ui-button-outline(type="button" @click=show("default")) Show toast
      button.ui-button.ui-button-outline(type="button" @click=show("success")) Success
      button.ui-button.ui-button-outline(type="button" @click=show("error")) Error
      button.ui-button.ui-button-ghost(type="button" @click=clear) Dismiss all
    p.k-hint {toasts.length} showing. Each one is dismissed by a timer of the time plugin after 4 seconds.
  div.ui-toaster.ui-toaster-bottom-right(role="region" aria-label="Notifications")
    for toast in toasts key toast.id
      div.ui-toast(data-measured data-expanded role="status" style="--toast-index: {toast.index}; --toast-height: 72px; --toast-offset-y: {toast.offset}px; --toast-swipe-movement-x: 0px; --toast-swipe-movement-y: 0px")
        div.ui-toast-content(data-expanded)
          span.ui-toast-icon(class:ui-toast-icon-error=toast.error)
            if toast.success
              span.k-icon.k-icon-check
            else if toast.error
              span.k-icon.k-icon-alert
            else
              span.k-icon.k-icon-info
          div.ui-toast-body
            p.ui-toast-title {toast.title}
            p.ui-toast-description {toast.description}
          button.ui-button.ui-button-ghost.ui-toast-close(type="button" aria-label="Close" @click=dismiss(toast.id))
            span.k-icon.k-icon-x
