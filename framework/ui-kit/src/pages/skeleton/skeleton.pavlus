section.k-page
  section.k-demo
    h2.k-demo__title Profile
    div.k-preview
      div.k-row(style="gap: 16px")
        div.ui-skeleton.ui-skeleton-circle(style="width: 48px; height: 48px")
        div.k-stack(style="gap: 8px")
          div.ui-skeleton(style="width: 250px; height: 16px")
          div.ui-skeleton(style="width: 200px; height: 16px")
  section.k-demo
    h2.k-demo__title Card
    div.k-preview
      div.k-stack.k-narrow(style="gap: 12px")
        div.ui-skeleton(style="height: 125px")
        div.ui-skeleton(style="height: 16px")
        div.ui-skeleton(style="width: 70%; height: 16px")
