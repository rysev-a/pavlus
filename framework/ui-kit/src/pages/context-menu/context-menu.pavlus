section.k-page
  section.k-demo
    h2.k-demo__title Right click
    div.k-preview
      div.k-popover-host
        div.k-context-area(@contextmenu.prevent=open) Right click here
        if shown
          div.k-dismiss(@click=close @contextmenu.prevent=close)
          div.ui-navigation-panel.k-above(role="menu" style="top: 48px; left: 48px; min-width: 200px")
            button(type="button" role="menuitem" @click=choose("Back"))
              | Back
              span.k-menu-shortcut ⌘[
            button(type="button" role="menuitem" disabled) Forward
            button(type="button" role="menuitem" @click=choose("Reload"))
              | Reload
              span.k-menu-shortcut ⌘R
            div.k-menu-separator
            button(type="button" role="menuitem" @click=choose("Save As..."))
              | Save As...
              span.k-menu-shortcut ⇧⌘S
    p.k-hint
      | Chosen:
      |
      span.k-state {chosenLabel}
