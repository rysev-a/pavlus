// The cart, to embed as a child (see shop-cart.ts, `cartBlock`): its state is
// the cart's. Messages: add, inc, dec, setQty, remove, choose, clear,
// applyPromo, configure (from the shop) and checkout (to the shop).
section.k-cart
  if empty
    div.k-cart__empty
      span.k-cart__empty-art 🛒
      strong Your cart is empty
      p.k-cart__muted {emptyText}
  else
    ul.k-cart__lines
      for line in lines key line.key
        li.k-cart__line
          span.k-cart__art(style="--hue: {line.hue}") {line.emoji}
          div.k-cart__body
            div.k-cart__top
              div.k-cart__text
                strong.k-cart__name {line.name}
                if line.variant
                  span.k-cart__variant {line.variant}
              button.ui-button.ui-button-ghost.ui-button-icon-xs(type="button" aria-label="Remove {line.name}" @click=remove(line.key))
                span.k-icon.k-icon-x
            if line.hasChoices
              select.ui-select-control.k-cart__choice(aria-label="License of {line.name}" @change=choose(line.key))
                for c in line.choices key c.id
                  option(value=c.id selected=c.selected) {c.text}
            div.k-cart__bottom
              div.k-cart__stepper
                button.ui-button.ui-button-outline.ui-button-icon-xs(type="button" aria-label="One less {line.name}" @click=dec(line.key)) −
                input.ui-input.k-cart__qty(type="number" min="1" max=line.max value=line.qty aria-label="Quantity of {line.name}" @change=setQty(line.key))
                button.ui-button.ui-button-outline.ui-button-icon-xs(type="button" aria-label="One more {line.name}" disabled={line.atMax} @click=inc(line.key))
                  span.k-icon.k-icon-plus
              span.k-cart__price {line.totalLabel}
    form.k-cart__promo(novalidate @submit.prevent=applyPromo)
      div.k-cart__promo-row
        input.ui-input(type="text" placeholder="Promo code" aria-label="Promo code" value=promoInput @input=promoInput)
        button.ui-button.ui-button-outline(type="submit") Apply
      if promoMessage
        p.k-cart__promo-msg(class:is-ok={promoOk} class:is-bad={promoBad}) {promoMessage}
    dl.k-cart__sum
      div.k-cart__row
        dt Subtotal
        dd {sum.subtotal}
      if sum.hasDiscount
        div.k-cart__row.is-discount
          dt Promo code {promo}
          dd {sum.discount}
      if sum.hasShipping
        div.k-cart__row
          dt {sum.shipLabel}
          dd {sum.shipping}
      div.k-cart__row
        dt {sum.taxLabel}
        dd {sum.tax}
      div.k-cart__row.k-cart__row--total
        dt Total
        dd {sum.total}
    if sum.shipNote
      p.k-cart__hint {sum.shipNote}
    button.ui-button.ui-button-default.ui-button-lg.k-cart__checkout(type="button" @click=checkout) {checkoutLabel}
