// A line of text with `code`, bold and links, to embed. State = the props:
// `runs`, from `parseInline` in docs.ts. A link to a page sends `<name>.open`
// with the page id.
span.k-dl__runs
  for run, i in runs key i
    if run.isPage
      a.k-dl__inlink(href="#" @click.prevent=open(run.href)) {run.t}
    else if run.isLink
      a.k-dl__inlink(href=run.href target="_blank" rel="noreferrer") {run.t}
    else
      span(data-k={run.dataK}) {run.t}
