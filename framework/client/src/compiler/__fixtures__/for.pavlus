// Keyed loops with an index, nested loops, and an if inside a loop.
table
  for row, r in rows key row.id
    tr(class:odd=row.isOdd)
      for cell, c in row.cells key cell.id
        td
          if cell.link
            a(href=cell.link) {r}-{c} {cell.text}
          else
            | {cell.text}
