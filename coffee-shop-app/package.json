{
  "name": "coffee-shop-app",
  "private": true,
  "version": "0.1.0",
  "description": "Coffee shop CRM: a pavlus-server app generated by Flow Studio from its design",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@service-laboratory/pavlus": "*",
    "pavlus-server": "*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
