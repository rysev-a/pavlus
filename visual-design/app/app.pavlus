// The shell: the bar (the way back, the name of the project, its two editors, the
// state of the saves, the theme) and the page the route selects. The theme panel is
// the ui-kit's own; its events reach the shell as `themepanel.<message>`.
import ThemePanel from "../../ui-kit/frontend/components/theme-panel/theme-panel.pavlus"

div.vd.ui-shell(class:k-with-panel={panelOpen})
  header.vd-bar
    a.vd-brand(href="/" @click.prevent=navigate("/")) Visual Design
    if projectId
      span.vd-sep /
      input.ui-input.vd-name(type="text" value=projectName aria-label="Project name" maxlength="120" @change=renameProject)
      nav.vd-tabs(aria-label="Editors")
        a.vd-tab(href={"/projects/" + projectId + "/flow"} class:vd-tab--on={tab === "flow"} aria-current={tab === "flow" ? "page" : "false"} @click.prevent=navigate("/projects/" + projectId + "/flow")) Diagram
        a.vd-tab(href={"/projects/" + projectId + "/interface"} class:vd-tab--on={tab === "interface"} aria-current={tab === "interface" ? "page" : "false"} @click.prevent=navigate("/projects/" + projectId + "/interface")) Interface
      span.vd-save(role="status" class:vd-save--busy={save === "saving"} class:vd-save--error={save === "error"}) {saveText}
    else
      span.vd-tag Programming with diagrams and pages
    div.vd-actions
      if projectId
        button.ui-button.ui-button-ghost.ui-button-sm.vd-apptheme(type="button" aria-label="Color theme of the app" aria-pressed={panelOpen && target === "app" ? "true" : "false"} class:k-header-on={panelOpen && target === "app"} @click=openPanel("app"))
          span.k-icon.k-icon-palette
          | App theme
      button.ui-button.ui-button-ghost.ui-button-icon(type="button" aria-label="Color theme of the editor" aria-pressed={panelOpen && target === "editor" ? "true" : "false"} class:k-header-on={panelOpen && target === "editor"} @click=openPanel("editor"))
        span.k-icon.k-icon-palette
      button.ui-button.ui-button-ghost.ui-button-icon(type="button" aria-label="Toggle light and dark" @click=toggleMode)
        if look.mode === "dark"
          span.k-icon.k-icon-sun
        else
          span.k-icon.k-icon-moon
  main.ui-shell-content.k-wide.vd-main
    if notice
      p.vd-notice(role="alert") {notice}
    +outlet
  +ThemePanel#themepanel(look={target === "app" && appLook ? appLook : look} catalog=catalog family=family shown=shown open=panelOpen exportNote=exportNote)
