import Piano from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Play it
    p.k-demo__note Click a key, or focus the keyboard and type A W S E D F T G Y H U J.
    div.k-preview.k-preview--column
      div.k-row
        button.ui-button.ui-button-outline.ui-button-sm(type="button" aria-pressed={labels ? "true" : "false"} @click=toggleLabels) Note names: {labels ? "on" : "off"}
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=toggleAccidental) {accidental === "sharp" ? "Sharps ♯" : "Flats ♭"}
      +Piano#piano(...playable)
      p.k-hint {played}
  section.k-demo
    h2.k-demo__title Marked notes
    p.k-demo__note A C major chord (C E G): marked pitch classes are lit in every octave.
    div.k-preview.k-preview--block
      +Piano#chord(...chord)
