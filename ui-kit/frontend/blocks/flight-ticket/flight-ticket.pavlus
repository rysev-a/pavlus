section.k-page
  section.k-demo
    h2.k-demo__title Book a flight
    div.k-preview.k-preview--column.k-ft
      ol.k-ft-steps
        for s in steps key s.n
          li.k-ft-step(data-state={s.state})
            span.k-ft-dot
              if s.state === "done"
                span.k-icon.k-icon-check
              else
                | {s.n}
            span.k-ft-step-label {s.label}
      if step === "search"
        form.k-ft-panel(novalidate @submit.prevent=search)
          div.ui-form
            div.k-ft-pair
              div.ui-select
                label.ui-select-label(for="ft-from") From
                select.ui-select-control#ft-from(@change=setField("from"))
                  for c in cities key c.code
                    option(value=c.code selected={c.code === from}) {c.name} ({c.code})
              div.ui-field(data-invalid={errors.to ? "true" : null})
                div.ui-select
                  label.ui-select-label(for="ft-to") To
                  select.ui-select-control#ft-to(aria-invalid={errors.to ? "true" : null} @change=setField("to"))
                    for c in cities key c.code
                      option(value=c.code selected={c.code === to}) {c.name} ({c.code})
                if errors.to
                  p.ui-field-error {errors.to}
            div.k-ft-pair
              div.ui-field(data-invalid={errors.depart ? "true" : null})
                label.ui-label(for="ft-depart") Depart
                input.ui-input#ft-depart(type="date" min={minDate} value=depart @input=setField("depart"))
                if errors.depart
                  p.ui-field-error {errors.depart}
              div.ui-field(data-invalid={errors.ret ? "true" : null})
                label.ui-label(for="ft-return") Return
                input.ui-input#ft-return(type="date" min={depart} value=ret @input=setField("ret"))
                if errors.ret
                  p.ui-field-error {errors.ret}
            div.k-ft-pair
              div.ui-field
                span.ui-label Passengers
                div.k-ft-counter
                  button.ui-button.ui-button-outline.ui-button-icon#ft-minus(type="button" aria-label="Fewer passengers" disabled={!canMinus} @click=passengers(-1))
                    span.k-icon.k-ft-i-minus
                  span.k-ft-count#ft-count {passengers}
                  button.ui-button.ui-button-outline.ui-button-icon#ft-plus(type="button" aria-label="More passengers" disabled={!canPlus} @click=passengers(1))
                    span.k-icon.k-icon-plus
              fieldset.ui-toggle-group
                legend.ui-toggle-group-label Cabin
                div.ui-toggle-group-options
                  div.ui-toggle-option
                    input.ui-toggle-option-input#ft-economy(type="radio" name="ft-cabin" value="economy" checked={cabin === "economy"} @change=setField("cabin"))
                    label.ui-toggle-option-label(for="ft-economy") Economy
                  div.ui-toggle-option
                    input.ui-toggle-option-input#ft-business(type="radio" name="ft-cabin" value="business" checked={cabin === "business"} @change=setField("cabin"))
                    label.ui-toggle-option-label(for="ft-business") Business
            button.ui-button.ui-button-default#ft-search(type="submit")
              span.k-icon.k-icon-search
              | Search flights
      else if step === "results"
        div.k-ft-panel.k-ft-wide
          div.k-ft-summary
            p.k-ft-summary-route {routeLabel}
            p.k-hint {tripLabel} · {paxLabel} · {cabinLabel}
          ul.k-ft-flights
            for f in flights key f.id
              li
                button.k-ft-flight(type="button" class:is-selected={f.id === selectedId} aria-pressed={f.id === selectedId ? "true" : "false"} @click=pick(f.id))
                  span.k-ft-times
                    span.k-ft-time {f.depart}
                    span.k-ft-line
                      span.k-ft-line-label {f.durationLabel}
                    span.k-ft-time {f.arrive}
                    span.k-ft-next {f.nextDay}
                  span.k-ft-info
                    span.k-ft-airline {f.airline} · {f.number}
                    span.ui-badge.ui-badge-outline(class:ui-badge-success={f.stops === 0}) {f.stopsLabel}
                  span.k-ft-price
                    span.k-ft-total {f.totalLabel}
                    span.k-hint {f.unitLabel} each
          div.k-ft-actions
            button.ui-button.ui-button-outline#ft-back(type="button" @click=back) Back
            button.ui-button.ui-button-default#ft-continue(type="button" disabled={!chosen} @click=toDetails) Continue
      else if step === "details"
        form.k-ft-panel(novalidate @submit.prevent=confirm)
          div.ui-form
            div.k-ft-summary
              p.k-ft-summary-route {routeLabel}
              if chosen
                p.k-hint {chosen.airline} {chosen.number} · {chosen.depart} - {chosen.arrive} · {chosen.totalLabel}
            for row in nameRows key row.i
              div.ui-field(data-invalid={row.error ? "true" : null})
                label.ui-label(for="ft-name-{row.i}") {row.label}
                input.ui-input(id="ft-name-{row.i}" type="text" autocomplete="off" placeholder="As in the passport" value=row.value @input=setName(row.i))
                if row.error
                  p.ui-field-error {row.error}
            div.k-ft-actions
              button.ui-button.ui-button-outline#ft-back(type="button" @click=back) Back
              button.ui-button.ui-button-default#ft-confirm(type="submit") Confirm and book
      else
        div.k-ft-panel.k-ft-wide
          div.ui-alert.ui-alert-success
            span.ui-alert-icon
              span.k-icon.k-icon-check
            div.ui-alert-body
              p.ui-alert-title Booking confirmed
              div.ui-alert-description Your reference is {ticket.reference}. A copy of the ticket was sent to every passenger.
          if ticket
            div.k-ft-ticket
              div.k-ft-head
                span.k-ft-brand
                  span.k-icon.k-ft-i-plane
                  | Pavlus Air
                span.k-ft-cabin {ticket.cabin}
              div.k-ft-route
                div.k-ft-airport
                  span.k-ft-code {ticket.fromCity.code}
                  span.k-ft-city {ticket.fromCity.name}
                span.k-ft-path
                  span.k-icon.k-icon-lg.k-ft-i-plane
                div.k-ft-airport.k-ft-airport-end
                  span.k-ft-code {ticket.toCity.code}
                  span.k-ft-city {ticket.toCity.name}
              div.k-ft-facts
                div.k-ft-fact
                  span.k-ft-caption Flight
                  span.k-ft-fact-value {ticket.flight.number}
                div.k-ft-fact
                  span.k-ft-caption Date
                  span.k-ft-fact-value {ticket.departDate}
                div.k-ft-fact
                  span.k-ft-caption Departs
                  span.k-ft-fact-value {ticket.flight.depart}
                div.k-ft-fact
                  span.k-ft-caption Boarding
                  span.k-ft-fact-value {ticket.boarding}
                div.k-ft-fact
                  span.k-ft-caption Gate
                  span.k-ft-fact-value {ticket.gate}
                div.k-ft-fact
                  span.k-ft-caption Return
                  span.k-ft-fact-value {ticket.returnDate}
              div.k-ft-tear
              div.k-ft-stub
                ul.k-ft-seats
                  for seat in ticket.seats key seat.name
                    li
                      span.k-ft-seat-name {seat.name}
                      span.k-ft-seat {seat.seat}
                div.k-ft-codes
                  div.k-ft-qr
                    span.k-ft-finder.k-ft-finder-a
                    span.k-ft-finder.k-ft-finder-b
                    span.k-ft-finder.k-ft-finder-c
                    for cell in ticket.cells key cell.id
                      span.k-ft-cell(data-on={cell.on ? "true" : null})
                  div.k-ft-barcode
                    div.k-ft-bars
                      for bar in ticket.bars key bar.id
                        span.k-ft-bar(style="width: {bar.w}px")
                    span.k-ft-ref {ticket.reference}
          div.k-ft-actions
            button.ui-button.ui-button-outline#ft-back(type="button" @click=back) Back
            button.ui-button.ui-button-default#ft-restart(type="button" @click=restart) Book another flight
