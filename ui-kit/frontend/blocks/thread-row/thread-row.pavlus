import Row from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Thread list rows
    p.k-demo__note Pinned, solved, locked and hidden threads look different. A click opens the thread.
    div.k-preview.k-preview--column
      for thread in threads key thread.id
        +Row#row(...thread)
    p.k-hint
      | {last}
