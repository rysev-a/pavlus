// A pick list for the warehouse, to embed: a progress bar over a checklist in
// walking order. State = the props: `title`, `sub`, `progress` (progressOf
// from picks.ts), `lines` (walkOrder: { id, loc, sku, name, qty, qtyText,
// picked }) and `next` (the id of the line to pick next, or empty). A click on
// a line is sent as `<name>.toggle` with its id.
div.k-plk
  header.k-plk__head
    div.k-plk__titles
      strong {title}
      small {sub}
    span(class="ui-pill ui-pill-{progress.tone}") {progress.pct}%
  div(class="ui-progress k-plk__bar k-adm-t-{progress.tone}")
    div.ui-progress-indicator(style="width: {progress.pct}%")
  p.k-plk__text {progress.text}
  ul.k-plk__lines
    for line in lines key line.id
      li
        button(type="button" class="k-plk__line" class:k-plk__line--done={line.picked} class:k-plk__line--next={line.id === next} aria-pressed={line.picked ? "true" : "false"} @click=toggle(line.id))
          span.k-plk__box
            if line.picked
              span.k-icon.k-icon-check
          span.k-plk__loc {line.loc}
          span.k-plk__what
            strong {line.name}
            small {line.sku}
          span.k-plk__qty {line.qtyText}
  if lines.length === 0
    p.k-plk__empty There is nothing to pick.
