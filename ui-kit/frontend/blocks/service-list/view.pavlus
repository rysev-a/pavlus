// A menu of services with price and duration, to embed. State = the props:
// `rows`, a list of { id, name, note, emoji, priceLabel, durationLabel,
// selected } (build it with `serviceRows`). A click sends `pick(id)`.
ul.k-services(role="radiogroup" aria-label="Services")
  for row in rows key row.id
    li
      button.k-service(type="button" role="radio" aria-checked={row.selected ? "true" : "false"} class:is-selected={row.selected} @click=pick(row.id))
        span.k-service__emoji {row.emoji}
        span.k-service__text
          strong.k-service__name {row.name}
          span.k-service__note {row.note}
        span.k-service__meta
          strong.k-service__price {row.priceLabel}
          span.k-service__time
            span.k-icon.k-icon-clock
            | {row.durationLabel}
