// A data table (shadcn style), to embed. State = the props from `tableView()`
// in table.ts, plus `title`, `addLabel`, `placeholder`, `empty` and `readOnly`.
// Events, with the name of the embed in front: `search` (the input), `sort(key)`,
// `filter(key)` (a select), `toggleAll`, `toggleRow(id)`, `prev`, `next`,
// `goto(n)`, `pageSize` (a select), `add`, `edit(id)`, `remove(id)`,
// `removeSelected`.
div.k-ctable
  div.k-ctable__bar
    div.k-ctable__titles
      h2.k-ctable__title {title}
      p.k-ctable__count {all} in total
    if addLabel
      button.ui-button.ui-button-default.ui-button-sm(type="button" @click=add)
        span.k-icon.k-icon-plus
        | {addLabel}
  div.ui-data-table
    div.ui-data-toolbar
      div.ui-data-search
        span.k-icon.k-icon-search.k-ctable__searchicon
        input.ui-input(type="search" placeholder={placeholder} value={query} @input=search)
      for f in filters key f.key
        select.ui-select-control.k-ctable__filter(aria-label={f.label} @change=filter(f.key))
          for o in f.options key o.value
            option(value={o.value} selected={o.active}) {o.label}
      if selectedCount > 0
        button.ui-button.ui-button-outline.ui-button-sm.k-ctable__bulk(type="button" @click=removeSelected)
          span.k-icon.k-ai-trash
          | Delete {selectedCount}
    div.ui-data-scroll
      table
        thead
          tr
            th.ui-resource-check
              input.ui-data-check(type="checkbox" aria-label="Select all rows on this page" checked={allSelected} @change=toggleAll)
            for col in columns key col.key
              th(style="text-align: {col.align}")
                if col.sortable
                  button.ui-resource-sort(type="button" @click=sort(col.key)) {col.label}
                    span.k-icon.k-icon-chevrons-up-down(class:ui-sort-idle={!col.sorted})
                else
                  | {col.label}
            th.k-ctable__actionhead
        tbody
          if rows.length === 0
            tr
              td.ui-resource-empty(colspan={columns.length + 2}) {empty}
          for row in rows key row.id
            tr(data-selected={row.selected ? "true" : null})
              td.ui-resource-check
                input.ui-data-check(type="checkbox" aria-label="Select row" checked={row.selected} @change=toggleRow(row.id))
              for cell, i in row.cells key i
                td(style="text-align: {cell.align}")
                  if cell.kind === "pill"
                    span(class="ui-pill ui-pill-{cell.tone}") {cell.text}
                  else if cell.kind === "strong"
                    div.k-ctable__strong
                      strong {cell.text}
                      if cell.sub
                        small {cell.sub}
                  else if cell.kind === "mono"
                    span.k-ctable__mono {cell.text}
                  else if cell.kind === "number"
                    span.k-ctable__num {cell.text}
                  else
                    span {cell.text}
              td.k-ctable__actions
                button.ui-button.ui-button-ghost.ui-button-icon-sm(type="button" aria-label="Edit" @click=edit(row.id))
                  span.k-icon.k-ai-edit
                button.ui-button.ui-button-ghost.ui-button-icon-sm.k-ctable__danger(type="button" aria-label="Delete" @click=remove(row.id))
                  span.k-icon.k-ai-trash
    div.ui-resource-footer
      span {selectedCount} of {total} row(s) selected. Showing {range} of {total}.
      div.ui-data-footer-controls
        label.k-ctable__size
          span Rows
          select.ui-select-control(aria-label="Rows per page" @change=pageSize)
            for s in pageSizes key s.value
              option(value={s.value} selected={s.active}) {s.value}
        span Page {page} of {pages}
        div.ui-resource-pager
          button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={page <= 1} @click=prev) Previous
          for j in jumps key j.n
            button.ui-button.ui-button-sm.k-ctable__jump(type="button" class:ui-button-secondary={j.active} class:ui-button-ghost={!j.active} @click=goto(j.n)) {j.n}
          button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={page >= pages} @click=next) Next
