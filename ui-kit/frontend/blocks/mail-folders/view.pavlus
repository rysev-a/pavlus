// The sidebar of a mail client, to embed. State = the props: `folders`
// ([{ id, name, icon, count, active }]), `labels` ([{ id, name, hue, count,
// active }]) and `shortcuts` ([{ id, key, name }]), from mail-folders.ts.
// Events, with the name of the embed in front: `go` (the folder or label id),
// `compose` and `shortcut` (the shortcut id).
nav.k-mfold(aria-label="Mailbox")
  button.ui-button.ui-button-default.k-mfold__compose(type="button" @click=compose)
    span.k-icon.k-mi-edit
    | Compose
  ul.k-mfold__list
    for f in folders key f.id
      li
        button.k-mfold__item(type="button" class:is-active={f.active} aria-current={f.active ? "page" : null} @click=go(f.id))
          span.k-icon(class="{f.icon}")
          span.k-mfold__name {f.name}
          if f.count > 0
            span.k-mfold__count {f.count}
  p.k-mfold__heading Labels
  ul.k-mfold__list
    for l in labels key l.id
      li
        button.k-mfold__item(type="button" class:is-active={l.active} aria-current={l.active ? "page" : null} @click=go(l.id))
          span.k-mfold__dot(style="--k-hue: {l.hue}")
          span.k-mfold__name {l.name}
          if l.count > 0
            span.k-mfold__count {l.count}
  p.k-mfold__heading Shortcuts
  ul.k-mfold__keys
    for s in shortcuts key s.id
      li
        button.k-mfold__key(type="button" @click=shortcut(s.id))
          span.k-kbd {s.key}
          | {s.name}
