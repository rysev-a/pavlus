// An email, to embed. State = the props: `mail` (emailView(): { from, subject,
// preheader, headline, paragraphs, cta, layout, footer, emoji }). No events.
div.k-emailp
  div.k-emailp__meta
    div
      small From
      strong {mail.from}
    div
      small Subject
      strong {mail.subject}
    if mail.preheader
      p.k-emailp__pre {mail.preheader}
  div.k-emailp__page(data-layout={mail.layout})
    div.k-emailp__hero
      span.k-emailp__emoji {mail.emoji}
      h3.k-emailp__headline {mail.headline}
    div.k-emailp__body
      for para, i in mail.paragraphs key i
        p {para}
      span.ui-button.ui-button-default.k-emailp__cta {mail.cta}
    p.k-emailp__footer {mail.footer}
