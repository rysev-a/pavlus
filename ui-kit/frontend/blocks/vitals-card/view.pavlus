// A patient's vital signs, to embed. State = the props: `items` (readings() or
// vital() from vitals.ts) and an optional `heading`.
div.k-vit
  if heading
    h3.k-vit__heading {heading}
  div.k-vit__grid
    for v in items key v.id
      div(class="k-vit__item k-adm-t-{v.tone}")
        span.k-vit__label {v.label}
        div.k-vit__value
          strong {v.value}
          small {v.unit}
        div.k-vit__gauge(title="Normal {v.range} {v.unit}")
          span.k-vit__band(style="left: {v.bandLeft}%; width: {v.bandWidth}%")
          span.k-vit__marker(style="left: {v.pos}%")
        div.k-vit__foot
          span.k-vit__range {v.range}
          span(class="ui-pill ui-pill-{v.tone}") {v.flag}
