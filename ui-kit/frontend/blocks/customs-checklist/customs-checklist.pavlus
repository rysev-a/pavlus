import Checklist from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Import documents
    p.k-demo__note Click the button of a row to move it a step: missing, uploaded, approved.
    div.k-preview.k-preview--block
      +Checklist#list(rows=rows progress=progress readonly=false)
  section.k-demo
    h2.k-demo__title Read only
    div.k-preview.k-preview--block
      +Checklist#ro(rows=rows progress=progress readonly=true)
