// A developer's card, to embed: `+ProfileCard#card(...card)` where `card` comes
// from `cardOf` in profile-card.ts. State = id, name, initials, role, location,
// bio, skills ({ label, hit }), availability ("open" | "part" | "busy"),
// availabilityLabel, score (0-100 or null), scoreLevel, tone (1-5), invited,
// actionLabel. A click on the button reaches the parent as `<name>.invite`
// with the id.
article.ui-card.k-pc(class:k-pc--invited={invited})
  div.k-pc__top
    span.k-pc__avatar(data-tone=tone) {initials}
    div.k-pc__who
      h3.k-pc__name {name}
      p.k-pc__role {role}
    if score !== null
      div.k-pc__score(data-level=scoreLevel style="--pc-score: {score}")
        strong {score}%
        small match
  p.k-pc__bio {bio}
  ul.k-pc__skills
    for skill in skills key skill.label
      li.ui-badge(class:ui-badge-default={skill.hit} class:ui-badge-secondary={!skill.hit}) {skill.label}
  div.k-pc__foot
    div.k-pc__meta
      span.k-pc__avail(data-avail=availability) {availabilityLabel}
      span.k-pc__place
        span.k-icon.k-glyph(data-glyph="pin")
        | {location}
    button.ui-button.ui-button-sm(type="button" disabled={availability === "busy"} class:ui-button-default={!invited} class:ui-button-secondary={invited} @click=invite(id))
      if invited
        span.k-icon.k-icon-check
      | {actionLabel}
