// The info panel of a chat, to embed. State = the props: `info` (from
// `infoView` in info.ts: name, initials, hue, emoji, group, subtitle, about,
// muted, archived, canLeave, members, memberCount, pinned, files). Events,
// with the name of the embed in front: `close`, `mute`, `archive`, `leave`,
// `unpin` and `jump` (a message id) and `member` (a person id: open a chat).
aside.k-cinfo(aria-label="Chat info")
  div.k-cinfo__bar
    strong {info.group ? "Group info" : "Contact info"}
    button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Close the info panel" @click=close)
      span.k-icon.k-icon-x
  div.k-cinfo__scroll
    div.k-cinfo__hero
      if info.emoji
        span.k-mavatar.k-mavatar--lg.k-mavatar--emoji(style="--k-hue: {info.hue}") {info.emoji}
      else
        span.k-mavatar.k-mavatar--lg(style="--k-hue: {info.hue}") {info.initials}
      h3.k-cinfo__name {info.name}
      p.k-cinfo__sub {info.subtitle}
      if info.about
        p.k-cinfo__about {info.about}
    div.k-cinfo__toggles
      button.k-cinfo__toggle(type="button" aria-pressed={info.muted ? "true" : "false"} @click=mute)
        span.k-icon.k-mi-bell-off
        span.k-cinfo__toggle-text {info.muted ? "Muted" : "Mute notifications"}
        span.k-cinfo__switch
      button.k-cinfo__toggle(type="button" aria-pressed={info.archived ? "true" : "false"} @click=archive)
        span.k-icon.k-mi-archive
        span.k-cinfo__toggle-text {info.archived ? "Archived" : "Archive chat"}
        span.k-cinfo__switch
    section.k-cinfo__section
      h4.k-cinfo__heading
        span.k-icon.k-mi-pin
        | Pinned messages ({info.pinned.length})
      if info.pinned.length === 0
        p.k-cinfo__none Pin a message from the conversation to keep it here.
      else
        ul.k-cinfo__list
          for p in info.pinned key p.id
            li.k-cinfo__pin
              button.k-cinfo__pin-text(type="button" @click=jump(p.id))
                strong {p.who}
                span {p.text}
              button.k-cinfo__x(type="button" aria-label="Unpin" @click=unpin(p.id))
                span.k-icon.k-icon-x
    if info.files.length > 0
      section.k-cinfo__section
        h4.k-cinfo__heading
          span.k-icon.k-mi-clip
          | Shared files ({info.files.length})
        ul.k-cinfo__list
          for f in info.files key f.id
            li.k-cinfo__file
              span.k-cinfo__file-name {f.name}
              span.k-muted {f.sizeLabel} from {f.who}
    if info.group
      section.k-cinfo__section
        h4.k-cinfo__heading
          span.k-icon.k-mi-users
          | Members ({info.memberCount})
        ul.k-cinfo__list
          for m in info.members key m.id
            li
              button.k-cinfo__member(type="button" disabled={m.you} @click=member(m.id))
                span.k-mavatar.k-mavatar--sm(style="--k-hue: {m.hue}" data-online={m.online ? "true" : null}) {m.initials}
                span.k-cinfo__member-name {m.name}
                if m.role
                  span.ui-badge.ui-badge-secondary {m.role}
    if info.canLeave
      button.ui-button.ui-button-outline.k-cinfo__leave(type="button" @click=leave)
        span.k-icon.k-mi-log-out
        | Leave group
