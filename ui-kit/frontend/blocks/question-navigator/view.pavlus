// A grid of numbered buttons to jump between questions, to embed. State = the
// props: `items`, a list of { index, n, current, answered, flagged }
// (see `navItems`), and optionally `summary` { answered, flagged, left }.
// A click sends `go(index)` (`<id>.go` in a parent).
div.k-qnav
  div.k-qnav__grid(role="group" aria-label="Questions")
    for item in items key item.index
      button.k-qnav__item(type="button" aria-label={"Question " + item.n} aria-current={item.current ? "step" : null} class:is-current={item.current} class:is-answered={item.answered} class:is-flagged={item.flagged} @click=go(item.index)) {item.n}
  if summary
    p.k-qnav__legend
      span
        span.k-qnav__swatch.is-answered
        | {summary.answered} answered
      span
        span.k-qnav__swatch.is-flagged
        | {summary.flagged} flagged
      span
        span.k-qnav__swatch
        | {summary.left} open
