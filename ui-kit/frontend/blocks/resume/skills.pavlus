// Skills with level bars, to embed. State = the props: `skills`, a list of
// { name, level (0-100), label } (build them with `skill()` in resume.ts).
ul.k-skills
  for skill in skills key skill.name
    li.k-skills__row
      div.k-skills__head
        span.k-skills__name {skill.name}
        span.k-skills__label {skill.label}
      div.ui-progress.ui-progress-sm(role="progressbar" aria-label=skill.name aria-valuenow=skill.level aria-valuemin="0" aria-valuemax="100")
        div.ui-progress-indicator(style="width: {skill.level}%")
