// A job posting, to embed: `+Job#job(...job)`. State = id, title, company,
// companyId, emoji (the logo), tone (1-5), place, kind ("Full-time"), salary,
// ago, tags, saved, applied. Messages (`<name>.open` ...): open(id), save(id),
// apply(id), company(companyId).
article.ui-card.k-jobc
  span.k-jobc__logo(style="--t: var(--chart-{tone})") {emoji}
  div.k-jobc__body
    button.k-jobc__title(type="button" @click=open(id)) {title}
    button.k-jobc__company(type="button" @click=company(companyId)) {company}
    p.k-jobc__meta {place} · {kind} · {salary} · {ago}
    ul.k-jobc__tags
      for t in tags key t
        li.ui-badge.ui-badge-secondary {t}
  div.k-jobc__acts
    button.ui-button.ui-button-sm(type="button" disabled={applied} class:ui-button-default={!applied} class:ui-button-secondary={applied} @click=apply(id))
      if applied
        span.k-icon.k-icon-check
        | Applied
      else
        | Apply
    button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-pressed={saved ? "true" : "false"} @click=save(id))
      span.k-icon.k-glyph(data-glyph="star")
      | {saved ? "Saved" : "Save"}
