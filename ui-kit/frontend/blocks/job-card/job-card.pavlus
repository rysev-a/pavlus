import Job from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Job postings
    p.k-demo__note Apply turns the button into Applied for good; Save toggles.
    div.k-preview.k-preview--column
      for job in jobs key job.id
        +Job#job(...job)
    p.k-hint
      | {last}
