import Form from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A new habit
    p.k-demo__note Save with an empty name to see the check. Every choice shows in the preview.
    div.k-preview.k-preview--block
      div.k-hform-demo
        +Form#form(draft=draft errors=errors tones=tones icons=icons freqs=freqs editing=false)
        p.k-hform-demo__out {said}
