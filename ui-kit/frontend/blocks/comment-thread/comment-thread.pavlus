import Comments from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Comments
    p.k-demo__note Like a comment, or write one; the new comment goes to the end and the box clears.
    div.k-preview.k-preview--block
      div.k-narrow
        +Comments#cm(...thread)
    p.k-hint
      | {summary}
