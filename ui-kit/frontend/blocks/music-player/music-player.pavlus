section.k-page
  section.k-demo
    h2.k-demo__title Now playing
    div.k-preview.k-mp
      div.k-mp-main
        div.k-mp-cover(style="--hue: {hue}" class:is-playing={playing})
          span.k-icon.k-mp-note
          span.k-mp-disc
        div.k-mp-meta
          p.k-mp-title {title}
          p.k-mp-artist {artist}
          p.k-hint {album} · {position}
        div.k-mp-seek
          input.ui-slider-input#mp-seek(type="range" min="0" max={duration} step="1" value=elapsed aria-label="Seek" @input=seek)
          div.k-mp-times
            span {elapsedLabel}
            span {durationLabel}
        div.k-mp-controls
          button.ui-button.ui-button-ghost.ui-button-icon#mp-shuffle(type="button" class:is-on={shuffle} aria-pressed={shuffle ? "true" : "false"} aria-label="Shuffle" title="Shuffle" @click=shuffle)
            span.k-icon.k-mp-i-shuffle
          button.ui-button.ui-button-ghost.ui-button-icon#mp-prev(type="button" aria-label="Previous track" title="Previous" @click=prev)
            span.k-icon.k-icon-lg.k-mp-i-prev
          button.ui-button.ui-button-default.ui-button-icon-lg.k-mp-play#mp-play(type="button" aria-label={playing ? "Pause" : "Play"} @click=toggle)
            if playing
              span.k-icon.k-icon-lg.k-mp-i-pause
            else
              span.k-icon.k-icon-lg.k-mp-i-play
          button.ui-button.ui-button-ghost.ui-button-icon#mp-next(type="button" aria-label="Next track" title="Next" @click=next)
            span.k-icon.k-icon-lg.k-mp-i-next
          button.ui-button.ui-button-ghost.ui-button-icon#mp-repeat(type="button" class:is-on={repeat !== "off"} aria-label={repeatLabel} title={repeatLabel} @click=repeat)
            if repeat === "one"
              span.k-icon.k-mp-i-repeat-one
            else
              span.k-icon.k-mp-i-repeat
        div.k-mp-volume
          span.k-icon.k-mp-i-volume
          input.ui-slider-input#mp-volume(type="range" min="0" max="100" step="1" value=volume aria-label="Volume" @input=volume)
          span.k-mp-vol-label {volumeLabel}
      div.k-mp-list
        p.k-mp-list-title Up next
        ul.k-mp-tracks
          for row in rows key row.id
            li
              button.k-mp-row(type="button" class:is-active={row.active} @click=choose(row.id))
                span.k-mp-row-art(style="--hue: {row.hue}")
                  if row.playingNow
                    span.k-mp-bars
                      i
                      i
                      i
                  else
                    | {row.n}
                span.k-mp-row-text
                  span.k-mp-row-title {row.title}
                  span.k-mp-row-artist {row.artist}
                span.k-mp-row-len {row.length}
    p.k-hint Playback is simulated: while playing, a timer of the time plugin ticks once a second, and it is cancelled on pause and when you leave the page.
