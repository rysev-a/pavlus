// A kitchen board, to embed. State = the props: `columns` (boardOf from
// orders.ts: { id, title, count, tickets: [{ id, title, sub, lines, timer,
// tone, pct, next, stage }] }). Events, with the name of the embed in front:
// `advance` (ticket id: move it to the next column), `open` (ticket id).
div.k-obrd
  for col in columns key col.id
    section(class="k-obrd__col k-obrd__col--{col.id}")
      header.k-obrd__head
        h3.k-obrd__title {col.title}
        span.ui-badge.ui-badge-secondary {col.count}
      div.k-obrd__tickets
        for ticket in col.tickets key ticket.id
          article(class="k-obrd__ticket k-adm-t-{ticket.tone}" @click=open(ticket.id))
            header.k-obrd__top
              div.k-obrd__who
                strong {ticket.title}
                small {ticket.sub}
              span.k-obrd__timer {ticket.timer}
            div.ui-progress.ui-progress-sm.k-obrd__bar
              div.ui-progress-indicator(style="width: {ticket.pct}%")
            ul.k-obrd__lines
              for line in ticket.lines key line.id
                li
                  span {line.text}
                  if line.note
                    small {line.note}
            if ticket.next
              button.ui-button.ui-button-sm.ui-button-default.k-obrd__go(type="button" @click.stop=advance(ticket.id)) {ticket.next}
        if col.tickets.length === 0
          p.k-obrd__empty Nothing here
