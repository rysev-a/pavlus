import Cal from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A month with dots on the days that have entries
    p.k-demo__note Click a day to select it, again to clear it. The arrows change the month.
    div.k-preview.k-preview--block
      div.k-march-demo
        +Cal#cal(...archive)
        p.k-march-demo__out Selected: {picked}
