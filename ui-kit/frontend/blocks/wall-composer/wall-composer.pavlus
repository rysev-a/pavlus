import Composer from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Music
    div.k-preview.k-preview--block
      div.k-narrow
        +Composer#music(...music)
  section.k-demo
    h2.k-demo__title Picture
    div.k-preview.k-preview--block
      div.k-narrow
        +Composer#picture(...picture)
