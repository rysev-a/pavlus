import Photo from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Masonry grid
    p.k-demo__note Tall, square and wide tiles flow into columns. Like and save keep their state.
    div.k-preview.k-preview--block
      div.k-photogrid
        for photo in photos key photo.id
          +Photo#photo(...photo)
  section.k-demo
    h2.k-demo__title Large, with tags
    div.k-preview.k-preview--block
      div.k-narrow
        +Photo#big(...big)
    p.k-hint
      | {last}
