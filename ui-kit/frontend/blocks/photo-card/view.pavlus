// A photo, to embed: `+Photo#photo(...photo)` with `photoProps` from
// photo-card.ts. State = id, title, author, authorId, initials, tone, tone2 (1-5,
// the two colors of the gradient), emoji, shape ("tall", "square", "wide"),
// likes, liked, saved, large (the big version), tags (["#sunset", ...], shown
// when large). Messages (`<name>.open` ...): open(id), like(id), save(id),
// author(authorId), tag(tag).
article.k-photo(class:k-photo--large={large} data-shape={shape})
  div.k-photo__pic(style="--a: var(--chart-{tone}); --b: var(--chart-{tone2})")
    button.k-photo__open(type="button" aria-label="Open {title}" @click=open(id))
      span.k-photo__emoji {emoji}
    button.k-photo__save(type="button" aria-label={saved ? "Remove from saved" : "Save"} aria-pressed={saved ? "true" : "false"} class:is-on={saved} @click=save(id))
      span.k-icon.k-glyph(data-glyph="star")
  div.k-photo__foot
    strong.k-photo__title {title}
    div.k-photo__row
      button.k-photo__author(type="button" @click=author(authorId))
        span.k-photo__av(style="--t: var(--chart-{tone})") {initials}
        span.k-photo__name {author}
      button.k-photo__like(type="button" aria-label="Like" aria-pressed={liked ? "true" : "false"} class:is-on={liked} @click=like(id))
        span.k-icon.k-icon-heart(class:k-icon-heart-fill={liked})
        | {likes}
    if large
      div.k-photo__tags
        for t in tags key t
          button.ui-badge.ui-badge-secondary.k-photo__tag(type="button" @click=tag(t)) {t}
