import SearchBox from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Search with highlighted results
    p.k-demo__note Type "schema", "error" or "rule". The search is a pure function over the title and the text.
    div.k-preview.k-preview--block
      div.k-sb-demo
        +SearchBox#search(placeholder="Search the docs..." query=query open=open results=results total=total)
    if picked
      p.k-hint Opened: {picked}
