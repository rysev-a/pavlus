// The monthly heatmap of a habit tracker, made of boxes, to embed. State =
// the props: `title`, `weekdays`, `weeks` (heatWeeks() from habits.ts).
// Events: `<name>.prev` and `<name>.next` (the months).
div.k-hheat
  div.k-hheat__head
    button.ui-button.ui-button-ghost.ui-button-icon(type="button" aria-label="Previous month" @click=prev)
      span.k-icon.k-icon-chevron-left
    strong.k-hheat__title {title}
    button.ui-button.ui-button-ghost.ui-button-icon(type="button" aria-label="Next month" @click=next)
      span.k-icon.k-icon-chevron-right
  div.k-hheat__grid
    for name in weekdays key name
      span.k-hheat__wd {name}
    for week in weeks key week.key
      for cell in week.cells key cell.key
        if cell.blank
          span.k-hheat__blank
        else
          span.k-hheat__box(data-level={cell.level} data-future={cell.future ? "true" : null} data-off={cell.off ? "true" : null} title={cell.tip})
            small {cell.day}
  div.k-hheat__legend
    span Less
    for lvl in [0, 1, 2, 3, 4] key lvl
      span.k-hheat__box.k-hheat__box--key(data-level={lvl})
    span More
