// Projects on a time scale, with bars, progress and milestones, to embed.
// State = the props: `weeks` (weeksFrom), `rows` (timelineRows: { id, name,
// sub, left, width, pct, tone, marks }), `today` (percent from the left).
// Event, with the name of the embed in front: `pick` (the row id).
div.k-gantt(style="--today: {today}")
  div.k-gantt__row.k-gantt__head
    div.k-gantt__name Project
    div.k-gantt__lane
      for week in weeks key week.left
        span.k-gantt__week(style="left: {week.left}%; width: {week.width}%") {week.label}
  for row in rows key row.id
    div.k-gantt__row.k-gantt__item(@click=pick(row.id))
      div.k-gantt__name
        strong {row.name}
        small {row.sub}
      div.k-gantt__lane
        span(class="k-gantt__bar k-adm-t-{row.tone}" style="left: {row.left}%; width: {row.width}%")
          span.k-gantt__done(style="width: {row.pct}%")
          span.k-gantt__pct {row.pct}%
        for mark in row.marks key mark.label
          span.k-gantt__mark(class:is-done={mark.done} style="left: {mark.left}%" data-label={mark.label} title={mark.label})
  span.k-gantt__today
