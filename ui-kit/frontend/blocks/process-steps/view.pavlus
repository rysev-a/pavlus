// Numbered steps, to embed. State = the props: `steps`, a list of
// { title, text, note }, and `layout` ("column" lists them one under another).
ol.k-steps(class:k-steps--column={layout === "column"})
  for step, i in steps key step.title
    li.k-steps__item
      span.k-steps__num {i + 1}
      div.k-steps__body
        h3.k-steps__title {step.title}
        p.k-steps__text {step.text}
        if step.note
          span.ui-badge.ui-badge-secondary {step.note}
