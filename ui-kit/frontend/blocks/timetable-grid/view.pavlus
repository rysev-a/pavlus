// Columns by time slots, to embed. State = the props: `cols` (col() from
// timetable.ts), `rows` (buildGrid()) and an optional `corner` text. Events,
// with the name of the embed in front: `pick` (entry id) on a filled cell and
// `add` (column id, slot id) on an empty one.
div.k-ttg(style="--cols: {cols.length}")
  div.k-ttg__scroll
    div.k-ttg__grid
      div.k-ttg__row.k-ttg__head
        div.k-ttg__corner {corner}
        for c in cols key c.id
          div.k-ttg__colhead(class:k-ttg__colhead--today={c.today})
            strong {c.label}
            if c.sub
              small {c.sub}
      for row in rows key row.id
        div.k-ttg__row
          div.k-ttg__time
            strong {row.label}
            if row.sub
              small {row.sub}
          if row.isBreak
            div.k-ttg__break {row.note}
          else
            for cell in row.cells key cell.key
              if cell.kind === "empty"
                button.k-ttg__empty(type="button" class:k-ttg__empty--today={cell.today} aria-label="Add at {row.label}" @click=add(cell.col, cell.slot))
                  span.k-icon.k-icon-plus
              else
                button(type="button" class="k-ttg__entry k-adm-t-{cell.tone}" class:k-ttg__entry--cont={cell.kind === "cont"} class:k-ttg__entry--last={cell.last} @click=pick(cell.id))
                  if cell.kind === "entry"
                    strong {cell.title}
                    if cell.sub
                      small {cell.sub}
