// One question with its answers, to embed. State = the props (build them with
// `questionProps` in quiz-question.ts): number, total, text, multiple, hint,
// options ({ id, text, selected, mark }), reveal, verdict, explanation,
// flagged, canFlag. Sends `choose(optionId)` and `flag`.
article.k-question(data-verdict={verdict || null})
  header.k-question__head
    span.ui-badge.ui-badge-secondary Question {number} of {total}
    span.k-question__hint {hint}
    if canFlag
      button.ui-button.ui-button-ghost.ui-button-sm.k-question__flag(type="button" aria-pressed={flagged ? "true" : "false"} class:is-flagged={flagged} @click=flag)
        span.k-icon.k-icon-flag
        | {flagged ? "Flagged" : "Flag for review"}
  h3.k-question__text {text}
  div.k-question__options(role={multiple ? "group" : "radiogroup"})
    for option in options key option.id
      button.k-qopt(type="button" role={multiple ? "checkbox" : "radio"} aria-checked={option.selected ? "true" : "false"} class:is-selected={option.selected} data-mark={option.mark || null} @click=choose(option.id))
        span.k-qopt__box(class:k-qopt__box--round={!multiple})
          if option.selected
            span.k-icon.k-icon-check
        span.k-qopt__text {option.text}
        if option.mark === "correct"
          span.k-qopt__tag Correct
        else if option.mark === "wrong"
          span.k-qopt__tag Your answer
        else if option.mark === "missed"
          span.k-qopt__tag Right answer
  if reveal
    div.k-question__feedback
      strong.k-question__verdict
        if verdict === "correct"
          | Correct
        else if verdict === "skipped"
          | Skipped
        else
          | Not quite
      p.k-question__explain {explanation}
