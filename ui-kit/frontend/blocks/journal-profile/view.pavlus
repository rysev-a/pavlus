// A diary profile, to embed. State = the props: `profile` ({ name, handle,
// initials, hue, bio, location, since }) and `stats` ([{ label, value }]).
// The "Change userpic" button sends `<name>.shuffle`.
section.k-jprof
  div.k-jprof__top
    span.k-jprof__pic(style="--hue: {profile.hue}") {profile.initials}
    div.k-jprof__id
      h2.k-jprof__name {profile.name}
      p.k-jprof__handle @{profile.handle} · {profile.location}
      p.k-jprof__since Writing since {profile.since}
    button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=shuffle) Change userpic
  p.k-jprof__bio {profile.bio}
  dl.k-jprof__stats
    for stat in stats key stat.label
      div.k-jprof__stat
        dd {stat.value}
        dt {stat.label}
