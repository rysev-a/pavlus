// A grid of project cards, to embed as a child (it has its own state and
// messages: filter, open, close). State = see `ProjectGridState` in
// project-grid.ts: projects, categories, filter, shown, current, showFilters,
// details, heading.
section.k-pg
  if heading
    h2.k-pg__heading {heading}
  if showFilters
    div.k-pg__filters(role="group" aria-label="Filter projects")
      for cat in categories key cat.id
        button.ui-button.ui-button-sm(type="button" class:ui-button-default={cat.id === filter} class:ui-button-outline={cat.id !== filter} aria-pressed={cat.id === filter ? "true" : "false"} @click=filter(cat.id))
          | {cat.label}
          span.k-pg__count {cat.count}
  div.k-pg__grid
    for project in shown key project.key
      article.k-pg__card
        if details
          button.k-pg__cover(type="button" data-tone=project.tone data-layout=project.layout aria-label="Open {project.title}" @click=open(project.key))
            span.k-pg__mock
            span.k-pg__emoji {project.emoji}
        else
          div.k-pg__cover(data-tone=project.tone data-layout=project.layout)
            span.k-pg__mock
            span.k-pg__emoji {project.emoji}
        div.k-pg__body
          p.k-pg__category {project.category} / {project.year}
          h3.k-pg__title {project.title}
          p.k-pg__summary {project.summary}
          div.k-pg__tags
            for tag in project.tags key tag
              span.ui-badge.ui-badge-secondary {tag}
          div.k-pg__links
            if details
              button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=open(project.key)) Details
            a.ui-button.ui-button-outline.ui-button-sm(href=project.link target="_blank" rel="noreferrer")
              | {project.linkLabel}
              span.k-icon.k-pg-icon-external
  if shown.length === 0
    p.k-pg__empty Nothing in this category yet.
  if current
    div.k-pg__overlay
      div.k-pg__scrim(@click=close)
      div.k-pg__detail#pg-detail(role="dialog" aria-modal="true" aria-label=current.title tabindex="-1" @keydown=key)
        div.k-pg__cover.k-pg__cover--wide(data-tone=current.tone data-layout=current.layout)
          span.k-pg__mock
          span.k-pg__emoji {current.emoji}
        button.ui-button.ui-button-secondary.ui-button-icon-sm.k-pg__x(type="button" aria-label="Close" @click=close)
          span.k-icon.k-icon-x
        div.k-pg__detail-body
          p.k-pg__category {current.category} / {current.year}
          h2.k-pg__detail-title {current.title}
          p.k-pg__description {current.description}
          dl.k-pg__facts
            div
              dt Role
              dd {current.role}
            div
              dt Year
              dd {current.year}
          p.k-pg__tools-title Tools
          div.k-pg__tags
            for tool in current.tools key tool
              span.ui-badge.ui-badge-outline {tool}
          div.k-pg__detail-actions
            a.ui-button.ui-button-default(href=current.link target="_blank" rel="noreferrer")
              | {current.linkLabel}
              span.k-icon.k-pg-icon-external
            button.ui-button.ui-button-outline(type="button" @click=close) Close
