import Summary from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A day, with targets
    p.k-demo__note The dark tick on a bar is the target; a category past its target turns red.
    div.k-preview.k-preview--block
      +Summary#day(...day)
  section.k-demo
    h2.k-demo__title A week
    div.k-preview.k-preview--block
      +Summary#week(...week)
