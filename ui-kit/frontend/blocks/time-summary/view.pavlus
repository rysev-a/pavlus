// Time per category, to embed. State = the props from summaryView() in
// summary.ts: `title`, `total`, `stack` ([{ id, tone, width, name }]) and
// `rows` ([{ id, name, tone, text, share, bar, target, mark, over }]). Tones
// are c1..c5, pr, de as in the week calendar. No events.
div.k-tsum
  div.k-tsum__head
    h3.k-tsum__title {title}
    strong.k-tsum__total {total}
  div.k-tsum__stack(role="img" aria-label="Share of each category")
    for part in stack key part.id
      span(class="k-tsum__part k-wcal-c-{part.tone}" style="width: {part.width}%" title={part.name})
  ul.k-tsum__rows
    for row in rows key row.id
      li(class="k-tsum__row k-wcal-c-{row.tone}" class:is-over={row.over})
        div.k-tsum__line
          span.k-tsum__name
            i.k-tsum__dot
            | {row.name}
          span.k-tsum__value {row.text}
            small {row.target ? row.target : row.share + "%"}
        div.k-tsum__track
          span.k-tsum__bar(style="width: {row.bar}%")
          if row.mark >= 0
            span.k-tsum__mark(style="left: {row.mark}%")
    if rows.length === 0
      li.k-tsum__none Nothing logged in this period.
