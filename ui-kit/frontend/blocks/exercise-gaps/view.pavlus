// A fill-in-the-gaps exercise, to embed. State = the props (from `gapProps` in
// gaps.ts): prompt, code, locked and segments ({ id, kind: text | gap | br,
// text, value, width, mark }). Sends `fill(gapId)` on every keystroke (the
// text is in the event).
div.k-exg
  p.k-exg__prompt {prompt}
  div(class="k-exg__body" class:is-code={code})
    for seg in segments key seg.id
      if seg.kind === "br"
        br
      else if seg.kind === "gap"
        input.k-exg__gap(type="text" value=seg.value size={seg.width} data-mark={seg.mark || null} disabled={locked} autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Gap" @input=fill(seg.id))
      else
        span.k-exg__text {seg.text}
