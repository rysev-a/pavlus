import Grid from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Two zones, three aisles each
    div.k-preview.k-preview--block
      div.k-row
        input.ui-input(type="search" placeholder="Search a product or a place" aria-label="Search" value=query @input=search style="max-width: 18rem")
      +Grid#grid(zones=zones)
    p.k-demo__note {message}
