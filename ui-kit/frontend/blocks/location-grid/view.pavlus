// A map of storage places, to embed: zones, each with its aisles as rows of
// bays. State = the props: `zones` (zonesOf from locations.ts). The fill of a
// bay is drawn from the bottom. A click on a bay is sent as `<name>.pick`
// with its code (`A-02-05`).
div.k-lgrid
  div.k-lgrid__scale
    span Empty
    span.k-lgrid__ramp
    span Full
    span.k-lgrid__markkey
      span.k-lgrid__mark
      | Low stock
  for zone in zones key zone.id
    section.k-lgrid__zone
      header.k-lgrid__head
        div.k-lgrid__zonename
          strong {zone.name}
          small {zone.sub}
        span(class="ui-pill ui-pill-{zone.tone}") {zone.fill}
      div.k-lgrid__aisles
        for aisle in zone.aisles key aisle.id
          div.k-lgrid__aisle
            span.k-lgrid__aislename {aisle.label}
            div.k-lgrid__bays
              for cell in aisle.cells key cell.id
                button(type="button" class="k-lgrid__cell" class:k-lgrid__cell--empty={cell.empty} class:k-lgrid__cell--dim={cell.dim} data-selected={cell.selected ? "true" : null} style="--fill: {cell.pct}%" title=cell.title aria-label=cell.title @click=pick(cell.id))
                  span.k-lgrid__bay {cell.bay}
                  if cell.mark
                    span.k-lgrid__mark
