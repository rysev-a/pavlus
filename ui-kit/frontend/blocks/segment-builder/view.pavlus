// A rule builder for an audience, to embed. State = the props: `rules`
// (ruleViews(): { id, kind, fields, ops, values, value, placeholder }),
// `all` (true: every rule must match, false: any), `count`, `total`, `pct`
// and `text` (the summary()). Events, with the name of the embed in front:
// `setfield`, `setop`, `setvalue` (each with the rule id; the value is in the
// event), `add`, `remove` (rule id) and `setmode` (the select).
div.k-segb
  div.k-segb__mode
    span Match
    select.ui-select-control(aria-label="Match all or any rule" @change=setmode)
      option(value="all" selected={all}) all of
      option(value="any" selected={!all}) any of
    span these rules
  div.k-segb__rules
    for rule in rules key rule.id
      div.k-segb__rule
        select.ui-select-control(aria-label="Field" @change=setfield(rule.id))
          for f in rule.fields key f.value
            option(value=f.value selected={f.selected}) {f.label}
        select.ui-select-control(aria-label="Operator" @change=setop(rule.id))
          for o in rule.ops key o.value
            option(value=o.value selected={o.selected}) {o.label}
        if rule.kind === "choice"
          select.ui-select-control(aria-label="Value" @change=setvalue(rule.id))
            for v in rule.values key v.value
              option(value=v.value selected={v.selected}) {v.label}
        else
          input.ui-input(aria-label="Value" type={rule.kind === "number" ? "number" : "text"} placeholder=rule.placeholder value=rule.value @input=setvalue(rule.id))
        button.ui-button.ui-button-ghost.ui-button-icon-sm(type="button" aria-label="Remove rule" @click=remove(rule.id))
          span.k-icon.k-icon-x
    if rules.length === 0
      p.k-segb__empty No rules, so everybody is in.
  button.ui-button.ui-button-outline.ui-button-sm.k-segb__add(type="button" @click=add)
    span.k-icon.k-icon-plus
    | Add a rule
  div.k-segb__result
    div.k-segb__count
      strong {count}
      span of {total} people
    div.ui-progress.k-segb__bar
      div.ui-progress-indicator(style="width: {pct}%")
    small {text}
