// Skills and endorsements, to embed: `+Skills#skills(...skills)`. State = title,
// own (true on my own profile: no buttons), skills ({ id, name, count, share
// (0-100, the width of the bar), endorsed, who (text) }). A click sends
// `endorse(id)` (`<name>.endorse`).
section.ui-card.k-endorse
  h3.k-endorse__title {title}
  ul.k-endorse__list
    for s in skills key s.id
      li.k-endorse__item
        div.k-endorse__text
          strong.k-endorse__name {s.name}
          span.k-endorse__who {s.who}
          div.k-endorse__bar
            span(style="width: {s.share}%")
        div.k-endorse__side
          span.k-endorse__count {s.count}
          if !own
            button.ui-button.ui-button-sm(type="button" aria-pressed={s.endorsed ? "true" : "false"} class:ui-button-outline={!s.endorsed} class:ui-button-secondary={s.endorsed} @click=endorse(s.id))
              if s.endorsed
                span.k-icon.k-icon-check
                | Endorsed
              else
                span.k-icon.k-icon-plus
                | Endorse
