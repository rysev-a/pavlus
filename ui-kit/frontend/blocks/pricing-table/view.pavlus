// The plans with a monthly / yearly switch. A part with its own state (see
// pricing-table.ts): embed it as a child, `+Pricing#pricing(...pricing)`.
// State: yearly, discount, ctaHref, plans, cards. A click on a plan's button
// reaches the parent as `pricing.choose` with the plan id.
section.k-pricing
  div.k-pricing__switch
    div.ui-tabs-list(role="tablist" aria-label="Billing period")
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={yearly ? "false" : "true"} @click=setBilling("monthly")) Monthly
      button.ui-tabs-trigger(type="button" role="tab" aria-selected={yearly ? "true" : "false"} @click=setBilling("yearly"))
        | Yearly
        span.ui-badge.ui-badge-success.k-pricing__save Save {discount}%
  div.k-pricing__grid
    for card in cards key card.id
      article.k-pricing__card(class:k-pricing__card--featured={card.featured})
        if card.featured
          span.ui-badge.ui-badge-default.k-pricing__flag Most popular
        h3.k-pricing__name {card.name}
        p.k-pricing__blurb {card.blurb}
        p.k-pricing__price
          span.k-pricing__amount {card.price}
          span.k-pricing__per {card.per}
        p.k-pricing__billed {card.billed}
        a.ui-button.ui-button-lg(class:ui-button-default={card.featured} class:ui-button-outline={!card.featured} href=ctaHref @click=choose(card.id)) {card.cta}
        ul.k-pricing__features
          for feature in card.features key feature
            li
              span.k-icon.k-icon-check
              span {feature}
