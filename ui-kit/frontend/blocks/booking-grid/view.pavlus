// The rooms by days grid, to embed. State = the props: `days` (daysFrom) and
// `rows` (gridRows: { id, name, kind, segs }). A seg is a free day or a
// booking bar that spans some days. Events, with the name of the embed in
// front: `book` (room id, day index) on a free day, `open` (booking id).
div.k-bgrid(style="--days: {days.length}")
  div.k-bgrid__scroll
    div.k-bgrid__table
      div.k-bgrid__row.k-bgrid__head
        div.k-bgrid__room Room
        for day in days key day.i
          div.k-bgrid__day(class:k-bgrid__day--weekend={day.weekend} class:k-bgrid__day--today={day.today})
            small {day.dow}
            strong {day.num}
      for row in rows key row.id
        div.k-bgrid__row
          div.k-bgrid__room
            strong {row.name}
            small {row.kind}
          for seg in row.segs key seg.key
            if seg.kind === "free"
              button(type="button" class="k-bgrid__free k-bgrid__free--{seg.mark}" aria-label="Book room {row.name}, day {seg.day + 1}" @click=book(row.id, seg.day))
            else
              button(type="button" class="k-bgrid__booking k-adm-t-{seg.tone}" class:k-bgrid__booking--cutl={seg.cutLeft} style="grid-column: span {seg.span}" @click=open(seg.id))
                strong {seg.label}
                small {seg.sub}
