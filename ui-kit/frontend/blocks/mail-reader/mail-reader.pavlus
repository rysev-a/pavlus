import Reader from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A conversation
    p.k-demo__note Click a message header to expand or collapse it. Unread messages and the last one open by themselves.
    div.k-preview.k-preview--block
      div.k-mread-demo
        +Reader#read(thread=thread actions=actions)
      if last
        p.k-hint {last}
  section.k-demo
    h2.k-demo__title Nothing selected
    div.k-preview.k-preview--block
      div.k-mread-demo.k-mread-demo--short
        +Reader#empty(thread=none actions=actions)
