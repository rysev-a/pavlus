import Card from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A card for every status
    p.k-demo__note Press Start, Stop or Reboot: the card passes through Starting or Stopping (a timer from the time plugin) and settles. Delete takes the machine away after a moment.
    div.k-preview.k-preview--block
      div.k-vmcd
        for card in cards key card.id
          +Card#card(...card)
      p.k-demo__note {last}
