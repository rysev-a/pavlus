// A virtual machine as a card, to embed. State = the props (from `cardOf` in
// vm.ts): id, name, emoji, osLabel, status, statusLabel, tone, pill, busy, vcpu,
// ram, disk, regionLabel, flag, ip, price, monthly, tags, buttons ([{ id,
// label, icon, variant }]), selected. Events, with the name of the embed in
// front: `open` (the machine id) and `act` (machine id, action id).
article(class="k-vmc k-adm-t-{tone}" class:is-selected={selected} data-status={status} data-busy={busy ? "true" : null})
  header.k-vmc__head
    span.k-vmc__os {emoji}
    div.k-vmc__titles
      button.k-vmc__name(type="button" @click=open(id)) {name}
      small {osLabel}
    span(class="ui-pill ui-pill-{pill} k-vmc__status")
      span.k-vmc__dot
      | {statusLabel}
  dl.k-vmc__specs
    div
      dt vCPU
      dd {vcpu}
    div
      dt Memory
      dd {ram}
    div
      dt Disk
      dd {disk}
  div.k-vmc__meta
    span.k-vmc__region {flag} {regionLabel}
    code.k-vmc__ip {ip}
  div.k-vmc__price
    strong {price}
    small {monthly}
  if tags.length > 0
    div.k-vmc__tags
      for tag in tags key tag
        span.ui-badge.ui-badge-secondary {tag}
  div.k-vmc__actions
    for button in buttons key button.id
      button(type="button" class="ui-button ui-button-sm ui-button-{button.variant}" @click=act(id, button.id))
        span(class="k-icon {button.icon}")
        | {button.label}
    if busy
      span.k-vmc__wait Working...
