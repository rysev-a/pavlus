import Post from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Posts
    p.k-demo__note Like, comment and share keep counts in the state. A post may carry a mood and a photo tile.
    div.k-preview.k-preview--column
      for post in posts key post.id
        +Post#post(...post)
    p.k-hint
      | {last}
