// A note in a text, to embed. State = the props: `tone` ("note", "tip",
// "warning" or "danger"), `title` and `text`.
div.ui-alert.k-callout(class:ui-alert-info={tone === "note"} class:ui-alert-success={tone === "tip"} class:ui-alert-warning={tone === "warning"} class:ui-alert-danger={tone === "danger"} role="note")
  span.ui-alert-icon
    if tone === "tip"
      span.k-icon.k-icon-check
    else if tone === "warning"
      span.k-icon.k-icon-alert
    else if tone === "danger"
      span.k-icon.k-icon-x
    else
      span.k-icon.k-icon-info
  div.ui-alert-body
    p.ui-alert-title {title}
    div.ui-alert-description {text}
