section.k-page
  section.k-demo
    h2.k-demo__title Sign in and register
    div.k-preview.k-auth
      div.ui-card
        div.ui-card-header
          h3.ui-card-title Sign in
          p.ui-card-description Enter your email and password to continue.
        form.ui-card-content(novalidate @submit.prevent=submitSignin)
          div.ui-form
            if signin.done
              div.ui-alert.ui-alert-success
                span.ui-alert-icon
                  span.k-icon.k-icon-check
                div.ui-alert-body
                  p.ui-alert-title Welcome back
                  div.ui-alert-description Signed in as {signin.email}.
            div.ui-field(data-invalid={signin.errors.email ? "true" : null})
              label.ui-label(for="si-email") Email
              input.ui-input#si-email(type="email" placeholder="m@example.com" value=signin.email @input=setField("signin", "email"))
              if signin.errors.email
                p.ui-field-error {signin.errors.email}
            div.ui-field(data-invalid={signin.errors.password ? "true" : null})
              div.k-row(style="justify-content: space-between")
                label.ui-label(for="si-password") Password
                a.ui-button.ui-button-link.ui-button-xs(href="#forgot") Forgot password?
              input.ui-input#si-password(type="password" value=signin.password @input=setField("signin", "password"))
              if signin.errors.password
                p.ui-field-error {signin.errors.password}
            div.ui-checkbox
              input.ui-checkbox-input#si-remember(type="checkbox" checked={signin.remember} @change=setField("signin", "remember"))
              label.ui-checkbox-label(for="si-remember") Remember me
            button.ui-button.ui-button-default(type="submit") Sign in
            button.ui-button.ui-button-outline(type="button")
              span.k-icon.k-icon-user
              | Continue with GitHub
      div.ui-card
        div.ui-card-header
          h3.ui-card-title Create an account
          p.ui-card-description It takes less than a minute.
        form.ui-card-content(novalidate @submit.prevent=submitRegister)
          div.ui-form
            if register.done
              div.ui-alert.ui-alert-success
                span.ui-alert-icon
                  span.k-icon.k-icon-check
                div.ui-alert-body
                  p.ui-alert-title Account created
                  div.ui-alert-description Check {register.email} to confirm your address.
            div.ui-field(data-invalid={register.errors.name ? "true" : null})
              label.ui-label(for="rg-name") Full name
              input.ui-input#rg-name(type="text" placeholder="Ann Lee" value=register.name @input=setField("register", "name"))
              if register.errors.name
                p.ui-field-error {register.errors.name}
            div.ui-field(data-invalid={register.errors.email ? "true" : null})
              label.ui-label(for="rg-email") Email
              input.ui-input#rg-email(type="email" placeholder="m@example.com" value=register.email @input=setField("register", "email"))
              if register.errors.email
                p.ui-field-error {register.errors.email}
            div.ui-field(data-invalid={register.errors.password ? "true" : null})
              label.ui-label(for="rg-password") Password
              input.ui-input#rg-password(type="password" value=register.password @input=setField("register", "password"))
              if register.errors.password
                p.ui-field-error {register.errors.password}
              else
                p.ui-field-description At least 8 characters.
            div.ui-field(data-invalid={register.errors.confirm ? "true" : null})
              label.ui-label(for="rg-confirm") Confirm password
              input.ui-input#rg-confirm(type="password" value=register.confirm @input=setField("register", "confirm"))
              if register.errors.confirm
                p.ui-field-error {register.errors.confirm}
            div.ui-field(data-invalid={register.errors.terms ? "true" : null})
              div.ui-checkbox
                input.ui-checkbox-input#rg-terms(type="checkbox" checked={register.terms} @change=setField("register", "terms"))
                label.ui-checkbox-label(for="rg-terms") I accept the terms and conditions
              if register.errors.terms
                p.ui-field-error {register.errors.terms}
            button.ui-button.ui-button-default(type="submit") Create account
