// A stack of links, to embed. State = the props: `links`, a list of
// { title, note, href }.
ul.k-linklist
  for link in links key link.href
    li
      a.k-linklist__item(href=link.href target="_blank" rel="noreferrer")
        span.k-linklist__text
          strong {link.title}
          span.k-linklist__note {link.note}
        span.k-icon.k-icon-chevron-right
