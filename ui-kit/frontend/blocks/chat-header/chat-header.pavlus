import Head from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Chat header
    p.k-demo__note The subtitle follows the chat: online, typing, or the member count. A pinned message shows as a banner. The back button only appears on small screens.
    div.k-preview.k-preview--block
      div.k-chead-demo
        +Head#head(header=header)
      div.k-row
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=typing) Toggle typing
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=switchChat("lena")) Show a direct chat
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=switchChat("hike")) Show a group
        if note
          span.k-hint {note}
