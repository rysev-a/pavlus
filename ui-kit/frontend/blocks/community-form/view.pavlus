// A form for a community, to embed: `+Form#form(...form)`. State = heading, saveLabel, name, description,
// errors ({ name, description }), covers ({ i, style, glyph, selected }), canCancel. Events (with the name of
// the embed in front): setName, setDescription, pickWallpaper(i), save, cancel.
div.ui-card.k-cfrm
  h3.k-cfrm__title {heading}
  div.ui-field(data-invalid={errors.name ? "true" : null})
    label.ui-field-label Name
      span.k-cfrm__req  *
    input.ui-input(type="text" placeholder="Hikers of the North" autocomplete="off" aria-invalid={errors.name ? "true" : null} value={name} @input=setName)
    if errors.name
      p.ui-field-error {errors.name}
  div.ui-field(data-invalid={errors.description ? "true" : null})
    label.ui-field-label Description
    textarea.ui-textarea-control.k-cfrm__text(rows="3" placeholder="What is this community about?" aria-invalid={errors.description ? "true" : null} value={description} @input=setDescription)
    if errors.description
      p.ui-field-error {errors.description}
  div.ui-field
    label.ui-field-label Wallpaper
    div.k-cfrm__covers
      for c in covers key c.i
        button.k-cfrm__cover(type="button" aria-label="Choose this wallpaper" aria-pressed={c.selected ? "true" : "false"} class:is-on={c.selected} style={c.style} @click=pickWallpaper(c.i)) {c.glyph}
  div.k-cfrm__foot
    span.k-cfrm__spacer
    if canCancel
      button.ui-button.ui-button-outline(type="button" @click=cancel) Cancel
    button.ui-button.ui-button-default(type="button" @click=save) {saveLabel}
