import Inbox from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Inbox
    p.k-demo__note Search filters the rows, a click opens a conversation and clears its unread count.
    div.k-preview.k-preview--block
      div.k-narrow
        +Inbox#inbox(...inbox)
    p.k-hint
      | Open: {openName}
