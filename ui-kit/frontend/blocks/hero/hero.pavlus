import Hero from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Centered
    div.k-preview.k-preview--block
      +Hero#centered(eyebrow="New" title="Build pure applications" text="Application code is a pure function, everything else is a plugin." primaryLabel="Get started" primaryHref="#start" secondaryLabel="Read the docs" secondaryHref="#docs" align="center")
  section.k-demo
    h2.k-demo__title Left aligned
    div.k-preview.k-preview--block
      +Hero#left(title="Hi, I am Ann" text="I build things for the web." primaryLabel="See my work" primaryHref="#work")
