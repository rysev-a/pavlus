import Wizard from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Create a virtual machine
    p.k-demo__note The price at the bottom follows every choice: the size, the region, the image's licence, the public IP and the backups. "web-frontend-01" is already taken, to show the validation.
    div.k-preview.k-preview--block
      +Wizard#wiz(...wiz)
      if created
        p.k-demo__note
          span.ui-pill.ui-pill-success Created
          |  {created}
