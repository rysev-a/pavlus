import Cal from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title A week of blocks
    div.k-preview.k-preview--block
      +Cal#cal(days=days hours=hours rows=rows)
    p.k-demo__note {message}
  section.k-demo
    h2.k-demo__title How to use it
    p.k-demo__note weekView() in week.ts takes the blocks (a day, a start in minutes, a length) and gives the columns: overlapping blocks share the width of the day, the line marks the time now. The tone of a block is c1 to c5, pr or de.
