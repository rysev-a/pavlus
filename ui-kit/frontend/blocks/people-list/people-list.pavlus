import People from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Follow suggestions
    p.k-demo__note The button toggles between Follow and Following.
    div.k-preview.k-preview--block
      div.k-narrow
        +People#follow(...follow)
  section.k-demo
    h2.k-demo__title Invitations with two buttons
    p.k-demo__note Accept or ignore: both take the person off the list.
    div.k-preview.k-preview--block
      div.k-narrow
        +People#invites(...invites)
    p.k-hint
      | {summary}
