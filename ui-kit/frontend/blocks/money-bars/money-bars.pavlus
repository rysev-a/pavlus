import MoneyBars from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Income, expenses and profit
    div.k-preview.k-preview--block
      +MoneyBars#year(months=year legend=legend)
    p.k-demo__note A loss grows down from the zero line. Hover a bar for its value.
  section.k-demo
    h2.k-demo__title Two bars, six months, shorter
    div.k-preview.k-preview--block
      +MoneyBars#half(months=half legend=halfLegend flat=true height="180px")
