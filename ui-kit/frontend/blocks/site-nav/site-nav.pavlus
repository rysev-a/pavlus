// The demo passes `links` from the page's state: lists are data, not literals.
import SiteNav from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title With links and a button
    div.k-preview.k-preview--block
      +SiteNav#nav(brand="Pavlus" links=links ctaLabel="Sign up" ctaHref="#signup")
  section.k-demo
    h2.k-demo__title Brand only
    div.k-preview.k-preview--block
      +SiteNav#plain(brand="Ann Lee" links=none)
