// A timer with a category and a note, to embed. State = the props from
// trackerView() in tracker.ts: `running`, `clock`, `now`, `note`, `fast`,
// `categories` ([{ id, name, tone, active }]), `entries` ([{ id, title, tone,
// cat, time, dur }]) and `total`. Events, with the name of the embed in front:
// `start`, `stop`, `pickcat` (the category id), `setnote` (the input), `setfast` (the
// switch).
div.ui-card.k-ttrack
  div.k-ttrack__top
    div.k-ttrack__time
      span.k-ttrack__label {running ? "Tracking since " + now : "Not tracking"}
      strong.k-ttrack__clock(class:is-running={running}) {clock}
    if running
      button.ui-button.ui-button-destructive(type="button" @click=stop)
        span.k-icon.k-ai-stop
        | Stop
    else
      button.ui-button.ui-button-default(type="button" @click=start)
        span.k-icon.k-ai-play
        | Start
  div.k-ttrack__cats(role="group" aria-label="Category")
    for c in categories key c.id
      button(type="button" class="k-ttrack__cat k-wcal-c-{c.tone}" class:is-active={c.active} aria-pressed={c.active ? "true" : "false"} @click=pickcat(c.id))
        span.k-ttrack__dot
        | {c.name}
  input.ui-input(type="text" placeholder="What are you working on?" aria-label="Note" value=note @input=setnote)
  div.ui-checkbox.k-ttrack__fast
    input.ui-checkbox-input#ttrack-fast(type="checkbox" checked={fast} @change=setfast)
    label.ui-checkbox-label(for="ttrack-fast") Demo speed: one second counts as a minute
  div.k-ttrack__loghead
    strong Today
    span.k-ttrack__total {total} tracked
  ul.k-ttrack__log
    for entry in entries key entry.id
      li.k-ttrack__entry(class="k-wcal-c-{entry.tone}")
        span.k-ttrack__dot
        div.k-ttrack__what
          strong {entry.title}
          small {entry.cat}, {entry.time}
        span.k-ttrack__dur {entry.dur}
    if entries.length === 0
      li.k-ttrack__none Nothing tracked yet. Press Start.
