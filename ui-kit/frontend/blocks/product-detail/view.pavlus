// A product in full: a big cover, the text, facts, an optional swatch picker and
// the add button. To embed (in a dialog or on a page). State = the props (see
// `detailOf` in product-detail.ts): everything of a card, and facts, points,
// hasPicker, picker. Messages: add(id), close, and the picker's picker.color
// and picker.size.
import Picker from "../swatch-picker/view.pavlus"

article.k-detail
  div.k-detail__cover(style="--hue: {hue}")
    span.k-detail__emoji {emoji}
    if badge
      span.k-detail__badge(class="ui-badge ui-badge-{badgeTone}") {badge}
  div.k-detail__info
    if kicker
      span.k-detail__kicker {kicker}
    h2.k-detail__title {title}
    if hasRating
      div.k-detail__rating
        span.k-detail__stars(aria-hidden="true") {stars}
        span {ratingLabel}
    p.k-detail__blurb {blurb}
    if hasPicker
      +Picker#picker(...picker)
    if points.length > 0
      ul.k-detail__points
        for point in points key point
          li
            span.k-icon.k-icon-check
            | {point}
    if facts.length > 0
      dl.k-detail__facts
        for fact in facts key fact.label
          div
            dt {fact.label}
            dd {fact.value}
    if chips.length > 0
      div.k-detail__chips
        for chip in chips key chip
          span.ui-badge.ui-badge-outline {chip}
    div.k-detail__buy
      div.k-detail__price
        strong {priceLabel}
        if wasLabel
          s {wasLabel}
      button.ui-button.ui-button-default.ui-button-lg(type="button" disabled={disabled} @click=add(id)) {addLabel}
    if note
      span.k-detail__note {note}
