// A compact table, to embed. State = the props: `columns` (from columnsOf),
// `rows` (from rowOf: { id, selected, cells, actions }), `empty` (the text
// when there are no rows), `footer` (a line under the table) and `pickable`
// (a click on a row is sent). Events, with the name of the embed in front:
// `sort` (the column key), `act` (row id, action id), `pick` (row id).
div.ui-data-table.k-grid
  div.ui-data-scroll
    table
      thead
        tr
          for col in columns key col.key
            th(style="text-align: {col.align}")
              if col.sortable
                button.ui-resource-sort(type="button" @click=sort(col.key)) {col.label}
                  span.k-icon.k-icon-chevrons-up-down(class:ui-sort-idle={!col.sorted})
              else
                | {col.label}
          th.k-grid__actionhead
      tbody
        if rows.length === 0
          tr
            td.ui-resource-empty(colspan={columns.length + 1}) {empty}
        for row in rows key row.id
          tr(data-selected={row.selected ? "true" : null} class:k-grid__pick={pickable} @click=pick(row.id))
            for cell in row.cells
              td(style="text-align: {cell.align}")
                if cell.kind === "pill"
                  span(class="ui-pill ui-pill-{cell.tone}") {cell.text}
                else if cell.kind === "strong"
                  div.k-grid__strong
                    strong {cell.text}
                    if cell.sub
                      small {cell.sub}
                else if cell.kind === "meter"
                  div.k-grid__meter
                    div(class="ui-progress ui-progress-sm k-grid__bar k-adm-t-{cell.tone}")
                      div.ui-progress-indicator(style="width: {cell.pct}%")
                    span.k-grid__meterlabel {cell.text}
                else if cell.kind === "mono"
                  span.k-grid__mono {cell.text}
                else if cell.kind === "number"
                  span.k-grid__num {cell.text}
                else
                  span {cell.text}
            td.k-grid__actions
              for item in row.actions key item.id
                button(type="button" class="ui-button ui-button-xs ui-button-{item.variant}" disabled={item.disabled} @click.stop=act(row.id, item.id))
                  if item.icon
                    span(class="k-icon {item.icon}")
                  | {item.label}
  if footer
    div.ui-resource-footer
      span {footer}
