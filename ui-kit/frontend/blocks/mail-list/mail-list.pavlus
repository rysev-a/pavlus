import List from "./view.pavlus"

section.k-page
  section.k-demo
    h2.k-demo__title Inbox
    p.k-demo__note Check rows, star a conversation, open one to read it (unread rows are bold).
    div.k-preview.k-preview--block
      div.k-mlist-demo
        +List#list(rows=rows emptyTitle=emptyTitle emptyText="Nothing here. Enjoy the quiet.")
      div.k-row
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=archiveSelected) Archive selected ({selected.length})
        button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=reset) Reset
  section.k-demo
    h2.k-demo__title Empty
    div.k-preview.k-preview--block
      div.k-mlist-demo
        +List#empty(rows=none emptyTitle="No messages found" emptyText="Try another search or clear the filter.")
