// A freight quote calculator, to embed. State = the props: `form` (strings:
// weight, volume, distance, declared, and the flags insured, express),
// `errors` (by field), `modes` (modeChoices()), `quote` (quote() from
// quote.ts, or null while the form has errors) and `canExpress`. Events:
// `<name>.field` (the field id; the value is in the event), `<name>.mode`
// (the id), `<name>.flag` (insured or express; the checkbox is in the event).
div.k-quote
  div.k-quote__form
    div.k-quote__modes(role="radiogroup" aria-label="Transport mode")
      for m in modes key m.id
        button.k-quote__mode(type="button" role="radio" aria-checked={m.active ? "true" : "false"} data-active={m.active ? "true" : null} @click=mode(m.id))
          span {m.icon}
          strong {m.label}
    div.k-quote__row
      div.ui-field(data-invalid={errors.weight ? "true" : null})
        label.ui-label(for="quote-weight") Weight (kg)
        input.ui-input#quote-weight(type="text" inputmode="decimal" value=form.weight @input=field("weight"))
        if errors.weight
          p.ui-field-error {errors.weight}
      div.ui-field(data-invalid={errors.volume ? "true" : null})
        label.ui-label(for="quote-volume") Volume (m3)
        input.ui-input#quote-volume(type="text" inputmode="decimal" value=form.volume @input=field("volume"))
        if errors.volume
          p.ui-field-error {errors.volume}
    div.ui-field(data-invalid={errors.distance ? "true" : null})
      label.ui-label(for="quote-distance") Distance (km)
      input.ui-input#quote-distance(type="text" inputmode="decimal" value=form.distance @input=field("distance"))
      if errors.distance
        p.ui-field-error {errors.distance}
    div.k-quote__flags
      div.ui-switch
        input.ui-switch-input#quote-insured(type="checkbox" role="switch" checked={form.insured} @change=flag("insured"))
        label.ui-switch-label(for="quote-insured") Insure the goods
      div.ui-switch
        input.ui-switch-input#quote-express(type="checkbox" role="switch" checked={form.express} disabled={!canExpress} @change=flag("express"))
        label.ui-switch-label(for="quote-express") Express (road and air only)
    if form.insured
      div.ui-field(data-invalid={errors.declared ? "true" : null})
        label.ui-label(for="quote-declared") Value of the goods (EUR)
        input.ui-input#quote-declared(type="text" inputmode="decimal" value=form.declared @input=field("declared"))
        if errors.declared
          p.ui-field-error {errors.declared}
  div.k-quote__result
    if quote
      p.k-quote__eyebrow Your quote
      p.k-quote__total {quote.totalText}
      p.k-quote__days About {quote.days} {quote.days === 1 ? "day" : "days"} door to door · {quote.perKg} per kg
      dl.k-quote__lines
        for line in quote.lines key line.label
          div(class:k-quote__line--sum={line.strong})
            dt {line.label}
            dd {line.value}
      if quote.basis === "volume"
        p.k-quote__hint The cargo is light for its size, so the volume sets the price ({quote.chargeable} kg).
    else
      p.k-quote__eyebrow Your quote
      p.k-quote__hint Fix the marked fields to see the price.
