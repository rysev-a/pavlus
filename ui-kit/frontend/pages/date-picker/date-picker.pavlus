section.k-page
  section.k-demo
    h2.k-demo__title Date picker
    div.k-preview
      div.k-popover-host
        button.ui-button.ui-button-outline(type="button" aria-expanded={open ? "true" : "false"} @click=toggle)
          span.k-icon.k-icon-calendar
          | {selected ? selectedLabel : "Pick a date"}
        if open
          div.k-dismiss(@click=close)
          div.ui-navigation-panel.k-above(role="dialog")
            div.ui-calendar
              div.ui-calendar-header
                button.ui-calendar-nav(type="button" aria-label="Previous month" @click=prev)
                  span.k-icon.k-icon-chevron-left
                h3.ui-calendar-title {title}
                button.ui-calendar-nav(type="button" aria-label="Next month" @click=next)
                  span.k-icon.k-icon-chevron-right
              div.ui-calendar-grid
                for name in weekdays key name
                  span.ui-calendar-weekday {name}
                for cell in cells key cell.key
                  if cell.day
                    button.ui-calendar-day(type="button" class:ui-calendar-day-selected={cell.iso === selected} @click=pick(cell.iso)) {cell.day}
                  else
                    span.ui-calendar-empty
    p.k-hint
      | Selected:
      |
      span.k-state {selectedLabel}
