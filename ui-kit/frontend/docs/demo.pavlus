// A compiled demo: the template, the state, the HTML `render` returns, the
// patches `diff` returns for each step, and (folded) the generated module,
// the AST and the vnodes. State = the props: `view` (a DemoView) and `ui`.
import Code from "./code.pavlus"

div.k-docs__demo
  if view.error
    p.k-docs__error {ui.demo.error} {view.error}
  details.k-docs__d(open="")
    summary {ui.demo.template}
    +Code#tpl(lines=view.template)
  if view.html.length > 0
    details.k-docs__d(open="")
      summary {ui.demo.state}
      +Code#st(lines=view.state)
    details.k-docs__d(open="")
      summary {ui.demo.html}
      +Code#ht(lines=view.html)
    for step, i in view.steps key i
      details.k-docs__d(open="")
        summary {ui.demo.patches}: {step.label}
        if step.empty
          p.k-docs__muted {ui.demo.noPatches}
        +Code#patch(lines=step.patches)
    details.k-docs__d(open={view.openModule ? "" : null})
      summary {ui.demo.module}
      +Code#mod(lines=view.module)
    details.k-docs__d(open={view.openAst ? "" : null})
      summary {ui.demo.ast}
      +Code#ast(lines=view.ast)
    details.k-docs__d(open={view.openVnodes ? "" : null})
      summary {ui.demo.vnodes}
      +Code#vn(lines=view.vnodes)
