// A one-page resume site, made of blocks: site navigation, hero, skills and
// timeline (from the resume block), the project grid (a child with its own
// state: `children` in the .ts) and the link list.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Hero from "../../blocks/hero/view.pavlus"
import Skills from "../../blocks/resume/skills.pavlus"
import Timeline from "../../blocks/timeline/view.pavlus"
import ProjectGrid from "../../blocks/project-grid/view.pavlus"
import LinkList from "../../blocks/link-list/view.pavlus"

div.k-template.dr#top
  div.dr__nav
    div.dr__wrap
      +SiteNav#nav(brand=brand links=nav ctaLabel="Download CV" ctaHref=pdfHref)
  main.dr__wrap
    section.dr__intro#about
      +Hero#hero(eyebrow="Open to new roles from January" title=headline text=bio primaryLabel="Download PDF" primaryHref=pdfHref secondaryLabel="Get in touch" secondaryHref="#contact")
      aside.ui-card.dr__facts
        div.ui-card-header
          h2.ui-card-title whoami
        dl.ui-card-content.dr__facts-list
          for fact in facts key fact.label
            div
              dt {fact.label}
              dd {fact.value}
    section.dr__section#stack
      div.dr__head
        p.dr__kicker 01
        h2.dr__title Tech stack
        p.dr__lead What I reach for first, and how well I know it.
      div.dr__stack
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Proficiency
          div.ui-card-content
            +Skills#skills(skills=skills)
        div.dr__groups
          for group in stackGroups key group.title
            div.dr__group
              h3.dr__group-title {group.title}
              div.dr__badges
                for item in group.items key item
                  span.ui-badge.ui-badge-outline {item}
    section.dr__section#experience
      div.dr__head
        p.dr__kicker 02
        h2.dr__title Work experience
        p.dr__lead Nine years, three teams, one habit: keep the logic pure.
      div.dr__exp
        +Timeline#experience(items=experience)
        div.dr__side
          div.ui-card
            div.ui-card-content
              +Timeline#education(items=education heading="Education")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Languages
            div.ui-card-content
              ul.dr__langs
                for lang in languages key lang.name
                  li
                    strong {lang.name}
                    span.ui-badge.ui-badge-secondary {lang.level}
    section.dr__section#projects
      div.dr__head
        p.dr__kicker 03
        h2.dr__title Projects
        p.dr__lead Open source, work and side projects. Open a card for the details.
      +ProjectGrid#projects(...projects)
    section.dr__section#contact
      div.dr__contact.ui-card
        div.dr__contact-text
          p.dr__kicker 04
          h2.dr__title Let us build something
          p.dr__lead I reply within a day. Email is best; the PDF has everything on one page.
          div.dr__actions
            a.ui-button.ui-button-default.ui-button-lg(href=pdfHref download="developer-resume.pdf")
              span.k-icon.k-dr-icon-download
              | Download resume (PDF)
        +LinkList#contacts(links=contacts)
    footer.dr__footer
      span {brand} / Berlin
      span Built with pavlus
