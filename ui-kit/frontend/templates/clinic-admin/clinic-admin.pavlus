// A clinic front desk: the shell, and one view at a time (`screen`), all made
// of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Timetable from "../../blocks/timetable-grid/view.pavlus"
import Queue from "../../blocks/queue-board/view.pavlus"
import Vitals from "../../blocks/vitals-card/view.pavlus"
import Log from "../../blocks/audit-log/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.cl(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Cedar Clinic" tagline="Front desk" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026, {clockLabel}" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "overview"
        +Stats#stats(cards=stats)
        div.cl__cols.cl__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Doctors today
              p.ui-card-description Booked half hours out of the morning
            div.ui-card-content
              +Meters#load(items=docLoad)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Results to review
              p.ui-card-description Lab results outside the reference range
            div.ui-card-content.cl__flush
              +StatusList#attention(rows=attention empty="Every abnormal result was reviewed.")
      else if screen === "schedule"
        +FilterBar#dayfilter(filters=dayFilters query="" placeholder="" actions=none)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Day schedule by doctor
            p.ui-card-description {schedNote}
          div.ui-card-content
            +Timetable#sched(corner="Time" cols=schedCols rows=schedRows)
      else if screen === "queue"
        +Stats#qstats(cards=queueStats)
        +Queue#queue(lanes=lanes)
      else if screen === "patients"
        if recordId
          div.cl__record
            div.cl__bar
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=closeRecord)
                span.k-icon.k-ai-arrow-left
                | All patients
            div.ui-card
              div.ui-card-content.cl__who
                span.ui-avatar.cl__avatar
                  span.ui-avatar-fallback {rec.initials}
                div.cl__id
                  h2.cl__name {rec.name}
                  p.cl__line {rec.line}, {rec.doctor}, {rec.phone}
                div.cl__tags
                  span(class="ui-pill ui-pill-{rec.allergyTone}") Allergies: {rec.allergies}
                  span.ui-pill.ui-pill-info {rec.conditions}
                  span.ui-pill.ui-pill-muted {rec.balance}
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Vital signs
                p.ui-card-description The last reading at the front desk
              div.ui-card-content
                +Vitals#vitals(items=vitalItems)
            div.cl__cols.cl__cols--even
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title Notes
                  p.ui-card-description Visits and nursing, newest first
                div.ui-card-content.cl__notes
                  div.ui-field
                    label.ui-label(for="cl-note") New note
                    textarea.ui-textarea-control#cl-note(rows="3" placeholder="What was said, found or decided?" value=noteDraft @input=noteInput)
                  button.ui-button.ui-button-sm.ui-button-default(type="button" @click=saveNote) Add note
                  +Log#rec(groups=noteGroups empty="No notes yet.")
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title Prescriptions
                  p.ui-card-description Refill a medicine or stop it
                div.ui-card-content.cl__flush
                  +DataGrid#rx(columns=rxCols rows=rxList empty="No prescriptions." footer="")
            div.ui-card
              div.ui-card-header
                h3.ui-card-title Lab results
                p.ui-card-description Tests ordered for this patient
              div.ui-card-content.cl__flush
                +DataGrid#reclabs(columns=recLabCols rows=recLabList empty="No lab results." footer="")
        else
          +FilterBar#pfilter(filters=pFilters query=query placeholder="Search a name, a condition or a phone" actions=none)
          +DataGrid#patients(columns=pCols rows=pRows empty="No patient matches." footer=pFooter pickable=true)
      else if screen === "labs"
        +FilterBar#labfilter(filters=labFilters query="" placeholder="" actions=none)
        +DataGrid#labs(columns=labCols rows=labList empty="No results in this group." footer="")
      else if screen === "billing"
        +Stats#bstats(cards=invStats)
        +FilterBar#payfilter(filters=payFilters query="" placeholder="" actions=none)
        +DataGrid#invoices(columns=invCols rows=invRows empty="No invoices in this group." footer="")
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
