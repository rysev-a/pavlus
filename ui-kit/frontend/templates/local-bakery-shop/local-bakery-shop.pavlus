// The Local Bakery Shop: built from the site-nav, hero, product-grid, menu-list,
// order-form, shop-cart, place-card and checkout-summary blocks.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Hero from "../../blocks/hero/view.pavlus"
import Grid from "../../blocks/product-grid/view.pavlus"
import Menu from "../../blocks/menu-list/view.pavlus"
import Order from "../../blocks/order-form/view.pavlus"
import Cart from "../../blocks/shop-cart/view.pavlus"
import Place from "../../blocks/place-card/view.pavlus"
import Confirm from "../../blocks/checkout-summary/view.pavlus"

div.k-template.bk
  div.bk-wrap
    +SiteNav#nav(brand="Mill Street Bakery" links=links ctaLabel="Order online" ctaHref="#order")
    section.bk-hero
      div.bk-hero__text
        +Hero#hero(eyebrow="Baking since 1998" title="Fresh bread, warm pastry, a cup of something good" text="A neighbourhood bakery on Mill Street. Everything is made by hand before sunrise, with butter, patience and flour from a mill down the river." primaryLabel="Order for pickup" primaryHref="#order" secondaryLabel="See the menu" secondaryHref="#menu")
      div.bk-hero__art(aria-hidden="true")
        span.bk-bubble.bk-bubble--a 🥐
        span.bk-bubble.bk-bubble--b 🍞
        span.bk-bubble.bk-bubble--c 🥖
        span.bk-bubble.bk-bubble--d ☕
    section.bk-block
      div.bk-block__head
        h2.bk-h2 Today's favourites
        p.bk-lead What the neighbours take home most.
      +Grid#grid(cards=favourites emptyTitle="" emptyText="")
    section.bk-block#menu
      div.bk-block__head
        h2.bk-h2 The menu
        p.bk-lead Prices include nothing but love: tax is added in the tray.
      +Menu#menu(sections=sections)
    section.bk-block#order
      div.bk-block__head
        h2.bk-h2 Order for pickup, delivery or a table
        p.bk-lead Fill the tray from the menu, choose how you want it and when. Pay when you collect.
      div.bk-order
        div.bk-order__form
          +Order#order(...order)
        aside.bk-order__tray
          h3.bk-tray__title Your tray
          +Cart#cart(...cart)
    section.bk-block#visit
      div.bk-block__head
        h2.bk-h2 Come and see us
      div.bk-visit
        +Place#place(...place)
        div.bk-ways
          div.ui-card
            div.ui-card-header
              span.bk-way__icon 🛍️
              h3.ui-card-title Pickup
              p.ui-card-description Free. Ready every 15 minutes from opening; we hold it for 20 minutes.
          div.ui-card
            div.ui-card-header
              span.bk-way__icon 🛵
              h3.ui-card-title Courier
              p.ui-card-description $3 up to 2 km, then $1 for each extra kilometre. We deliver up to 12 km.
          div.ui-card
            div.ui-card-header
              span.bk-way__icon 🪑
              h3.ui-card-title A table
              p.ui-card-description Up to 8 guests, held for 90 minutes. Add a pre-order and it is on the table when you sit.
    footer.bk-footer
      strong Mill Street Bakery
      p Made with pavlus · Gluten-free loaf on Saturdays only · Allergens: ask us, we will tell you everything.

  if placed
    div.k-modal
      div.k-modal__scrim(@click=closePlaced)
      div.ui-dialog.bk-dialog(role="dialog" aria-modal="true" aria-label="Order placed")
        +Confirm#placed(...placed)
  if toast
    div.ui-toaster.ui-toaster-bottom-right(role="region" aria-label="Notifications")
      div.ui-toast(data-measured data-expanded role="status" style="--toast-index: 0; --toast-height: 56px; --toast-offset-y: 0px; --toast-swipe-movement-x: 0px; --toast-swipe-movement-y: 0px")
        div.ui-toast-content(data-expanded)
          span.ui-toast-icon
            span.k-icon.k-icon-check
          div.ui-toast-body
            p.ui-toast-title {toast}
