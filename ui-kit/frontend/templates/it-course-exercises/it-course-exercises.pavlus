// An interactive IT course: an outline, lessons with theory and exercises,
// a lesson-complete screen and a certificate. Made of the blocks xp-bar,
// lesson-outline, code-block, callout, exercise-quiz, exercise-gaps,
// exercise-order, terminal-sim (view and goals), exercise-footer, stat-cards
// and certificate.
import XpBar from "../../blocks/xp-bar/view.pavlus"
import Outline from "../../blocks/lesson-outline/view.pavlus"
import Code from "../../blocks/code-block/view.pavlus"
import Callout from "../../blocks/callout/view.pavlus"
import Choice from "../../blocks/exercise-quiz/view.pavlus"
import Gaps from "../../blocks/exercise-gaps/view.pavlus"
import Order from "../../blocks/exercise-order/view.pavlus"
import Terminal from "../../blocks/terminal-sim/view.pavlus"
import Goals from "../../blocks/terminal-sim/goals.pavlus"
import Footer from "../../blocks/exercise-footer/view.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import Certificate from "../../blocks/certificate/view.pavlus"

div.k-template.itc
  header.itc__bar
    button.itc__brand(type="button" @click=backToCourse)
      span.ui-brand-mark S
      strong Shellcamp
    span.itc__tag {courseTitle}
    if toast
      span.ui-pill.ui-pill-success.itc__toast(role="status") {toast}
  +XpBar#xp(...xp)
  if screen === "course"
    section.itc__hero
      div.itc__herotext
        span.ui-badge.ui-badge-secondary Course
        h1.itc__title {courseTitle}
        p.itc__blurb {courseBlurb}
      div.itc__herostat
        div.itc__ring(style="--pct: {info.pct}")
          div.itc__ringinner
            strong {info.pct}%
            span done
        p.itc__count {info.doneText}
        if info.complete
          button.ui-button.ui-button-default(type="button" @click=openCertificate) Get your certificate
        else
          button.ui-button.ui-button-default(type="button" @click=continueCourse)
            | Continue: {info.nextTitle}
            span.k-icon.k-ai-arrow-right
    if info.complete
      +Callout#finished(tone="tip" title="You finished the course" text="Every lesson is solved. Your certificate is waiting, and you can still practise any lesson again.")
    +Outline#outline(modules=modules)
  else if screen === "lesson"
    section.itc__lesson
      div.itc__lhead
        button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=backToCourse)
          span.k-icon.k-ai-arrow-left
          | Course
        div.itc__ltitles
          small {lesson.moduleTitle} · {lesson.position}
          h2 {lesson.title}
        if lesson.inTheory
          span.ui-badge.ui-badge-secondary Theory
        else
          button.ui-button.ui-button-outline.ui-button-sm(type="button" aria-pressed={showTheory ? "true" : "false"} @click=toggleTheory) {showTheory ? "Hide the lesson" : "Show the lesson"}
      div.itc__steps
        div.ui-progress.ui-progress-sm(role="progressbar" aria-valuenow={lesson.stepPct} aria-valuemin="0" aria-valuemax="100" aria-label="Lesson progress")
          div.ui-progress-indicator(style="width: {lesson.stepPct}%")
        span.itc__steptext {lesson.stepText}
      if lesson.inTheory || showTheory
        article.ui-card.itc__theory
          div.ui-card-header
            h3.ui-card-title {lesson.title}
            p.ui-card-description {lesson.summary}
          div.ui-card-content.itc__prose
            for part in lesson.theory key part.id
              if part.kind === "code"
                +Code#code(lines=part.lines title=part.title lang=part.lang)
              else if part.kind === "note"
                +Callout#note(tone=part.tone title=part.title text=part.text)
              else if part.kind === "list"
                ul.itc__list
                  for item in part.items key item
                    li {item}
              else if part.kind === "h"
                h4.itc__h {part.text}
              else
                p.itc__p {part.text}
          if lesson.inTheory
            div.ui-card-footer
              button.ui-button.ui-button-default(type="button" @click=startExercises)
                | Start the exercises
                span.k-icon.k-ai-arrow-right
      if !lesson.inTheory
        article.ui-card.itc__exercise
          div.ui-card-header.itc__exhead
            div
              span.ui-badge.ui-badge-secondary {lesson.kindLabel}
              span.itc__worth {lesson.worth}
          div.ui-card-content.itc__exbody
            if exKind === "choice"
              +Choice#quiz(...choice)
            else if exKind === "gaps"
              +Gaps#gaps(...gaps)
            else if exKind === "order"
              +Order#order(...order)
            else if exKind === "terminal"
              p.itc__task {lesson.task}
              div.itc__termgrid
                +Terminal#term(...term prompt=prompt inputId="course-term-input" title="learner@course: practice shell")
                div.itc__goals
                  h4.itc__goalstitle The task is done when
                  +Goals#goals(goals=goals)
            +Footer#foot(...footer)
  else if screen === "done"
    section.ui-card.itc__done
      div.ui-card-content.itc__donebody
        span.itc__party 🎉
        h2.itc__title {doneView.title}
        p.itc__blurb {doneView.text}
        +Stats#stats(cards=doneView.cards)
        div.itc__donebtns
          if doneView.courseDone
            button.ui-button.ui-button-default(type="button" @click=openCertificate) Get your certificate
          else if doneView.nextTitle
            button.ui-button.ui-button-default(type="button" @click=nextLessonNow)
              | Next: {doneView.nextTitle}
              span.k-icon.k-ai-arrow-right
          button.ui-button.ui-button-outline(type="button" @click=backToCourse) Back to the course
  else
    section.itc__cert
      div.ui-field.itc__certname
        label.ui-label(for="itc-name") The name on the certificate
        input.ui-input(id="itc-name" type="text" value=name placeholder="Your name" autocomplete="name" @input=nameInput)
      +Certificate#cert(...cert)
      div.itc__donebtns
        button.ui-button.ui-button-outline(type="button" @click=backToCourse) Back to the course
