// A warehouse back office: the shell, and one view at a time (`screen`):
// overview, inventory by zone and aisle, stock alerts, orders, pick lists, the
// dock schedule and the movement log. All made of blocks; the data and the
// views worked out from it are in the state.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"
import Capacity from "../../blocks/capacity-meter/view.pavlus"
import LocationGrid from "../../blocks/location-grid/view.pavlus"
import PickList from "../../blocks/pick-list/view.pavlus"
import DockSchedule from "../../blocks/dock-schedule/view.pavlus"

div.k-template.k-ashell.wl(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Harbor Logistics" tagline="Warehouse 2, Rotterdam" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday 3 November, early shift" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "overview"
        +Stats#stats(cards=stats)
        div.wl__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Space by zone
              p.ui-card-description How full each zone is
            div.ui-card-content
              +Meters#zones(items=zoneMeters)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title The building
              p.ui-card-description Places that hold stock
            div.ui-card-content
              +Capacity#space(...space)
        div.wl__cols.wl__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Needs attention
              p.ui-card-description The products closest to running out
            div.ui-card-content.wl__flush
              +StatusList#tops(rows=topAlerts empty="Nothing is running low.")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Trucks to come
              p.ui-card-description Not yet done at the doors
            div.ui-card-content.wl__flush
              +StatusList#trucks(rows=trucks empty="No more trucks today.")
      else if screen === "inventory"
        +FilterBar#zonefilter(filters=zoneFilters query=invQuery placeholder="Search a product or a place" actions=none)
        div.wl__cols.wl__cols--inv
          +LocationGrid#grid(zones=zones)
          div.ui-card.wl__sticky
            div.ui-card-header
              h3.ui-card-title Selected place
              p.ui-card-description Click a bay on the map
            div.ui-card-content.wl__flush
              +StatusList#loc(rows=locRows empty="Pick a bay.")
      else if screen === "alerts"
        +StatusList#alerts(rows=alertRows empty="Nothing is running low. Every product is above its reorder level.")
      else if screen === "orders"
        +FilterBar#orderfilter(filters=orderFilters query="" placeholder="" actions=none)
        +DataGrid#orders(columns=orderCols rows=orderRows empty="No order here." footer=orderFooter pickable=false)
      else if screen === "picks"
        if pickFilters.length > 0
          +FilterBar#pickfilter(filters=pickFilters query="" placeholder="" actions=none)
          div.ui-card
            div.ui-card-content
              +PickList#pick(title=pickTitle sub=pickSub progress=pickProgress lines=pickLines next=pickNext)
              div.wl__buttons
                button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=tickAllLines) Tick all
                button.ui-button.ui-button-default.ui-button-sm(type="button" disabled={!pickReady} @click=completePick) Complete the pick list
        else
          div.ui-empty-state
            p There is no pick list. Open Orders and start picking a new outbound order.
      else if screen === "docks"
        +Stats#dstats(cards=dockStats)
        p.k-muted.wl__hint Click a free hour to book a truck, click a truck to change it. The highlighted hour is now.
        +DockSchedule#docks(hours=dockHours rows=dockRows)
      else if screen === "moves"
        +FilterBar#movefilter(filters=moveFilters query=moveQuery placeholder="Search a product, a place or a name" actions=none)
        +DataGrid#moves(columns=moveCols rows=moveRows empty="No movement matches." footer=moveFooter pickable=false)
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
