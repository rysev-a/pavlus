// The shops map of the Phone Retail CRM, a part to embed. State = the props
// from shopsMap() in stats.ts: `points`, `legend`, `ticks`, `picked` (a shop
// card or null), `count`. A click on a point arrives as `map.pick` with the
// shop id as text; the parent decides what is picked and passes it back.
import Geo from "../../blocks/geo-plot/view.pavlus"

div.prcd
  div.prcd__cols.prcd__cols--map
    div.ui-card
      div.ui-card-header
        h3.ui-card-title Shops map
        p.ui-card-description {count} shops by latitude and longitude, coloured by category
      div.ui-card-content
        +Geo#map(points=points legend=legend ticks=ticks height="420px")
    div.ui-card
      div.ui-card-header
        h3.ui-card-title Shop
        p.ui-card-description Pick a point on the map
      div.ui-card-content
        if picked
          dl.prcd__facts
            div
              dt Name
              dd {picked.name}
            div
              dt Category
              dd {picked.category}
            div
              dt City
              dd {picked.city}
            div
              dt Address
              dd {picked.address}
            div
              dt Phone
              dd {picked.phone}
            div
              dt Coordinates
              dd {picked.coords}
            div
              dt Orders
              dd {picked.orders}
            div
              dt Revenue
              dd {picked.revenue}
        else
          p.prcd__empty No shop picked yet.
