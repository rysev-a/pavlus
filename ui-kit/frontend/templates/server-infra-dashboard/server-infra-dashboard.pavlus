// A server and infrastructure dashboard: the shell, and one view at a time
// (`screen`): servers, containers, live logs, database. All made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import BarChart from "../../blocks/bar-chart/view.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/filter-bar/view.pavlus"
import Logs from "../../blocks/log-viewer/view.pavlus"

div.k-template.k-ashell.si(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Nimbus Ops" tagline="eu-west cluster" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="6 servers, 10 containers, one database" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "servers"
        +Stats#stats(cards=clusterStats)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Cluster CPU
            p.ui-card-description The last twelve minutes, all online servers
          div.ui-card-content
            +BarChart#cpu(columns=cpuBars height="120px")
        +StatusList#servers(rows=serverList empty="No servers.")
      else if screen === "containers"
        +FilterBar#cfilter(filters=cFilters query=cQuery placeholder="Search a container or an image" actions=none)
        +DataGrid#containers(columns=cColumns rows=cRows empty="No container matches." footer=cFooter pickable=false)
      else if screen === "logs"
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Live logs
            p.ui-card-description A line arrives every 1.2 seconds, from every container
          div.ui-card-content
            +Logs#logs(view=logv query=logs.query paused=logs.paused following=logs.following)
      else if screen === "database"
        +Stats#dbstats(cards=dbStats)
        div.si__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Resources
              p.ui-card-description postgres 16, main cluster
            div.ui-card-content
              +Meters#pool(items=dbItems)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Replication
              p.ui-card-description One primary, two streaming replicas
            div.ui-card-content.si__flush
              +StatusList#replicas(rows=replicaList empty="No replicas.")
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Slow queries
            p.ui-card-description Slower than 500 ms in the last hour
          div.ui-card-content.si__flush
            +DataGrid#slow(columns=slowCols rows=slowList empty="No slow queries. Nice." footer="")
