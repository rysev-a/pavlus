// A personal time planner: the shell, and one view at a time (`screen`), all
// made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import Cal from "../../blocks/week-calendar/view.pavlus"
import Agenda from "../../blocks/agenda-list/view.pavlus"
import Tracker from "../../blocks/time-tracker/view.pavlus"
import Summary from "../../blocks/time-summary/view.pavlus"
import Progress from "../../blocks/progress-list/view.pavlus"
import Checklist from "../../blocks/checklist/view.pavlus"
import Manager from "../../blocks/category-manager/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.pl(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Maya's week" tagline="Personal planner" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "week"
        div.pl__bar
          div.pl__nav
            button.ui-button.ui-button-outline.ui-button-icon(type="button" aria-label="Previous week" @click=prevWeek)
              span.k-icon.k-icon-chevron-left
            button.ui-button.ui-button-outline(type="button" disabled={isThisWeek} @click=thisWeek) Today
            button.ui-button.ui-button-outline.ui-button-icon(type="button" aria-label="Next week" @click=nextWeek)
              span.k-icon.k-icon-chevron-right
            strong.pl__week {weekLabel}
          div.pl__legend
            for c in legend key c.id
              span.pl__chip(class="k-wcal-c-{c.tone}")
                i.pl__dot
                | {c.name}
        +Cal#cal(days=week.days hours=week.hours rows=week.rows)
        p.pl__hint Click a block to edit it, or an empty hour to add one. The red line is now.
      else if screen === "today"
        +Stats#todaystats(cards=todayStats)
        div.pl__cols
          div.ui-card.pl__card
            h3 Today's plan
            +Agenda#agenda(days=agenda empty="Nothing planned today." checkable=true)
          div.pl__stack
            +Tracker#tt(...track)
            div.ui-card.pl__card
              +Summary#daysum(...daySummary)
      else if screen === "insights"
        div.pl__cols
          div.ui-card.pl__card
            +Summary#weeksum(...weekSummary)
          div.ui-card.pl__card
            h3 Goals this week
            p.pl__hint Progress comes from the blocks in your calendar.
            +Progress#goals(items=goalItems)
      else if screen === "tasks"
        form.pl__taskform(novalidate @submit.prevent=addTask)
          div.ui-field(data-invalid={taskDraft.error ? "true" : null})
            input.ui-input(type="text" placeholder="Add a quick task" aria-label="New task" value=taskDraft.title @input=setTaskTitle)
            if taskDraft.error
              p.ui-field-error {taskDraft.error}
          select.ui-select-control(aria-label="Priority" @change=setTaskPriority)
            for opt in prioOptions key opt.value
              option(value=opt.value selected={opt.selected}) {opt.label}
          select.ui-select-control(aria-label="Category" @change=setTaskCat)
            for opt in catOptions key opt.value
              option(value=opt.value selected={opt.selected}) {opt.label}
          button.ui-button.ui-button-default(type="submit")
            span.k-icon.k-icon-plus
            | Add
        div.pl__taskbar
          p.pl__hint {taskLine}
          button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={!hasDone} @click=clearDone) Clear finished
        +Checklist#tasklist(groups=taskGroups layout="columns")
      else if screen === "categories"
        p.pl__hint The category of a block gives it its colour everywhere. A category with time planned in it cannot be removed.
        +Manager#cats(...manager)
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=none fields=sheet.fields buttons=sheet.buttons)
