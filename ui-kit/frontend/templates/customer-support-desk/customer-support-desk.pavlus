// A support desk: an inbox with SLA countdowns, a ticket conversation with a
// reply box and a customer sidebar, an overview and a help center.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import Thread from "../../blocks/ticket-thread/view.pavlus"
import Reply from "../../blocks/reply-box/view.pavlus"
import Contacts from "../../blocks/contact-card/view.pavlus"
import Feed from "../../blocks/activity-feed/view.pavlus"
import Suggest from "../../blocks/suggestion-list/view.pavlus"
import Bars from "../../blocks/bar-chart/view.pavlus"
import Progress from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"

div.k-template.k-ashell.desk(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Helpwell" tagline="Support desk" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "inbox"
        if tk.id
          div.desk__head
            button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=closeTicket)
              span.k-icon.k-ai-arrow-left
              | Inbox
            div.desk__title
              h2 {tk.subject}
              p {tk.meta}
            div.desk__pills
              span(class="ui-pill ui-pill-{tk.statusTone}") {tk.status}
              span(class="ui-pill ui-pill-{tk.slaTone}")
                span.k-icon.k-icon-clock
                | {tk.sla}
              if tk.canSolve
                button.ui-button.ui-button-default.ui-button-sm(type="button" @click=solveTicket) Mark solved
          div.desk__cols
            div.desk__main
              div.ui-card
                div.ui-card-content
                  +Thread#thread(messages=tk.messages empty="No messages yet.")
              +Reply#reply(draft=draft canned=canned statuses=tk.statuses internal=internal error=replyError)
            aside.desk__side
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title Customer
                div.ui-card-content
                  +Contacts#cust(contacts=tk.customer empty="" single=true)
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title Ticket
                div.ui-card-content.desk__form
                  div.ui-field
                    label.ui-label Priority
                    select.ui-select-control(aria-label="Priority" @change=priorityTo)
                      for o in tk.priorities key o.value
                        option(value=o.value selected={o.selected}) {o.label}
                  div.ui-field
                    label.ui-label Assigned to
                    select.ui-select-control(aria-label="Assigned to" @change=assignTo)
                      for o in tk.agents key o.value
                        option(value=o.value selected={o.selected}) {o.label}
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title Suggested articles
                  p.ui-card-description Found from the subject. Search for other words.
                div.ui-card-content
                  +Suggest#kb(query=kbQuery placeholder="Search the help center" items=tk.suggestions empty="No article matches.")
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title History
                  p.ui-card-description Other tickets of this customer
                div.ui-card-content
                  +Feed#history(items=tk.history empty="This is their first ticket.")
        else
          +FilterBar#status(filters=statusFilters query=query placeholder="Search by subject, number or customer" actions=none)
          div.desk__selects
            select.ui-select-control(aria-label="Priority filter" @change=filterPriority)
              for o in priorityFilter key o.value
                option(value=o.value selected={o.selected}) {o.label}
            select.ui-select-control(aria-label="Agent filter" @change=filterAgent)
              for o in agentFilter key o.value
                option(value=o.value selected={o.selected}) {o.label}
          +DataGrid#tickets(columns=cols rows=rows empty="No ticket matches the filters." footer=footer pickable=true)
      else if screen === "overview"
        +Stats#stats(cards=stats)
        div.desk__split
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Live tickets by priority
            div.ui-card-content
              +Bars#prio(columns=byPriority height="200px")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Agent workload
              p.ui-card-description Live tickets against a limit of four.
            div.ui-card-content
              +Progress#load(items=load)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title SLA watchlist
            p.ui-card-description First replies due in the next 30 minutes, or already late.
          div.ui-card-content.desk__flush
            +StatusList#risk(rows=risk empty="Nothing is at risk right now.")
      else if screen === "help"
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Help center
            p.ui-card-description Search the articles agents can point customers to.
          div.ui-card-content
            +Suggest#help(query=helpQuery placeholder="Search the help center" items=help empty="No article matches. Try other words.")
