// The Clothing & Merch Store: built from the site-nav, hero, filter-bar,
// product-grid, product-detail (with the swatch-picker), shop-cart, auth and
// checkout-summary blocks.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Hero from "../../blocks/hero/view.pavlus"
import Bar from "../../blocks/filter-bar/view.pavlus"
import Grid from "../../blocks/product-grid/view.pavlus"
import Detail from "../../blocks/product-detail/view.pavlus"
import Cart from "../../blocks/shop-cart/view.pavlus"
import Auth from "../../blocks/auth/auth.pavlus"
import Confirm from "../../blocks/checkout-summary/view.pavlus"

div.k-template.cl
  div.cl-wrap
    div.cl-bar
      +SiteNav#nav(brand="Northline" links=links)
      button.ui-button.ui-button-ghost.cl-account-btn(type="button" aria-label="Account" @click=showAccount)
        span.k-icon.k-icon-user
        | {accountLabel}
      button.ui-button.ui-button-outline.cl-cart(type="button" aria-label="Open the bag, {cart.count} items" @click=openCart)
        span.k-icon.k-cart-icon
        | Bag
        span.cl-cart__count(class:is-empty={cart.count === 0}) {cart.count}
    if screen === "shop"
      section.cl-hero
        +Hero#hero(eyebrow="Autumn drop: 12 new colors" title="Clothes made to be worn for years" text="Heavy cotton, brushed fleece and honest prices. Designed in Lisbon, sewn in Portugal, shipped in two days." primaryLabel="Shop the drop" primaryHref="#shop" secondaryLabel="Our materials" secondaryHref="#about")
        div.cl-hero__art(aria-hidden="true")
          span.cl-slab.cl-slab--a(style="--hue: 38") 🧥
          span.cl-slab.cl-slab--b(style="--hue: 150") 👕
          span.cl-slab.cl-slab--c(style="--hue: 220") 👖
      section.cl-shop#shop
        div.cl-shop__head
          h2.cl-h2 Shop everything
          p.cl-lead Pick a color and size on each product: stock is shown per size.
        +Bar#bar(...bar)
        +Grid#grid(cards=cards emptyTitle="Nothing in that combination" emptyText="Try another color or a higher price.")
      section.cl-about#about
        div.cl-about__item
          strong 240 gsm
          p Our tee is a third heavier than the high-street one, and it shows after a hundred washes.
        div.cl-about__item
          strong Made in Portugal
          p Two family-run mills and one workshop, all within 80 km of each other.
        div.cl-about__item
          strong 30-day returns
          p Not right? Send it back free, even if you wore it once.
    else
      section.cl-account
        div.cl-account__top
          button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=showShop)
            span.k-icon.k-icon-chevron-left
            | Back to the shop
        if account
          div.cl-account__hello
            span.ui-avatar.cl-avatar
              span.ui-avatar-fallback {account.initials}
            div
              h1.cl-h2 Hello, {account.name}
              p.cl-lead {account.email}
            button.ui-button.ui-button-outline(type="button" @click=signOut) Sign out
          div.cl-account__cols
            div.cl-orders
              h2.cl-h3 Your orders
              for order in account.orders key order.no
                div.ui-card.cl-order
                  div.ui-card-content
                    div.cl-order__row
                      div
                        strong {order.no}
                        span.cl-order__date {order.date}
                      span(class="ui-pill ui-pill-{order.tone}") {order.status}
                    div.cl-order__row
                      span.cl-order__emojis {order.emojis}
                      span.cl-order__summary {order.summary}
                      strong {order.total}
            aside.cl-profile
              div.ui-card
                div.ui-card-header
                  h3.ui-card-title Profile
                  p.ui-card-description Where we send your orders and receipts.
                div.ui-card-content
                  dl.ui-detail-list
                    div.ui-detail-row
                      dt Name
                      dd {account.name}
                    div.ui-detail-row
                      dt Email
                      dd {account.email}
                    div.ui-detail-row
                      dt Address
                      dd Rua das Flores 18, Lisbon
                    div.ui-detail-row
                      dt Size
                      dd M, 32
        else
          div.cl-account__guest
            if notice
              div.ui-alert.ui-alert-info
                span.ui-alert-icon
                  span.k-icon.k-icon-info
                div.ui-alert-body
                  div.ui-alert-description {notice}
            div.cl-account__intro
              h1.cl-h2 Your Northline account
              p.cl-lead Follow your orders, check out in two clicks and keep your sizes saved.
            div.cl-auth
              +Auth#auth(...auth)
    footer.cl-footer
      div
        strong Northline
        p Rua das Flores 18, Lisbon · hello@northline.example
      div
        strong Help
        p Shipping · Returns · Size guide
      p.cl-footer__fine Made with pavlus. Sign in with any email and password to look around.

  if cartOpen
    div.k-modal.k-modal--sheet
      div.k-modal__scrim(@click=closeCart)
      div.ui-sheet.cl-drawer(role="dialog" aria-modal="true" aria-label="Your bag")
        div.cl-drawer__head
          h2.cl-drawer__title Your bag
          span.ui-badge.ui-badge-secondary {cart.count}
          button.ui-button.ui-button-ghost.ui-button-icon-sm.cl-drawer__close(type="button" aria-label="Close the bag" @click=closeCart)
            span.k-icon.k-icon-x
        div.cl-drawer__body
          +Cart#cart(...cart)
  if detail
    div.k-modal
      div.k-modal__scrim(@click=closeDetail)
      div.ui-dialog.cl-dialog(role="dialog" aria-modal="true" aria-label=detail.title)
        button.ui-button.ui-button-ghost.ui-button-icon-sm.cl-dialog__close(type="button" aria-label="Close" @click=closeDetail)
          span.k-icon.k-icon-x
        +Detail#detail(...detail)
  if confirmation
    div.k-modal
      div.k-modal__scrim(@click=closeConfirmation)
      div.ui-dialog.cl-dialog.cl-dialog--narrow(role="dialog" aria-modal="true" aria-label="Order placed")
        +Confirm#confirm(...confirmation)
  if toast
    div.ui-toaster.ui-toaster-bottom-right(role="region" aria-label="Notifications")
      div.ui-toast(data-measured data-expanded role="status" style="--toast-index: 0; --toast-height: 56px; --toast-offset-y: 0px; --toast-swipe-movement-x: 0px; --toast-swipe-movement-y: 0px")
        div.ui-toast-content(data-expanded)
          span.ui-toast-icon
            span.k-icon.k-icon-check
          div.ui-toast-body
            p.ui-toast-title {toast}
