// The Visual Builder: a toolbar, a library on the left, the canvas (Design),
// the diagram or the running app (Preview) in the middle, the inspector on the
// right. Under 900px the three columns become three panes with a tab bar.
import Field from "./field.pavlus"
import El from "./element.pavlus"

div.k-template.vb(data-tab=tab data-pane=pane data-bp=bp data-drag={drag ? "on" : null})
  datalist#vb-keys
    for k in keyNames key k.k
      option(value=k.k)
  header.vb-top
    div.vb-top__row
      div.vb-brand
        strong.vb-brand__title Visual Builder
        input.ui-input.vb-name(type="text" value=projectName aria-label="Project name" @input=setName)
      div.vb-seg(role="tablist" aria-label="Mode")
        button.vb-seg__btn(type="button" role="tab" aria-selected={tab === "design" ? "true" : "false"} @click=setTab("design")) Design
        button.vb-seg__btn(type="button" role="tab" aria-selected={tab === "diagram" ? "true" : "false"} @click=setTab("diagram")) Diagram
        button.vb-seg__btn(type="button" role="tab" aria-selected={tab === "preview" ? "true" : "false"} @click=setTab("preview")) Preview
      div.vb-tools
        button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={!canUndo} title="Undo (Ctrl+Z)" @click=undo) Undo
        button.ui-button.ui-button-outline.ui-button-sm(type="button" disabled={!canRedo} title="Redo (Ctrl+Y)" @click=redo) Redo
        div.vb-seg.vb-seg--sm(role="group" aria-label="Device")
          button.vb-seg__btn(type="button" aria-pressed={bp === "desktop" ? "true" : "false"} @click=setBp("desktop")) Desktop
          button.vb-seg__btn(type="button" aria-pressed={bp === "tablet" ? "true" : "false"} @click=setBp("tablet")) Tablet
          button.vb-seg__btn(type="button" aria-pressed={bp === "mobile" ? "true" : "false"} @click=setBp("mobile")) Mobile
    div.vb-top__row.vb-top__row--files
      button.ui-button.ui-button-outline.ui-button-sm(type="button" aria-expanded={sheet.open === "demos" ? "true" : "false"} @click=sheet("demos")) Demos and reset
      button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=exportJson) Export JSON
      button.ui-button.ui-button-outline.ui-button-sm(type="button" aria-expanded={sheet.open === "import" ? "true" : "false"} @click=sheet("import")) Import JSON
      button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=copyCode) Copy as pavlus code
      label.vb-check.vb-mocktoggle
        input(type="checkbox" checked={mockOn} @change=mockToggle)
        span Mock server
      span.vb-summary {summary}
  if message
    div.vb-msg(role="status")
      span {message}
      button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Dismiss" @click=dismiss) Dismiss
  if sheet.open === "demos"
    section.vb-sheet(aria-label="Demos")
      h2.vb-sheet__title Open a demo or start blank
      p.vb-hint The current project is replaced (Undo brings it back).
      div.vb-demos
        for d in demoList key d.id
          button.vb-demo(type="button" @click=loadDemo(d.id))
            strong {d.title}
            span {d.about}
  if sheet.open === "import"
    section.vb-sheet(aria-label="Import")
      h2.vb-sheet__title Import a project
      textarea.ui-textarea-control.vb-sheet__text(rows="6" value=sheet.text placeholder="Paste the JSON of a project" aria-label="Project JSON" @input=importText)
      if sheet.error
        p.vb-error(role="alert") {sheet.error}
      div.vb-row
        button.ui-button.ui-button-default.ui-button-sm(type="button" @click=importApply) Import
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=importFile) Choose a file
        button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=sheet("import")) Close
  if sheet.open === "code"
    section.vb-sheet(aria-label="Generated code")
      h2.vb-sheet__title Pavlus code
      p.vb-hint A template per page and a handlers skeleton, copied to the clipboard. Charts and table filters need handler code (see the notes).
      pre.vb-code {codeText}
      div.vb-row
        button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=copyCode) Copy again
        button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=sheet("code")) Close
  nav.vb-panes(aria-label="Panels")
    button.vb-seg__btn(type="button" aria-pressed={pane === "left" ? "true" : "false"} @click=setPane("left")) Library
    button.vb-seg__btn(type="button" aria-pressed={pane === "canvas" ? "true" : "false"} @click=setPane("canvas")) Canvas
    button.vb-seg__btn(type="button" aria-pressed={pane === "right" ? "true" : "false"} @click=setPane("right")) Inspector
  div.vb-body
    aside.vb-left(aria-label="Library")
      div.vb-ltabs(role="tablist")
        button.vb-ltab(type="button" role="tab" aria-selected={leftTab === "elements" ? "true" : "false"} @click=setLeft("elements")) Elements
        button.vb-ltab(type="button" role="tab" aria-selected={leftTab === "sections" ? "true" : "false"} @click=setLeft("sections")) Sections
        button.vb-ltab(type="button" role="tab" aria-selected={leftTab === "pages" ? "true" : "false"} @click=setLeft("pages")) Pages
        button.vb-ltab(type="button" role="tab" aria-selected={leftTab === "state" ? "true" : "false"} @click=setLeft("state")) State
        button.vb-ltab(type="button" role="tab" aria-selected={leftTab === "mock" ? "true" : "false"} @click=setLeft("mock")) Mock
      div.vb-lbody
        if leftTab === "elements"
          p.vb-hint Click an element to add it to the selected section, or drag it onto a grid cell.
          for g in palette key g.group
            h3.vb-h3 {g.group}
            div.vb-palette
              for it in g.items key it.type
                button.vb-pal(type="button" draggable="true" data-vb-drag="true" @dragstart=dragPalette(it.type) @dragend=dragEnd @click=addEl(it.type)) {it.label}
        else if leftTab === "sections"
          p.vb-hint Sections are the blocks of a page, each with its own 12-column grid.
          div.vb-palette.vb-palette--wide
            for s in sectionLib key s.id
              button.vb-pal(type="button" @click=addSection(s.id)) {s.label}
        else if leftTab === "pages"
          div.vb-row
            button.ui-button.ui-button-default.ui-button-sm(type="button" @click=pageAdd) New page
          ul.vb-outline
            for p in outline key p.id
              li
                div.vb-outline__page(data-current={p.current ? "true" : null})
                  button.vb-outline__go(type="button" @click=pageGo(p.id)) {p.name}
                  span.vb-slug {p.slug}
                  button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Delete page {p.name}" @click=pageDel(p.id)) Delete
                for s in p.sections key s.id
                  div.vb-outline__sec(data-sel={s.selected ? "true" : null})
                    button.vb-outline__go(type="button" @click=pick("section", s.id)) {s.name}
                  for e in s.elements key e.id
                    div.vb-outline__el(data-sel={e.selected ? "true" : null} data-hidden={e.hidden ? "true" : null})
                      button.vb-outline__go(type="button" @click=pick("element", e.id)) {e.label}
        else if leftTab === "state"
          p.vb-hint Keys of the app state. Elements read them with \{state.key} and bind inputs to them.
          for k in keyList key k.k
            div.vb-keybox
              for fld in k.fields key fld.id
                +Field#f(...fld)
              button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Delete key {k.key}" @click=keyDel(k.key)) Delete key
          div.vb-row
            button.ui-button.ui-button-default.ui-button-sm(type="button" @click=keyAdd) Add key
        else if leftTab === "mock"
          p.vb-hint {mockHint}
          for r in mockList key r.k
            div.vb-keybox
              for fld in r.fields key fld.id
                +Field#f(...fld)
              button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Delete route" @click=mockDel(r.id)) Delete route
          div.vb-row
            button.ui-button.ui-button-default.ui-button-sm(type="button" @click=mockAdd) Add route
    main.vb-center
      if tab === "design"
        div.vb-pages(role="tablist" aria-label="Pages")
          for p in pageTabs key p.id
            button.vb-pagetab(type="button" role="tab" aria-selected={p.current ? "true" : "false"} @click=pageGo(p.id)) {p.name}
          button.vb-pagetab.vb-pagetab--add(type="button" @click=pageAdd) + Page
        div.vb-canvas(@click=clearSel)
          div(class=frameClass)
            for s in stage.sections key s.id
              section.vb-sec(data-bg=s.bg data-pad=s.pad data-sel={s.selected ? "true" : null} aria-label=s.name)
                div.vb-sec__bar
                  button.vb-sec__name(type="button" @click.stop=selectSection(s.id)) {s.name}
                  span.vb-sec__kind {s.kind}
                  button.ui-button.ui-button-ghost.ui-button-sm(type="button" disabled={s.first} aria-label="Move {s.name} up" @click.stop=secMove(s.id, -1)) Up
                  button.ui-button.ui-button-ghost.ui-button-sm(type="button" disabled={s.last} aria-label="Move {s.name} down" @click.stop=secMove(s.id, 1)) Down
                  button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Duplicate {s.name}" @click.stop=secDup(s.id)) Duplicate
                  button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Delete {s.name}" @click.stop=secDel(s.id)) Delete
                div.vb-grid(role="group" aria-label="Grid of {s.name}: 12 columns" style=s.gridStyle)
                  for it in s.items key it.id
                    div.vb-cell(style=it.style data-sel={it.selected ? "true" : null} draggable="true" data-vb-drag="true" tabindex="0" role="button" aria-label="{it.kind} element, select" aria-pressed={it.selected ? "true" : "false"} @dragstart=dragEl(it.id) @dragend=dragEnd @click.stop=select(it.id) @keydown=cellKey(it.id))
                      +El#e(...it)
                      if it.selected
                        div.vb-handle(draggable="true" data-vb-drag="true" role="button" aria-label="Resize {it.kind}: drag to a cell" @dragstart.stop=dragResize(it.id) @dragend=dragEnd)
                  for d in s.drops key d.k
                    div.vb-drop(style=d.style role="button" aria-label=d.label @dragover.prevent=over @drop.prevent=drop(s.id, d.x, d.y))
                if s.empty
                  p.vb-sec__empty Drop an element here, or click one in the library.
            if stage.empty
              div.vb-blank
                p There are no sections on this page yet.
                div.vb-row
                  button.ui-button.ui-button-default(type="button" @click=addSection("hero")) Add a hero
                  button.ui-button.ui-button-outline(type="button" @click=addSection("empty")) Add an empty section
      div.vb-diagram(data-show={tab === "diagram" ? "true" : "false"})
        div.vb-dg__bar
          span.vb-hint Columns: pages and elements, events and HTTP calls, state. Hover a node to follow its edges. Drag from an event dot to a state key to link them; click an edge to select it.
          if edgeInfo
            span.vb-dg__edge
              strong {edgeInfo.label}
              button.ui-button.ui-button-destructive.ui-button-sm(type="button" disabled={!edgeInfo.removable} @click=dgRemove) Remove link
        div.vb-dg__scroll
          div#vb-diagram.vb-dg__svg
      if tab === "preview"
        div.vb-preview
          div.vb-addr
            span.vb-addr__bar {address}
            button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=previewRestart) Restart
          if notice
            div.vb-toast(role="status") {notice}
          div.vb-canvas
            div(class=frameClass)
              for s in stage.sections key s.id
                section.vb-sec(data-bg=s.bg data-pad=s.pad aria-label=s.name)
                  div.vb-grid(style=s.gridStyle)
                    for it in s.items key it.id
                      div.vb-cell(style=it.style)
                        +El#e(...it)
    aside.vb-right(aria-label="Inspector")
      if tab === "preview"
        h2.vb-h2 Live state
        p.vb-hint The state of the running app.
        pre.vb-code {runJson}
        h3.vb-h3 Activity
        ul.vb-log
          for l in runLog key l.k
            li {l.text}
      else
        h2.vb-h2 {inspector.title}
        p.vb-hint {inspector.subtitle}
        if inspector.mode === "none"
          p.vb-hint Select something on the canvas, or in the diagram, to edit it. Shortcuts: Delete removes, arrows move, Shift+arrows resize, Ctrl+Z / Ctrl+Y undo and redo, Ctrl+D duplicates.
        if inspector.mode === "element"
          div.vb-row
            button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=elDup) Duplicate
            button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=elDel) Delete
          h3.vb-h3 Content
          for fld in inspector.props key fld.id
            +Field#f(...fld)
          if inspector.bind
            +Field#f(...inspector.bind)
          +Field#f(...inspector.visible)
          details.vb-box
            summary Style (kit tokens)
            for fld in inspector.styles key fld.id
              +Field#f(...fld)
          details.vb-box(open)
            summary Placement on {bp}
            p.vb-hint {inspector.deviceNote}
            div.vb-rect
              for fld in inspector.layout key fld.id
                +Field#f(...fld)
            label.vb-check
              input(type="checkbox" checked={inspector.hiddenHere} @change=elHide)
              span Hide on {bp}
          if inspector.isForm
            details.vb-box(open)
              summary Form fields and validation
              for ff in inspector.formFields key ff.k
                div.vb-keybox
                  strong {ff.title}
                  for fld in ff.fields key fld.id
                    +Field#f(...fld)
                  button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=formFieldDel(ff.i)) Remove field
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=formFieldAdd) Add field
          h3.vb-h3 Events and actions
          div.vb-evtabs(role="tablist" aria-label="Events")
            for ev in inspector.events key ev.name
              button.vb-evtab(type="button" role="tab" aria-selected={ev.active ? "true" : "false"} @click=evTab(ev.name))
                | {ev.label}
                if ev.count
                  span.vb-evtab__n {ev.count}
          p.vb-hint Actions run in order when the element gets: {inspector.evLabel}.
          div.vb-chain
            for r in inspector.chain key r.k
              if r.isAction
                div.vb-act(style=r.indent)
                  div.vb-act__head
                    strong {r.title}
                    span.vb-act__btns
                      button.ui-button.ui-button-ghost.ui-button-sm(type="button" disabled={!r.canUp} aria-label="Move action up" @click=actMove(r.path, -1)) Up
                      button.ui-button.ui-button-ghost.ui-button-sm(type="button" disabled={!r.canDown} aria-label="Move action down" @click=actMove(r.path, 1)) Down
                      button.ui-button.ui-button-ghost.ui-button-sm(type="button" aria-label="Delete action" @click=actDel(r.path)) Delete
                  for fld in r.fields key fld.id
                    +Field#f(...fld)
              else if r.isLabel
                p.vb-chain__label(style=r.indent) {r.label}
              else
                div.vb-addrow(style=r.indent)
                  span.vb-addrow__label Add
                  for t in actionTypes key t.id
                    button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=actAdd(r.chain, t.id)) {t.label}
        if inspector.mode === "section"
          div.vb-row
            button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=secDup) Duplicate
            button.ui-button.ui-button-destructive.ui-button-sm(type="button" @click=secDel) Delete
          for fld in inspector.fields key fld.id
            +Field#f(...fld)
        if inspector.mode === "key"
          for fld in inspector.fields key fld.id
            +Field#f(...fld)
          p.vb-hint Rename, retype or change the initial value here. Elements that use the old name keep the old text, so rename with care.
        if inspector.mode === "page"
          for fld in inspector.fields key fld.id
            +Field#f(...fld)
          p.vb-hint Use the slug in a Navigate action (/pricing), or pick the page in a Link.
