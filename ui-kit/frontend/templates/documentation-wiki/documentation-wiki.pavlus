// A documentation site, built from the docs layout block.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Docs from "../../blocks/docs-layout/view.pavlus"

div.k-template.dw#top
  div.dw__top
    div.dw__wrap
      +SiteNav#nav(brand="Fennel" links=nav ctaLabel="Get started" ctaHref="#top")
  div.dw__wrap.dw__body
    +Docs#docs(...docs)
  footer.dw__footer
    div.dw__wrap
      span Fennel documentation, version 2.1. Last updated in March. Built with pavlus.
