// A landing page for a task planner, built from the kit's blocks.
import SiteNav from "../../blocks/site-nav/view.pavlus"
import Hero from "../../blocks/hero/view.pavlus"
import StatsStrip from "../../blocks/stats-strip/view.pavlus"
import FeatureGrid from "../../blocks/feature-grid/view.pavlus"
import TaskMock from "../../blocks/task-mock/view.pavlus"
import Pricing from "../../blocks/pricing-table/view.pavlus"
import Testimonials from "../../blocks/testimonials/view.pavlus"
import Faq from "../../blocks/faq/view.pavlus"
import Signup from "../../blocks/signup-form/view.pavlus"

div.k-template.tp#top
  div.tp__wrap
    +SiteNav#nav(brand="Tidy" links=nav ctaLabel="Start free" ctaHref="#signup")
  header.tp__hero
    div.tp__wrap
      +Hero#hero(eyebrow="New: the weekly review" title="Plan the week, not just the list" text="Tidy turns your scattered tasks into a calm plan. Capture in a second, schedule with a drag, and finish Friday knowing what moved." primaryLabel="Start free for 14 days" primaryHref="#signup" secondaryLabel="Try it below" secondaryHref="#product" align="center")
      div.tp__strip
        +StatsStrip#stats(stats=stats)
  section.tp__section#features
    div.tp__wrap
      div.tp__head
        span.ui-badge.ui-badge-secondary Features
        h2.tp__title Everything you need, nothing you have to configure
        p.tp__lead Six things Tidy does well, so your head can stay clear.
      +FeatureGrid#grid(items=features)
  section.tp__section.tp__section--tint#product
    div.tp__wrap.tp__split
      div.tp__copy
        span.ui-badge.ui-badge-secondary Try it now
        h2.tp__title This is the real thing
        p.tp__lead The list on the right works: add a task, type a #word to tag it, tick it off, filter what is left. That is the whole idea, with calendars, teams and reports around it.
        ul.tp__bullets
          li
            span.k-icon.k-icon-check
            span One key captures a task from anywhere
          li
            span.k-icon.k-icon-check
            span Tags and filters instead of folders
          li
            span.k-icon.k-icon-check
            span Progress you can see at a glance
      div.tp__mock
        +TaskMock#mock(...mock)
  section.tp__section#pricing
    div.tp__wrap
      div.tp__head
        span.ui-badge.ui-badge-secondary Pricing
        h2.tp__title Simple plans that grow with you
        p.tp__lead Start free. Switch to yearly billing and save {pricing.discount}%.
      +Pricing#pricing(...pricing)
  section.tp__section.tp__section--tint#reviews
    div.tp__wrap
      div.tp__head
        span.ui-badge.ui-badge-secondary Loved by planners
        h2.tp__title People who got their evenings back
      +Testimonials#quotes(items=quotes)
  section.tp__section#faq
    div.tp__wrap
      div.tp__head
        span.ui-badge.ui-badge-secondary FAQ
        h2.tp__title Questions, answered
      div.tp__faq
        +Faq#faq(items=faqs group="tp-faq")
  section.tp__section.tp__cta#signup
    div.tp__wrap.tp__split
      div.tp__copy.tp__copy--cta
        h2.tp__title Your calmest week starts here
        p.tp__lead Create an account and plan the next seven days in under five minutes.
        ul.tp__bullets
          for perk in perks key perk
            li
              span.k-icon.k-icon-check
              span {perk}
      div.tp__mock
        +Signup#signup(...signup)
  footer.tp__footer
    div.tp__wrap.tp__footer-row
      span.tp__footer-brand
        span.ui-brand-mark T
        strong Tidy
      span.k-muted A calmer way to plan. Made with pavlus.
