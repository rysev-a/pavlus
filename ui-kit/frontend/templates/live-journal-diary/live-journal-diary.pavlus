// A diary: a masthead with tabs and one screen at a time, all made of blocks.
// The entries, the filters and the draft live in `core`; the lists the
// screens show are worked out from it.
import Entry from "../../blocks/journal-entry/view.pavlus"
import Mood from "../../blocks/mood-picker/view.pavlus"
import Editor from "../../blocks/entry-editor/view.pavlus"
import Comments from "../../blocks/journal-comments/view.pavlus"
import Cal from "../../blocks/month-archive/view.pavlus"
import Cloud from "../../blocks/tag-cloud/view.pavlus"
import Friends from "../../blocks/friend-latest/view.pavlus"
import Profile from "../../blocks/journal-profile/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Callout from "../../blocks/callout/view.pavlus"

div.k-template.ld
  if screen === "read"
    div.ld__reading
      div.ld__readbar
        button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=exitRead)
          span.k-icon.k-icon-chevron-left
          | Leave reading mode
        span.ld__readhint One entry, nothing else
      +Entry#reader(entries=reader full=true reader=true)
  else
    header.ld__masthead
      div.ld__brand
        p.ld__eyebrow Est. March 2019
        h1.ld__title Live Journal
        p.ld__tagline annawren, a translator's notebook · {entryCount}
      nav.ld__tabs.ui-tabs-list(role="tablist" aria-label="Sections")
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={screen === "journal" || screen === "entry" ? "true" : "false"} @click=go("journal")) Journal
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={screen === "write" ? "true" : "false"} @click=write) Write
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={screen === "archive" ? "true" : "false"} @click=go("archive")) Archive
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={screen === "friends" ? "true" : "false"} @click=go("friends")) Friends
        button.ui-tabs-trigger(type="button" role="tab" aria-selected={screen === "profile" ? "true" : "false"} @click=go("profile")) Profile
    main.ld__main
      if notice
        +Callout#note(tone="tip" title=notice text="")
      if screen === "journal"
        div.ld__cols
          div.ld__col
            +FilterBar#priv(filters=privFilters query="" placeholder="" actions=none)
            if hasFilter
              div.ld__filter
                span {filterText}
                button.ui-button.ui-button-outline.ui-button-xs(type="button" @click=clearFilters) Show everything
            if feed.length > 0
              +Entry#feed(entries=feed full=false)
            else
              div.ui-empty-state.ld__empty
                p No entries match these filters.
          aside.ld__side
            div.ui-card.ld__card
              h2.ld__cardtitle Archive
              +Cal#cal(...archive)
            div.ui-card.ld__card
              h2.ld__cardtitle Tags
              +Cloud#cloud(tags=tags)
      else if screen === "entry"
        div.ld__single
          div.ld__bar
            button.ui-button.ui-button-ghost.ui-button-sm(type="button" @click=goBack)
              span.k-icon.k-icon-chevron-left
              | Back
            if openedMine
              button.ui-button.ui-button-outline.ui-button-sm(type="button" @click=editEntry) Edit this entry
          +Entry#ent(entries=opened full=true)
          div.ld__comments
            +Comments#com(heading=commentsHeading comments=comments draft=core.commentDraft error=core.commentError)
      else if screen === "write"
        div.ld__cols.ld__cols--write
          div.ld__col
            div.ld__intro
              h2.ld__h2
                if editing
                  | Edit your entry
                else
                  | A new entry
              p.ld__lead Write freely. The live preview shows how it will look.
            div.ui-card.ld__card
              h3.ld__cardtitle How are you feeling?
              +Mood#mood(moods=moods)
            +Editor#editor(draft=core.draft errors=core.errors privacies=privacies editing=editing counter=counter)
          aside.ld__side.ld__side--sticky
            p.ld__previewlabel Live preview
            div.ld__paper
              +Entry#prev(entries=preview full=true)
      else if screen === "archive"
        div.ld__cols.ld__cols--archive
          aside.ld__side
            div.ui-card.ld__card
              +Cal#arch(...archive)
            div.ui-card.ld__card
              h2.ld__cardtitle Tags
              +Cloud#atags(tags=tags)
          div.ld__col
            div.ld__intro
              h2.ld__h2 {archiveTitle}
              p.ld__lead Click a day with dots to see only that day.
            if archiveList.length > 0
              +Entry#archlist(entries=archiveList full=false)
            else
              div.ui-empty-state.ld__empty
                p Nothing written in this month yet.
      else if screen === "friends"
        div.ld__single
          div.ld__intro
            h2.ld__h2 Friends
            p.ld__lead The latest entries your friends let you read. Private ones never show.
          +Friends#friends(friends=friends empty="You have no friends yet.")
      else if screen === "profile"
        div.ld__single
          +Profile#profile(profile=profile stats=stats)
          div.ui-card.ld__card
            h2.ld__cardtitle What you write about
            +Cloud#ptags(tags=tags)
