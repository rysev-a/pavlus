// A studio CRM: clients, projects, a task board, a timeline and invoices.
// The shell, and one view at a time (`screen`), all made of blocks.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import DataGrid from "../../blocks/data-grid/view.pavlus"
import FilterBar from "../../blocks/list-filter/view.pavlus"
import Kanban from "../../blocks/kanban-board/view.pavlus"
import Gantt from "../../blocks/gantt-timeline/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.crm(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Pixel & Pine" tagline="Studio CRM" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "clients"
        +Stats#clientstats(cards=clientStats)
        +FilterBar#clientfilter(filters=clientFilters query=clientQuery placeholder="Search a client" actions=none)
        +DataGrid#clients(columns=clientCols rows=clientList empty="No client matches." footer=clientFooter pickable=false)
      else if screen === "projects"
        +Stats#projectstats(cards=projectStats)
        +DataGrid#projects(columns=projectCols rows=projectList empty="No projects." footer="" pickable=false)
      else if screen === "tasks"
        p.k-muted.crm__hint Move a card with its arrows, or click it to edit.
        +Kanban#board(columns=boardCols)
      else if screen === "timeline"
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Projects over twelve weeks
            p.ui-card-description The red line is today. A diamond is a milestone, filled when it is done.
          div.ui-card-content
            +Gantt#gantt(weeks=ganttWeeks rows=ganttRows today=ganttToday)
        div.ui-card
          div.ui-card-header
            h3.ui-card-title Milestones
            p.ui-card-description Soonest first
          div.ui-card-content.crm__flush
            +StatusList#milestones(rows=milestoneList empty="No milestones.")
      else if screen === "invoices"
        +Stats#invstats(cards=invStats)
        +FilterBar#invfilter(filters=invFilters query="" placeholder="" actions=none)
        +DataGrid#invoices(columns=invCols rows=invList empty="No invoices here." footer=invFooter pickable=true)
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
