// A hotel back office: the shell, and one view at a time (`screen`), all made
// of blocks. The data and the views worked out from it are in the state.
import Nav from "../../blocks/admin-shell/view.pavlus"
import Top from "../../blocks/admin-shell/topbar.pavlus"
import Stats from "../../blocks/stat-cards/view.pavlus"
import BarChart from "../../blocks/bar-chart/view.pavlus"
import Meters from "../../blocks/progress-list/view.pavlus"
import StatusList from "../../blocks/status-list/view.pavlus"
import BookingGrid from "../../blocks/booking-grid/view.pavlus"
import FilterBar from "../../blocks/filter-bar/view.pavlus"
import Sheet from "../../blocks/record-sheet/view.pavlus"

div.k-template.k-ashell.hp(data-nav={navOpen ? "open" : "closed"})
  aside.k-ashell__side
    +Nav#nav(brand="Harbor Hotel" tagline="Admin panel" groups=groups active=screen user=user)
  div.k-ashell__scrim(@click=closeNav)
  div.k-ashell__main
    +Top#top(title=title subtitle="Tuesday, 3 November 2026" notice=notice actions=actions user=user)
    main.k-ashell__content
      if screen === "overview"
        +Stats#stats(cards=stats)
        div.hp__cols
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Occupancy, next 14 days
              p.ui-card-description Share of the rooms taken each night
            div.ui-card-content
              +BarChart#occupancy(columns=occupancy)
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Rooms today
              p.ui-card-description Taken tonight, by floor
            div.ui-card-content
              +Meters#floors(items=floors)
        div.hp__cols.hp__cols--even
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Arrivals today
              p.ui-card-description Guests who should check in
            div.ui-card-content.hp__flush
              +StatusList#arr(rows=arrivals empty="Nobody arrives today.")
          div.ui-card
            div.ui-card-header
              h3.ui-card-title Departures today
              p.ui-card-description Guests who should check out
            div.ui-card-content.hp__flush
              +StatusList#dep(rows=departures empty="Nobody leaves today.")
      else if screen === "grid"
        div.hp__legend
          span.ui-pill.ui-pill-info Expected
          span.ui-pill.ui-pill-success Checked in
          span.ui-pill.ui-pill-muted Checked out
          span.k-muted Click a free day to book it, click a booking to see or change it.
        +BookingGrid#grid(days=days rows=grid)
      else if screen === "checkin"
        +FilterBar#stayfilter(filters=stayFilters query=stayQuery placeholder="Search a guest or a room" actions=none)
        +StatusList#stays(rows=stayList empty="No stays match.")
      else if screen === "cleaning"
        +FilterBar#cleanfilter(filters=cleanFilters query="" placeholder="" actions=none)
        +StatusList#clean(rows=cleanList empty="Nothing to clean here.")
  +Sheet#sheet(open=sheet.open title=sheet.title description=sheet.description details=sheet.details fields=sheet.fields buttons=sheet.buttons)
