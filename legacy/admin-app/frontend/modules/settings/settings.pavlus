// The /system/settings page: the theme of the app. The radios set a local
// choice, "Save" puts it in the database and applies it. State = the settings
// slice (see settings.ts).
section.settings
  div.ui-page-header
    div
      h1.page-title.ui-page-title Settings
      p.page-intro.ui-page-description How the app looks. The choice is stored in the database.
  div.ui-card
    div.ui-card-header
      h2.ui-card-title Theme
      if status === "loading"
        p.status.ui-card-description Loading...
      else if status === "failed"
        p.status.status--error.ui-card-description Could not load the settings
    div.ui-card-content
      div.settings__options(role="radiogroup" aria-label="Theme")
        label.settings__option
          input.ui-radio-input(type="radio" name="theme" value="light" checked=(choice === "light") @change=choose)
          span Light
        label.settings__option
          input.ui-radio-input(type="radio" name="theme" value="dark" checked=(choice === "dark") @change=choose)
          span Dark
      div.settings__actions
        button.save.ui-button.ui-button-primary(@click=save disabled=(saveStatus === "saving")) Save
        if saved
          span.settings__saved.ui-badge.ui-badge-outline Theme applied
        else if saveStatus === "failed"
          span.settings__error.status.status--error Could not save the theme
