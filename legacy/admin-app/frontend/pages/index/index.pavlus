// The `/` page: a template without logic. State = the props passed by the
// shell (`pages`). Its links reach the shell prefixed with `index.`.
section.index
  div.ui-page-header
    div
      h1.page-title.ui-page-title Welcome
      p.page-intro.ui-page-description Pick a page:
  ul.index__pages
    for page in pages key page.path
      li
        a.ui-button.ui-button-outline(href=page.path @click.prevent=navigate(page.path)) {page.title}
