// The `/dashboard/billing` page: the last payments, loaded from the API.
section.billing.ui-card
  div.ui-card-header
    h2.page-subtitle.ui-card-title Billing
    p.page-intro.ui-card-description The last {items.length} payments.
    if status === "loading"
      p.status.ui-card-description Loading...
    else if status === "failed"
      p.status.status--error.ui-card-description Could not load payments
  div.ui-table-container
    table.ui-table
      thead.ui-table-header
        tr.ui-table-row
          th.ui-table-head Customer
          th.ui-table-head Amount
          th.ui-table-head Status
          th.ui-table-head Paid at
      tbody.ui-table-body
        for payment in items key payment.id
          tr.billing__payment.ui-table-row
            td.billing__customer.ui-table-cell {payment.customer}
            td.billing__amount.ui-table-cell {payment.amount}
            td.ui-table-cell
              if payment.status === "paid"
                span.billing__status.ui-badge.ui-badge-secondary {payment.status}
              else
                span.billing__status.ui-badge.ui-badge-outline {payment.status}
            td.billing__paid-at.ui-table-cell.ui-cell-muted {payment.paid_at}
